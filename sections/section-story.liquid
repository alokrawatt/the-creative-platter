{% comment %}
  ============================================================
  THE CREATIVE PLATTER — The Studio Story
  ============================================================
  Pushpa dedication, Founder Amankshii Rawatt, Gurugram village
  women impact, materials practice, recognition & press.
  Copy into Shopify: sections/section-story.liquid
{% endcomment %}

<style>
  .tcp-story-page {
    background-color: #FFFFFF;
    color: var(--tcp-dark, #1F1D1B);
    font-family: var(--font-sans, sans-serif);
  }

  /* ── Hero ── */
  .tcp-story-hero {
    position: relative;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: radial-gradient(circle at center, #FFFFFF 0%, #FAF6EE 50%, #EDE6DA 100%);
    padding: 80px 40px;
    border-bottom: 1px solid var(--tcp-border, #E8E2D8);
  }

  .tcp-story-hero__inner {
    max-width: 840px;
    margin: 0 auto;
  }

  .tcp-story-hero__label {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--tcp-gold, #C29B38);
    display: block;
    margin-bottom: 16px;
  }

  .tcp-story-hero__title {
    font-family: var(--font-serif, serif);
    font-size: clamp(40px, 5.5vw, 68px);
    font-weight: 400;
    line-height: 1.05;
    color: var(--tcp-dark, #1F1D1B);
    margin: 0 0 20px;
  }

  .tcp-story-hero__quote {
    font-family: var(--font-serif, serif);
    font-size: 22px;
    font-style: italic;
    color: var(--tcp-muted, #68625B);
    line-height: 1.5;
  }

  /* ── Chapters ── */
  .tcp-story-chapter {
    padding: 100px 0;
    border-bottom: 1px solid var(--tcp-border, #E8E2D8);
  }

  .tcp-story-chapter__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 60px;
    align-items: center;
  }

  .tcp-story-chapter:nth-child(even) {
    background: var(--tcp-white, #FFFFFF);
  }

  .tcp-story-chapter:nth-child(even) .tcp-story-chapter__inner {
    grid-template-columns: 1.1fr 1fr;
  }

  .tcp-story-chapter:nth-child(even) .tcp-story-chapter__media {
    order: 1;
  }

  .tcp-story-chapter:nth-child(even) .tcp-story-chapter__content {
    order: 2;
  }

  .tcp-story-chapter__label {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--tcp-gold, #C29B38);
    display: block;
    margin-bottom: 12px;
  }

  .tcp-story-chapter__title {
    font-family: var(--font-serif, serif);
    font-size: clamp(32px, 4vw, 46px);
    font-weight: 400;
    color: var(--tcp-dark, #1F1D1B);
    line-height: 1.15;
    margin: 0 0 20px;
  }

  .tcp-story-chapter__text {
    font-size: 15px;
    color: var(--tcp-muted, #68625B);
    line-height: 1.85;
    margin-bottom: 20px;
  }

  .tcp-story-chapter__quote {
    font-family: var(--font-serif, serif);
    font-size: 20px;
    font-style: italic;
    color: var(--tcp-brown, #352922);
    border-left: 2px solid var(--tcp-gold, #C29B38);
    padding-left: 20px;
    margin: 28px 0;
  }

  .tcp-story-chapter__media {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    aspect-ratio: 4 / 3.5;
    background: var(--tcp-stone, #F3EFEA);
    box-shadow: 0 16px 40px rgba(31, 29, 27, 0.08);
  }

  .tcp-story-chapter__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Recognition & Press Grid ── */
  .tcp-story-press {
    background: var(--tcp-brown, #352922);
    color: var(--tcp-sand, #FBF9F5);
    padding: 100px 0;
    text-align: center;
  }

  .tcp-story-press__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .tcp-story-press__title {
    font-family: var(--font-serif, serif);
    font-size: clamp(32px, 4vw, 48px);
    color: #FFFFFF;
    margin: 0 0 16px;
  }

  .tcp-story-press__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin-top: 56px;
  }

  .tcp-press-box {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 32px 24px;
    text-align: center;
  }

  .tcp-press-box h4 {
    font-family: var(--font-serif, serif);
    font-size: 22px;
    letter-spacing: 2px;
    color: var(--tcp-gold-light, #DFBA5E);
    margin: 0 0 10px;
  }

  .tcp-press-box p {
    font-size: 12.5px;
    color: rgba(251, 249, 245, 0.75);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .tcp-story-chapter__inner {
      grid-template-columns: 1fr !important;
      gap: 40px;
    }
    .tcp-story-chapter__media {
      order: 1 !important;
    }
    .tcp-story-chapter__content {
      order: 2 !important;
    }
    .tcp-story-press__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .tcp-story-hero {
      padding: 60px 20px;
    }
    .tcp-story-chapter {
      padding: 60px 0;
    }
    .tcp-story-chapter__inner {
      padding: 0 20px;
    }
    .tcp-story-press__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="tcp-story-page" id="tcp-story-page-root">
  <!-- Hero -->
  <section class="tcp-story-hero">
    <div class="tcp-story-hero__inner">
      <span class="tcp-story-hero__label">THE CREATIVE PLATTER STUDIO</span>
      <h1 class="tcp-story-hero__title">Where Art Meets the Table</h1>
      <p class="tcp-story-hero__quote">
        &ldquo;We design for bespoke ritual. For everyday acts of eating, gathering, pausing, and inhabiting space. Art enters life through use.&rdquo;
      </p>
    </div>
  </section>

  <!-- Chapter 1: The Practice & Concept -->
  <section class="tcp-story-chapter">
    <div class="tcp-story-chapter__inner">
      <div class="tcp-story-chapter__content">
        <span class="tcp-story-chapter__label">THE PHILOSOPHY</span>
        <h2 class="tcp-story-chapter__title">Crafted to be felt, not just seen.</h2>
        <p class="tcp-story-chapter__text">
          The Creative Platter is a design studio working with clay and mixed materials—wood, metal, and stone—to create functional objects across multiple scales. The studio’s practice spans tableware and dinner sets to spatial objects, furniture, and sculptural installations.
        </p>
        <div class="tcp-story-chapter__quote">
          &ldquo;Our work moves from the table outward, shaping how people interact with objects, food, and one another.&rdquo;
        </div>
        <p class="tcp-story-chapter__text">
          All pieces are produced through hands-on techniques, using non-toxic, food-safe materials, and are microwave and dishwasher safe. High-fired at 1260–1280°C, the work balances durability with individuality.
        </p>
      </div>
      <div class="tcp-story-chapter__media">
        <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background: radial-gradient(circle, #FAF8F4 0%, #EDE6DC 100%);">
          <svg width="140" height="140" viewBox="0 0 140 140" fill="none"><circle cx="70" cy="70" r="54" stroke="#C29B38" stroke-width="2"/><circle cx="70" cy="70" r="36" stroke="#1F1D1B" stroke-width="1.2"/></svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Chapter 2: The Pushpa Legacy -->
  <section class="tcp-story-chapter">
    <div class="tcp-story-chapter__inner">
      <div class="tcp-story-chapter__media">
        <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background: radial-gradient(circle, #FAF8F4 0%, #EDE6DC 100%);">
          <svg width="140" height="140" viewBox="0 0 140 140" fill="none"><circle cx="70" cy="70" r="50" stroke="#DFBA5E" stroke-width="2.5" stroke-dasharray="16 4"/><path d="M50 70 Q70 50 90 70 T110 70" stroke="#C29B38" stroke-width="2" fill="none"/></svg>
        </div>
      </div>
      <div class="tcp-story-chapter__content">
        <span class="tcp-story-chapter__label">THE LEGACY COLLECTION</span>
        <h2 class="tcp-story-chapter__title">In Loving Memory of Pushpa</h2>
        <p class="tcp-story-chapter__text">
          The collection is dedicated to Pushpa, an artist and entrepreneur whose spirit lives through every vessel we shape. <strong>Smriti</strong> explores how memory transforms into living objects that participate in daily nourishment.
        </p>
        <div class="tcp-story-chapter__quote">
          &ldquo;NOTHING IS CUT AWAY. NOTHING IS DISCARDED. THE FORM FOLLOWS THE MATERIAL.&rdquo;
        </div>
        <p class="tcp-story-chapter__text">
          Recycled clay is reworked rather than discarded, with zero material cut-offs, preserving the raw organic character of the clay.
        </p>
      </div>
    </div>
  </section>

  <!-- Chapter 3: Founder & Gurugram Village Impact -->
  <section class="tcp-story-chapter" id="impact">
    <div class="tcp-story-chapter__inner">
      <div class="tcp-story-chapter__content">
        <span class="tcp-story-chapter__label">FOUNDER &amp; COMMUNITY</span>
        <h2 class="tcp-story-chapter__title">Amankshii Rawatt &bull; Social Impact</h2>
        <p class="tcp-story-chapter__text">
          Amankshii Rawatt founded The Creative Platter to explore how art can exist within everyday life. Her multidisciplinary background informs a practice rooted in material sensitivity, restraint, and human rhythm.
        </p>
        <div class="tcp-story-chapter__quote">
          &ldquo;At The Creative Platter, we honour the vision of village women, as a social impact enterprise.&rdquo;
        </div>
        <p class="tcp-story-chapter__text">
          Production takes place in a village-based studio near Gurugram, creating skilled livelihoods for local craftswomen and keeping handmade craftsmanship economically vibrant.
        </p>
      </div>
      <div class="tcp-story-chapter__media">
        <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background: radial-gradient(circle, #FAF8F4 0%, #EDE6DC 100%);">
          <svg width="140" height="140" viewBox="0 0 140 140" fill="none"><circle cx="70" cy="70" r="48" stroke="#C29B38" stroke-width="1.5"/><circle cx="70" cy="70" r="30" stroke="#DFBA5E" stroke-width="1.5"/></svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Press Accolades -->
  <section class="tcp-story-press">
    <div class="tcp-story-press__inner">
      <span class="tcp-story-hero__label" style="color:var(--tcp-gold-light);">EDITORIAL ACCLAIM</span>
      <h2 class="tcp-story-press__title">Recognised by Leading Design Platforms</h2>
      <div class="tcp-story-press__grid">
        <div class="tcp-press-box">
          <h4>VOGUE</h4>
          <p>Featured for contemporary Indian ceramic language &amp; mindful dining aesthetics.</p>
        </div>
        <div class="tcp-press-box">
          <h4>CONDÉ NAST</h4>
          <p>Celebrated for bespoke hospitality tableware and curated resort collections.</p>
        </div>
        <div class="tcp-press-box">
          <h4>THE HINDU</h4>
          <p>Highlighted for social impact craft and empowering Gurugram village women makers.</p>
        </div>
        <div class="tcp-press-box">
          <h4>TODAY'S HOME</h4>
          <p>Showcased for architectural stoneware and soulful everyday rituals.</p>
        </div>
      </div>
    </div>
  </section>
</div>

