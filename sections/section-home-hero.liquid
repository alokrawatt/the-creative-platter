{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Home Hero Section
  ============================================================
  Compact, elegant hero matching reference screenshot.
  Copy into Shopify: sections/section-home-hero.liquid
{% endcomment %}

<style>
  .tcp-hero {
    background-color: var(--tcp-cream, #FAF8F4);
    position: relative;
    overflow: hidden;
  }

  /* ── Background Wave Line Watermark ── */
  .tcp-hero__watermark {
    position: absolute;
    top: 0;
    left: 0;
    width: 280px;
    height: 100%;
    pointer-events: none;
    opacity: 0.45;
    z-index: 1;
  }

  .tcp-hero__container {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    min-height: 540px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  /* ── Left Content Column ── */
  .tcp-hero__content {
    padding: 50px 40px 50px 80px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .tcp-hero__label {
    font-family: var(--font-sans, 'Raleway', sans-serif);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--tcp-gold-hover, #B8965A);
    margin-bottom: 12px;
  }

  .tcp-hero__title {
    font-family: var(--font-script, 'Sacramento', cursive);
    font-size: clamp(54px, 6vw, 76px);
    font-weight: 400;
    color: var(--tcp-dark, #2D2D2D);
    line-height: 1;
    margin-bottom: 6px;
    letter-spacing: 0;
  }

  .tcp-hero__title-dot {
    color: var(--tcp-gold, #C8A96E);
  }

  .tcp-hero__subtitle {
    font-family: var(--font-script, 'Sacramento', cursive);
    font-size: 26px;
    font-weight: 400;
    color: var(--tcp-dark, #2D2D2D);
    margin-bottom: 20px;
  }

  .tcp-hero__divider {
    width: 32px;
    height: 1.5px;
    background-color: var(--tcp-gold, #C8A96E);
    margin-bottom: 20px;
  }

  .tcp-hero__description {
    font-family: var(--font-script, 'Sacramento', cursive);
    font-size: 24px;
    font-weight: 400;
    color: var(--tcp-dark, #2D2D2D);
    line-height: 1.4;
    margin-bottom: 32px;
  }

  /* ── CTAs ── */
  .tcp-hero__ctas {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .tcp-hero__btn-solid {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans, 'Raleway', sans-serif);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--tcp-white, #FFFFFF);
    background-color: var(--tcp-gold-hover, #B8965A);
    padding: 13px 24px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .tcp-hero__btn-solid:hover {
    background-color: var(--tcp-brown, #3A2F28);
    transform: translateY(-1px);
  }

  .tcp-hero__btn-text {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans, 'Raleway', sans-serif);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--tcp-dark, #2D2D2D);
    text-decoration: none;
    border-bottom: 1.5px solid var(--tcp-dark, #2D2D2D);
    padding-bottom: 2px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .tcp-hero__btn-text:hover {
    color: var(--tcp-gold, #C8A96E);
    border-color: var(--tcp-gold, #C8A96E);
  }

  /* ── Right Image Column ── */
  .tcp-hero__image-wrap {
    height: 100%;
    min-height: 480px;
    position: relative;
    overflow: hidden;
  }

  .tcp-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .tcp-hero__container {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .tcp-hero__content {
      padding: 50px 32px;
      order: 2;
    }

    .tcp-hero__image-wrap {
      min-height: 380px;
      order: 1;
    }

    .tcp-hero__title {
      font-size: clamp(40px, 8vw, 56px);
    }
  }

  @media (max-width: 600px) {
    .tcp-hero__content {
      padding: 36px 20px;
    }

    .tcp-hero__image-wrap {
      min-height: 280px;
    }

    .tcp-hero__ctas {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }

    .tcp-hero__btn-solid,
    .tcp-hero__btn-text {
      justify-content: center;
    }
  }
</style>

<section class="tcp-hero" id="tcp-home-hero">
  <!-- Subtle wave line watermark SVG background on left -->
  <svg class="tcp-hero__watermark" viewBox="0 0 300 600" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M-50 0 C50 150 -20 300 80 450 C130 520 20 600 -50 650" stroke="#EAE4D9" stroke-width="1.2" />
    <path d="M-80 0 C20 150 -50 300 50 450 C100 520 -10 600 -80 650" stroke="#EAE4D9" stroke-width="1.2" />
  </svg>

  <div class="tcp-hero__container">
    <!-- Left Content -->
    <div class="tcp-hero__content">
      {% if section.settings.label != blank %}
        <p class="tcp-hero__label">{{ section.settings.label }}</p>
      {% endif %}

      <h1 class="tcp-hero__title">
        {{ section.settings.title }}<span class="tcp-hero__title-dot">.</span>
      </h1>

      {% if section.settings.subtitle != blank %}
        <p class="tcp-hero__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}

      <div class="tcp-hero__divider"></div>

      {% if section.settings.description != blank %}
        <p class="tcp-hero__description">{{ section.settings.description | newline_to_br }}</p>
      {% endif %}

      <div class="tcp-hero__ctas">
        {% if section.settings.cta_primary_text != blank %}
          <a href="{{ section.settings.cta_primary_url | default: '#' }}" class="tcp-hero__btn-solid">
            {{ section.settings.cta_primary_text }} &rarr;
          </a>
        {% endif %}

        {% if section.settings.cta_secondary_text != blank %}
          <a href="{{ section.settings.cta_secondary_url | default: '#' }}" class="tcp-hero__btn-text">
            {{ section.settings.cta_secondary_text }} &rarr;
          </a>
        {% endif %}
      </div>
    </div>

    <!-- Right Image -->
    <div class="tcp-hero__image-wrap">
      {% if section.settings.hero_image != blank %}
        <img 
          class="tcp-hero__image"
          src="{{ section.settings.hero_image | image_url: width: 1200 }}"
          alt="{{ section.settings.hero_image_alt | default: 'Pushpa Collection' }}"
          loading="eager"
          fetchpriority="high"
          width="1200"
          height="800"
        >
      {% else %}
        <div class="tcp-hero__image" style="background: linear-gradient(135deg, #FAF8F4 0%, #F5F0E8 100%); width:100%; height:100%;"></div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCP Home Hero",
  "tag": "section",
  "class": "tcp-home-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Top label",
      "default": "THE LEGACY COLLECTION"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main heading",
      "default": "Pushpa"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle (italic)",
      "default": "The Legacy Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Crafted in memory.\nMade for your home."
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Primary CTA text",
      "default": "SHOP THE COLLECTION"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Secondary CTA text",
      "default": "DESIGN YOUR SET"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text",
      "default": "Pushpa Collection — Handcrafted ceramic dinnerware"
    }
  ],
  "presets": [
    {
      "name": "TCP Home Hero"
    }
  ]
}
{% endschema %}
