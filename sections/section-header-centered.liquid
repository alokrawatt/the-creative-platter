{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Solid Pure White Navbar
  ============================================================
  - Solid Pure White (#FFFFFF) on all pages including Hero
  - Clean logo containment (never overflows navbar bounds)
  - Brand typography: "the" (Sacramento), "CREATIVE PLATTER" (Raleway)
  - Refined Grey Palette (no harsh pure black)
  - Profile, Search & Cart bag counters
  Copy into Shopify: sections/section-header.liquid
{% endcomment %}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Raleway:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Sacramento&display=swap" rel="stylesheet">

<style>
  /* ── Core Design Tokens ── */
  :root {
    --tcp-sand: #FBF9F5;
    --tcp-stone: #F3EFEA;
    --tcp-gold: #fcce3a;
    --tcp-gold-hover: #e5b92e;
    --tcp-gold-light: #fcce3a;
    
    /* Strict Brand Colors */
    --tcp-grey-dark: #545454;
    --tcp-grey-body: #545454;
    --tcp-grey-muted: #545454;
    --tcp-grey-light: #8E8981;
    --tcp-border: #ECE7DF;
    --tcp-white: #FFFFFF;

    --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-brand: 'Raleway', sans-serif;
    --font-script: 'Sacramento', cursive;

    --ease-fluid: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ── Sticky Header: Naturally takes up space so Hero is never covered ── */
  #header-group {
    position: sticky !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    z-index: 99999 !important;
    background-color: #FFFFFF !important;
    background: #FFFFFF !important;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.04) !important;
  }

  #header-group > .shopify-section,
  #header-group > .header-section,
  #header-group > .shopify-section.header-section {
    background-color: #FFFFFF !important;
    background: #FFFFFF !important;
  }

  /* ── Fixed Header Wrapper ── */
  .tcp-header-wrapper {
    position: relative;
    width: 100%;
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    background-color: #FFFFFF !important;
    background: #FFFFFF !important;
  }

  /* ── Announcement Bar ── */
  .tcp-announcement {
    background: #545454;
    color: #FFFFFF;
    padding: 8px 24px;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    position: relative;
    z-index: 1002;
    overflow: hidden;
    transition: transform 0.4s var(--ease-fluid), opacity 0.3s ease;
  }

  .tcp-announcement.is-hidden {
    transform: translateY(-100%);
    opacity: 0;
    height: 0;
    padding: 0;
  }

  .tcp-announcement__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    max-width: 1440px;
    margin: 0 auto;
    text-align: center;
  }

  .tcp-announcement__text {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tcp-announcement__badge {
    background: var(--tcp-gold);
    color: #545454;
    font-size: 9px;
    font-weight: 700;
    padding: 2px 7px;
    letter-spacing: 1px;
    border-radius: 2px;
  }

  .tcp-announcement a {
    color: var(--tcp-gold-light);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tcp-announcement__close {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.8);
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
  }

  /* ── Main Navbar: 2-Tier Stacked Layout ── */
  .tcp-header {
    background-color: #FFFFFF !important;
    background: #FFFFFF !important;
    width: 100%;
  }

  /* ── Tier 1: Brand Logo Banner (Customizable Padding & Height) ── */
  .tcp-header__brand-tier {
    width: 100%;
    padding-top: {{ section.settings.logo_padding_top | default: 16 }}px;
    padding-bottom: {{ section.settings.logo_padding_bottom | default: 16 }}px;
    padding-left: 48px;
    padding-right: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tcp-header__brand-inner {
    max-width: 1600px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .tcp-header__brand-side {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: none;
    align-items: center;
  }

  .tcp-header__brand-side--left {
    left: 0;
  }

  .tcp-header__brand-side--right {
    right: 0;
  }

  .tcp-header__brand-center {
    flex: 0 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 0 24px;
  }

  .tcp-mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: var(--tcp-grey-dark);
    flex-direction: column;
    gap: 5px;
    width: 32px;
    justify-content: center;
  }

  .tcp-mobile-toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    background-color: currentColor;
    transition: transform 0.3s var(--ease-fluid), opacity 0.3s ease;
  }

  /* ── Centered Logo Branding ── */
  .tcp-header__logo-wrap {
    text-align: center;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
  }

  /* Prominent centered logo image */
  .tcp-header__logo-img {
    display: block;
    height: {{ section.settings.logo_max_height | default: 100 }}px !important;
    width: auto !important;
    max-width: {{ section.settings.logo_width | default: 480 }}px !important;
    object-fit: contain;
    object-position: center;
    transition: opacity 0.2s ease, transform 0.3s ease;
    margin: 0 auto;
  }

  .tcp-header__logo-wrap:hover .tcp-header__logo-img {
    transform: scale(1.02);
  }

  .tcp-header__logo-the {
    font-family: var(--font-script);
    font-size: 38px;
    line-height: 0.85;
    color: var(--tcp-grey-dark);
    letter-spacing: 0.5px;
    text-align: center;
  }

  .tcp-header__logo-name {
    font-family: var(--font-brand);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 5px;
    text-transform: uppercase;
    line-height: 1.15;
    color: var(--tcp-grey-dark);
    text-align: center;
    margin-top: 2px;
  }

  .tcp-header__logo-sub {
    font-family: var(--font-brand);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: var(--tcp-grey-muted);
    line-height: 1;
    margin-top: 5px;
    text-align: center;
  }

  /* ── Actions: Search, Account & Cart Bag (In Nav Row on Desktop) ── */
  .tcp-header__actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .tcp-header__action-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--tcp-grey-dark);
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .tcp-header__action-btn:hover {
    color: var(--tcp-gold);
    transform: scale(1.05);
  }

  .tcp-header__action-btn svg {
    width: 20px;
    height: 20px;
  }

  .tcp-header__cart-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--tcp-grey-dark);
    text-decoration: none;
    padding: 6px 8px;
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1px;
    transition: color 0.2s ease;
  }

  .tcp-header__cart-link:hover {
    color: var(--tcp-gold);
  }

  .tcp-header__bag-icon {
    width: 20px;
    height: 20px;
  }

  .tcp-cart-text {
    font-size: 11.5px;
    font-weight: 700;
    color: currentColor;
  }

  /* ── Tier 2: Bottom Centered Nav Links + Integrated Actions Row ── */
  .tcp-header__nav-tier {
    width: 100%;
    background: #FFFFFF;
    border-top: 1px solid var(--tcp-border, #ECE7DF);
    border-bottom: 1px solid var(--tcp-border, #ECE7DF);
  }

  .tcp-header__nav-inner {
    max-width: 1600px;
    margin: 0 auto;
    min-height: 42px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
  }

  .tcp-header__nav-spacer {
    width: 130px;
    flex-shrink: 0;
  }

  .tcp-nav-centered {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 36px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tcp-nav__item {
    position: relative;
  }

  .tcp-nav__link {
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--tcp-grey-dark, #545454);
    text-decoration: none;
    padding: 10px 6px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    position: relative;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .tcp-nav__link::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 6px;
    right: 6px;
    height: 1.5px;
    background: var(--tcp-gold);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s var(--ease-fluid);
  }

  .tcp-nav__link:hover {
    color: var(--tcp-gold);
  }

  .tcp-nav__link:hover::after {
    transform: scaleX(1);
  }

  /* ── Mega Menu / Dropdowns ── */
  .tcp-dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: #FFFFFF;
    border: 1px solid var(--tcp-border);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.08);
    border-radius: 4px;
    padding: 24px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s var(--ease-fluid);
    z-index: 1001;
    min-width: 260px;
  }

  .tcp-nav__item:hover .tcp-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .tcp-dropdown__link {
    display: block;
    padding: 8px 12px;
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 1px;
    color: var(--tcp-grey-body);
    text-decoration: none;
    transition: all 0.2s ease;
    border-radius: 2px;
  }

  .tcp-dropdown__link:hover {
    color: var(--tcp-gold);
    background: rgba(166, 115, 46, 0.06);
    padding-left: 16px;
  }

  /* ── Search Overlay ── */
  .tcp-search-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(31, 29, 27, 0.6);
    backdrop-filter: blur(12px);
    z-index: 100000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 120px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s var(--ease-fluid);
  }

  .tcp-search-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  .tcp-search-box {
    background: #FFFFFF;
    width: 90%;
    max-width: 680px;
    padding: 40px;
    border-radius: 6px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.18);
    position: relative;
    transform: translateY(-20px);
    transition: transform 0.3s var(--ease-fluid);
  }

  .tcp-search-overlay.is-active .tcp-search-box {
    transform: translateY(0);
  }

  .tcp-search-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    font-size: 24px;
    color: var(--tcp-grey-muted);
    cursor: pointer;
    padding: 4px;
    line-height: 1;
  }

  .tcp-search-input-group {
    position: relative;
    border-bottom: 2px solid var(--tcp-grey-dark);
    margin-bottom: 24px;
  }

  .tcp-search-input {
    width: 100%;
    border: none;
    outline: none;
    font-family: var(--font-sans);
    font-size: 18px;
    padding: 12px 40px 12px 0;
    color: var(--tcp-grey-dark);
    background: transparent;
  }

  .tcp-search-submit {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--tcp-grey-dark);
  }

  .tcp-search-suggestions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .tcp-search-tag {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 5px 12px;
    background: #F3EFEA;
    color: var(--tcp-grey-dark);
    text-decoration: none;
    border-radius: 20px;
    transition: all 0.2s ease;
  }

  .tcp-search-tag:hover {
    background: var(--tcp-gold);
    color: #FFFFFF;
  }

  /* ── Mobile Navigation Drawer ── */
  .tcp-mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(31, 29, 27, 0.5);
    backdrop-filter: blur(8px);
    z-index: 100000;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s var(--ease-fluid);
  }

  .tcp-mobile-drawer.is-active {
    opacity: 1;
    visibility: visible;
  }

  .tcp-mobile-drawer__content {
    position: absolute;
    top: 0;
    left: 0;
    width: 82%;
    max-width: 380px;
    height: 100%;
    background: #FFFFFF;
    box-shadow: 10px 0 40px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.4s var(--ease-fluid);
  }

  .tcp-mobile-drawer.is-active .tcp-mobile-drawer__content {
    transform: translateX(0);
  }

  .tcp-mobile-drawer__header {
    padding: 20px 24px;
    border-bottom: 1px solid var(--tcp-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .tcp-mobile-nav-link {
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--tcp-grey-dark);
    text-decoration: none;
    display: block;
    font-weight: 600;
    padding: 8px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  /* ── Responsive ── */
  @media (min-width: 1025px) {
    .tcp-header__brand-side {
      display: none;
    }
    .tcp-header__actions--desktop {
      display: flex;
    }
  }
  @media (max-width: 1024px) {
    .tcp-header__nav-tier {
      display: none;
    }
    .tcp-header__brand-side {
      display: flex;
    }
    .tcp-mobile-toggle {
      display: flex;
    }
    .tcp-header__brand-tier {
      padding: 10px 20px;
    }
    .tcp-header__logo-img {
      height: 56px !important;
      max-height: 60px !important;
      max-width: 180px !important;
    }
  }

    /* ── Caret Icon & Submenu styles ── */
    .tcp-nav__caret {
      transition: transform 0.2s ease;
      margin-left: 2px;
      display: inline-block;
      vertical-align: middle;
    }
    .tcp-nav__item:hover .tcp-nav__caret {
      transform: rotate(180deg);
    }
    .tcp-mobile-nav-item {
      list-style: none;
    }
    .tcp-mobile-nav-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }
    .tcp-mobile-nav-row .tcp-mobile-nav-link {
      border-bottom: none;
      flex-grow: 1;
    }
    .tcp-mobile-sub-toggle {
      background: none;
      border: none;
      padding: 8px 12px;
      cursor: pointer;
      color: var(--tcp-grey-dark);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s ease;
    }
    .tcp-mobile-nav-item.is-open .tcp-mobile-sub-toggle {
      transform: rotate(180deg);
      color: var(--tcp-gold);
    }
    .tcp-mobile-sub-list {
      list-style: none;
      margin: 0;
      padding: 4px 0 8px 16px;
      background: rgba(0, 0, 0, 0.02);
      border-radius: 4px;
    }
    .tcp-mobile-sub-link {
      font-family: var(--font-sans);
      font-size: 12px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--tcp-grey-body);
      text-decoration: none;
      display: block;
      padding: 6px 0;
      font-weight: 500;
    }
    .tcp-mobile-sub-link:hover {
      color: var(--tcp-gold);
    }
  </style>

<div class="tcp-header-wrapper" id="tcp-header-root">
  <!-- Announcement Bar -->
  {% if section.settings.show_announcement %}
    <div class="tcp-announcement" id="tcp-announcement-bar">
      <div class="tcp-announcement__inner">
        <div class="tcp-announcement__text">
          <span class="tcp-announcement__badge">2025–26</span>
          <span>{{ section.settings.announcement_text | default: 'Introducing Pushpa — The Legacy Dinner Collection. Hand-formed from recycled clay.' }}</span>
          {% if section.settings.announcement_link_text != blank %}
            <a href="{{ section.settings.announcement_link_url | default: '/collections/pushpa' }}">{{ section.settings.announcement_link_text }} &rarr;</a>
          {% endif %}
        </div>
      </div>
      <button class="tcp-announcement__close" id="tcp-announcement-close" aria-label="Close notification">&times;</button>
    </div>
  {% endif %}

  <!-- Main Header Navigation (2-Tier House of Things Stacked Layout) -->
  <header class="tcp-header" id="tcp-main-header">

    {% assign header_logo = section.settings.logo | default: settings.logo %}
    {% assign nav_menu = section.settings.menu | default: 'main-menu' %}
    {% assign header_links = linklists[nav_menu].links %}

    <!-- Tier 1: Brand Logo Banner (Pure Logo on Desktop, Hamburger + Logo + Search/Cart on Mobile) -->
    <div class="tcp-header__brand-tier">
      <div class="tcp-header__brand-inner">
        
        <!-- Mobile Left: Hamburger -->
        <div class="tcp-header__brand-side tcp-header__brand-side--left">
          <button class="tcp-mobile-toggle" id="tcp-mobile-open" aria-label="Open navigation menu">
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>

        <!-- Center: Prominent Centered Logo -->
        <div class="tcp-header__brand-center">
          <a href="/" class="tcp-header__logo-wrap" aria-label="The Creative Platter Studio">
            {% if header_logo != blank %}
              <img
                src="{{ header_logo | image_url: width: 1200 }}"
                alt="{{ header_logo.alt | default: shop.name | escape }}"
                class="tcp-header__logo-img"
                width="{{ header_logo.width }}"
                height="{{ header_logo.height }}"
                loading="eager"
                style="height: {{ section.settings.logo_max_height | default: 100 }}px !important; width: auto !important; max-width: {{ section.settings.logo_width | default: 480 }}px !important; object-fit: contain;"
              >
            {% else %}
              <span class="tcp-header__logo-the">the</span>
              <span class="tcp-header__logo-name">CREATIVE PLATTER</span>
              <span class="tcp-header__logo-sub">BESPOKE TABLEWARE &bull; EXPERIENCES</span>
            {% endif %}
          </a>
        </div>

        <!-- Mobile Right: Search & Cart Only (NO Profile Icon on Mobile Header) -->
        <div class="tcp-header__brand-side tcp-header__brand-side--right">
          <div class="tcp-header__actions">
            <button class="tcp-header__action-btn" id="tcp-search-trigger-mobile" aria-label="Search catalog">
              <svg viewBox="0 0 20 20" fill="none"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.6"/><path d="M12.5 12.5L17 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </button>

            <a href="/cart" class="tcp-header__cart-link" aria-label="Shopping Cart">
              <svg viewBox="0 0 20 20" fill="none" class="tcp-header__bag-icon"><path d="M4 5h12l-1.2 9H5.2L4 5z" stroke="currentColor" stroke-width="1.6"/><path d="M7 5V3.8a3 3 0 016 0V5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              <span class="tcp-cart-text">({{ cart.item_count }})</span>
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- Tier 2: Bottom Centered Nav Links + Action Icons Row (Desktop) -->
    <div class="tcp-header__nav-tier">
      <div class="tcp-header__nav-inner">
        <div class="tcp-header__nav-spacer"></div>

        <nav class="tcp-nav-centered" aria-label="Main Navigation">
          {% if header_links != blank and header_links.size > 0 %}
            {% for link in header_links %}
              {% if link.links != blank %}
                <div class="tcp-nav__item tcp-nav__item--has-dropdown">
                  <a href="{{ link.url }}" class="tcp-nav__link">
                    {{ link.title | upcase }}
                    <svg class="tcp-nav__caret" width="8" height="5" viewBox="0 0 10 6" fill="none">
                      <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                  <div class="tcp-dropdown">
                    {% for child_link in link.links %}
                      <a href="{{ child_link.url }}" class="tcp-dropdown__link">{{ child_link.title }}</a>
                    {% endfor %}
                  </div>
                </div>
              {% else %}
                <div class="tcp-nav__item">
                  <a href="{{ link.url }}" class="tcp-nav__link">{{ link.title | upcase }}</a>
                </div>
              {% endif %}
            {% endfor %}
          {% else %}
            <!-- Fallback Default Links -->
            <div class="tcp-nav__item"><a href="/collections/all" class="tcp-nav__link">SHOP</a></div>
            <div class="tcp-nav__item"><a href="/pages/story" class="tcp-nav__link">STORY</a></div>
            <div class="tcp-nav__item"><a href="/collections/dinner-sets" class="tcp-nav__link">BESPOKE (HOMES)</a></div>
            <div class="tcp-nav__item"><a href="/pages/bespoke-b2b" class="tcp-nav__link">BESPOKE (B2B)</a></div>
            <div class="tcp-nav__item"><a href="/collections/gifting" class="tcp-nav__link">GIFTING</a></div>
            <div class="tcp-nav__item"><a href="/pages/experiences" class="tcp-nav__link">EXPERIENCES</a></div>
            <div class="tcp-nav__item"><a href="/blogs/news" class="tcp-nav__link">JOURNAL</a></div>
          {% endif %}
        </nav>

        <div class="tcp-header__actions tcp-header__actions--desktop">
          <button class="tcp-header__action-btn" id="tcp-search-trigger" aria-label="Search catalog">
            <svg viewBox="0 0 20 20" fill="none"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.6"/><path d="M12.5 12.5L17 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </button>

          <a href="/account" class="tcp-header__action-btn" aria-label="Account">
            <svg viewBox="0 0 20 20" fill="none">
              <circle cx="10" cy="7" r="3.5" stroke="currentColor" stroke-width="1.5"/>
              <path d="M3.5 18c0-3.5 2.9-6 6.5-6s6.5 2.5 6.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </a>

          <a href="/cart" class="tcp-header__cart-link" aria-label="Shopping Cart">
            <svg viewBox="0 0 20 20" fill="none" class="tcp-header__bag-icon"><path d="M4 5h12l-1.2 9H5.2L4 5z" stroke="currentColor" stroke-width="1.6"/><path d="M7 5V3.8a3 3 0 016 0V5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <span class="tcp-cart-text">({{ cart.item_count }})</span>
          </a>
        </div>

      </div>
    </div>

  </header>
</div>

<!-- Search Overlay Modal -->
<div class="tcp-search-overlay" id="tcp-search-modal">
  <div class="tcp-search-box">
    <button class="tcp-search-close" id="tcp-search-close" aria-label="Close search">&times;</button>
    <form class="tcp-search-form" action="/search" method="get">
      <input type="text" name="q" class="tcp-search-input" placeholder="Search Pushpa dinnerware, vases, linen..." autofocus>
      <button type="submit" style="background:none; border:none; cursor:pointer; color:var(--tcp-grey-dark);">
        <svg width="22" height="22" viewBox="0 0 20 20" fill="none"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.8"/><path d="M12.5 12.5L17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </form>
  </div>
</div>

<!-- Mobile Drawer -->
<div class="tcp-drawer-overlay" id="tcp-drawer-overlay"></div>
<div class="tcp-mobile-drawer" id="tcp-mobile-drawer">
  <div class="tcp-mobile-drawer__header">
    <a href="/" class="tcp-header__logo-wrap" style="text-decoration: none;">
      {% if header_logo != blank %}
        <img
          src="{{ header_logo | image_url: width: 400 }}"
          alt="{{ header_logo.alt | default: shop.name | escape }}"
          class="tcp-header__logo-img"
          style="max-height: {{ section.settings.logo_max_height_mobile | default: 44 }}px; max-width: {{ section.settings.logo_width_mobile | default: 140 }}px; width: auto; height: auto;"
        >
      {% else %}
        <span class="tcp-header__logo-the">the</span>
        <span class="tcp-header__logo-name" style="font-size: 15px;">CREATIVE PLATTER</span>
      {% endif %}
    </a>
    <button id="tcp-mobile-close" style="background:none; border:none; font-size: 24px; cursor:pointer; color:var(--tcp-grey-dark);">&times;</button>
  </div>
  <div class="tcp-mobile-drawer__body">
    <ul class="tcp-mobile-nav-list" style="list-style: none; padding: 0; margin: 0;">
      {% if header_links != blank and header_links.size > 0 %}
        {% for link in header_links %}
          {% if link.links != blank %}
            <li class="tcp-mobile-nav-item">
              <div class="tcp-mobile-nav-row">
                <a href="{{ link.url }}" class="tcp-mobile-nav-link">{{ link.title }}</a>
                <button type="button" class="tcp-mobile-sub-toggle" aria-label="Toggle {{ link.title }} menu">
                  <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
              <ul class="tcp-mobile-sub-list" style="display: none;">
                {% for child_link in link.links %}
                  <li><a href="{{ child_link.url }}" class="tcp-mobile-sub-link">{{ child_link.title }}</a></li>
                {% endfor %}
              </ul>
            </li>
          {% else %}
            <li class="tcp-mobile-nav-item">
              <a href="{{ link.url }}" class="tcp-mobile-nav-link">{{ link.title }}</a>
            </li>
          {% endif %}
        {% endfor %}
      {% else %}
        <li class="tcp-mobile-nav-item"><a href="/collections/all" class="tcp-mobile-nav-link">Shop</a></li>
        <li class="tcp-mobile-nav-item"><a href="/pages/story" class="tcp-mobile-nav-link">Story</a></li>
        <li class="tcp-mobile-nav-item"><a href="/collections/dinner-sets" class="tcp-mobile-nav-link">Bespoke (Homes)</a></li>
        <li class="tcp-mobile-nav-item"><a href="/pages/bespoke-b2b" class="tcp-mobile-nav-link">Bespoke (B2B)</a></li>
        <li class="tcp-mobile-nav-item"><a href="/collections/gifting" class="tcp-mobile-nav-link">Gifting</a></li>
        <li class="tcp-mobile-nav-item"><a href="/pages/experiences" class="tcp-mobile-nav-link">Experiences</a></li>
        <li class="tcp-mobile-nav-item"><a href="/blogs/news" class="tcp-mobile-nav-link">Journal</a></li>
      {% endif %}
    </ul>
    <div style="border-top: 1px solid rgba(0,0,0,0.08); padding-top: 16px; margin-top: 16px; display: flex; flex-direction: column; gap: 12px;">
      <a href="/account" class="tcp-mobile-nav-link" style="display: flex; align-items: center; gap: 10px; border-bottom: none;">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="7" r="3.5" stroke="currentColor" stroke-width="1.5"/><path d="M3.5 18c0-3.5 2.9-6 6.5-6s6.5 2.5 6.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        Account
      </a>
      <a href="/cart" class="tcp-mobile-nav-link" style="display: flex; align-items: center; gap: 10px; border-bottom: none;">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M4 5h12l-1.2 9H5.2L4 5z" stroke="currentColor" stroke-width="1.5"/><path d="M7 5V3.8a3 3 0 016 0V5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        Cart ({{ cart.item_count }})
      </a>
    </div>
  </div>
</div>

<script>
  (function() {
    // Announcement Close
    const annBar = document.getElementById('tcp-announcement-bar');
    const annClose = document.getElementById('tcp-announcement-close');
    if (annClose && annBar) {
      annClose.addEventListener('click', () => {
        annBar.classList.add('is-hidden');
      });
    }

    // Search Modal
    const searchTrigger = document.getElementById('tcp-search-trigger');
    const searchTriggerMobile = document.getElementById('tcp-search-trigger-mobile');
    const searchModal = document.getElementById('tcp-search-modal');
    const searchClose = document.getElementById('tcp-search-close');
    if (searchModal && searchClose) {
      if (searchTrigger) searchTrigger.addEventListener('click', () => searchModal.classList.add('is-active'));
      if (searchTriggerMobile) searchTriggerMobile.addEventListener('click', () => searchModal.classList.add('is-active'));
      searchClose.addEventListener('click', () => searchModal.classList.remove('is-active'));
      searchModal.addEventListener('click', (e) => {
        if (e.target === searchModal) searchModal.classList.remove('is-active');
      });
    }

    // Mobile Drawer
    const mobileOpen = document.getElementById('tcp-mobile-open');
    const mobileClose = document.getElementById('tcp-mobile-close');
    const mobileDrawer = document.getElementById('tcp-mobile-drawer');
    const drawerOverlay = document.getElementById('tcp-drawer-overlay');

    function toggleDrawer(open) {
      if (open) {
        if (mobileDrawer) {
          mobileDrawer.classList.add('is-active');
          mobileDrawer.classList.add('is-open');
        }
        if (drawerOverlay) {
          drawerOverlay.classList.add('is-active');
          drawerOverlay.classList.add('is-open');
        }
        document.body.style.overflow = 'hidden';
      } else {
        if (mobileDrawer) {
          mobileDrawer.classList.remove('is-active');
          mobileDrawer.classList.remove('is-open');
        }
        if (drawerOverlay) {
          drawerOverlay.classList.remove('is-active');
          drawerOverlay.classList.remove('is-open');
        }
        document.body.style.overflow = '';
      }
    }

    if (mobileOpen) mobileOpen.addEventListener('click', () => toggleDrawer(true));
    if (mobileClose) mobileClose.addEventListener('click', () => toggleDrawer(false));
    if (drawerOverlay) drawerOverlay.addEventListener('click', () => toggleDrawer(false));

    // Mobile Sub-menu accordions
    document.querySelectorAll('.tcp-mobile-sub-toggle').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const parent = btn.closest('.tcp-mobile-nav-item');
        if (parent) {
          const subList = parent.querySelector('.tcp-mobile-sub-list');
          if (subList) {
            const isOpen = parent.classList.toggle('is-open');
            subList.style.display = isOpen ? 'block' : 'none';
          }
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "TCP Global Header",
  "tag": "section",
  "class": "tcp-header-section",
  "settings": [
    {
      "type": "header",
      "content": "Navigation Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu",
      "info": "Select the menu to display in the navbar. Manage link names, URLs, and dropdowns in Shopify Admin > Online Store > Navigation."
    },
    {
      "type": "header",
      "content": "Logo Settings"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image (Optional)"
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "min": 30,
      "max": 250,
      "step": 5,
      "unit": "px",
      "label": "Logo Image Height (Desktop)",
      "default": 100
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Logo Max Width (Desktop)",
      "default": 480
    },
    {
      "type": "range",
      "id": "logo_padding_top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo Banner Top Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "logo_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo Banner Bottom Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "logo_max_height_mobile",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Logo Image Height (Mobile)",
      "default": 50
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo Max Width (Mobile)",
      "default": 180
    },
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": false
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Introducing Pushpa — The Legacy Dinner Collection 2025–26. Mould-free & crafted from recycled clay."
    },
    {
      "type": "text",
      "id": "announcement_link_text",
      "label": "Announcement link text",
      "default": "Explore The Collection"
    },
    {
      "type": "url",
      "id": "announcement_link_url",
      "label": "Announcement link URL"
    }
  ]
}
{% endschema %}
