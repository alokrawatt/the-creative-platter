{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Pushpa Legacy Dinner Sets (2025–26)
  ============================================================
  Complete dedicated collection page faithful to the Pushpa Brochure:
  - The Concept & Tribute to mother Pushpa
  - The 7 Expressions: Smriti (स्मृति), Shakti (शक्ति),
    Shringaar (शृंगार), Sneha (स्नेह), Sammaan (सम्मान),
    Aaradhya (आराध्या), Karuna (करुणा).
  - Craft, Material, Zero Off-Cuts & Gurugram Village Impact.
  Copy into Shopify: sections/section-pushpa-dinner-sets.liquid
{% endcomment %}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Raleway:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Sacramento&display=swap" rel="stylesheet">

<style>
  :root {
    --tcp-sand: #FFFFFF;
    --tcp-stone: #FFFFFF;
    --tcp-white: #FFFFFF;
    --tcp-grey-dark: #545454;
    --tcp-grey-body: #545454;
    --tcp-grey-muted: #8E8981;
    --tcp-gold: #fcce3a;
    --tcp-gold-hover: #e5b92e;
    --tcp-gold-accent: #A6732E;
    --tcp-border: #ECE7DF;

    --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-serif: 'Cormorant Garamond', Georgia, serif;
    --font-brand: 'Raleway', sans-serif;
    --font-script: 'Sacramento', cursive;
    --ease-fluid: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tcp-pushpa-page {
    background-color: #FFFFFF !important;
    color: #545454;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  .tcp-pushpa-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media (max-width: 768px) {
    .tcp-pushpa-container {
      padding: 0 20px;
    }
  }

  /* ── 1. Full Background Hero Section (Copied from Shop) ── */
  .tcp-pushpa-hero {
    position: relative;
    min-height: 600px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #1a1815;
  }

  .tcp-pushpa-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
    opacity: 1;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tcp-pushpa-hero:hover .tcp-pushpa-hero__bg {
    transform: scale(1.02);
  }

  .tcp-pushpa-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.35) 45%, rgba(0, 0, 0, 0.05) 100%);
    z-index: 2;
    pointer-events: none;
  }

  @media (max-width: 800px) {
    .tcp-pushpa-hero {
      min-height: 500px;
    }
    .tcp-pushpa-hero__overlay {
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.3) 60%, rgba(0, 0, 0, 0.1) 100%);
    }
  }

  .tcp-pushpa-hero .tcp-pushpa-container {
    width: 100%;
    display: flex;
    justify-content: flex-start;
  }

  .tcp-pushpa-hero__content {
    position: relative;
    z-index: 3;
    max-width: 540px;
    padding: 80px 0;
    text-align: left;
    margin-right: auto;
    margin-left: 0;
  }

  .tcp-pushpa-hero__pill {
    display: inline-block;
    font-family: var(--font-brand, 'Raleway', sans-serif);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 3.5px;
    text-transform: uppercase;
    color: #fcce3a;
    margin-bottom: 16px;
    text-align: left;
  }

  .tcp-pushpa-hero__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(56px, 7vw, 92px);
    font-weight: 400;
    line-height: 1;
    color: #FFFFFF;
    margin: 0 0 18px;
    letter-spacing: -0.5px;
    text-align: left;
  }

  .tcp-pushpa-hero__caps {
    display: block;
    font-family: var(--font-brand, 'Raleway', sans-serif);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 0 8px;
    text-align: left;
  }

  .tcp-pushpa-hero__desc {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.95);
    max-width: 440px;
    margin: 0 0 32px;
    text-align: left;
  }

  .tcp-pushpa-hero__actions {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 20px;
    flex-wrap: wrap;
  }

  .tcp-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #fcce3a;
    color: #FFFFFF;
    padding: 14px 30px;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(252, 206, 58, 0.35);
    border-radius: 2px;
  }

  .tcp-btn-primary:hover {
    background: #e5b92e;
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 6px 22px rgba(252, 206, 58, 0.45);
  }

  .tcp-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    padding: 6px 0;
    position: relative;
    transition: color 0.2s ease;
  }

  .tcp-btn-secondary:hover {
    color: #fcce3a;
  }

  /* ── Dedicated Tribute Section ── */
  .tcp-pushpa-tribute {
    background: var(--tcp-white, #FFFFFF);
    padding: 80px 0;
    border-bottom: 1px solid var(--tcp-border, #E8E2D8);
  }

  .tcp-pushpa-tribute__inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 40px;
    text-align: center;
  }

  .tcp-pushpa-tribute__label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--tcp-gold, #C29B38);
    display: block;
    margin-bottom: 16px;
  }

  .tcp-pushpa-tribute__quote {
    font-family: var(--font-serif, serif);
    font-size: clamp(26px, 3.5vw, 36px);
    font-weight: 400;
    line-height: 1.35;
    color: var(--tcp-dark, #1F1D1B);
    margin: 0 0 24px;
  }

  .tcp-pushpa-tribute__body {
    font-family: var(--font-sans, sans-serif);
    font-size: 15px;
    color: var(--tcp-muted, #68625B);
    line-height: 1.85;
    text-align: justify;
    text-align-last: center;
    margin: 0 auto;
  }

  /* ── The 7 Expressions Showcase ── */
  .tcp-pushpa-expressions {
    padding: 100px 0;
    max-width: 1440px;
    margin: 0 auto;
    padding-left: 40px;
    padding-right: 40px;
  }

  .tcp-pushpa-expressions__header {
    text-align: center;
    margin-bottom: 64px;
  }

  .tcp-pushpa-expressions__title {
    font-family: var(--font-serif, serif);
    font-size: clamp(34px, 4.5vw, 52px);
    font-weight: 400;
    color: var(--tcp-dark, #1F1D1B);
    margin: 0 0 12px;
  }

  .tcp-pushpa-item {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    background: var(--tcp-white, #FFFFFF);
    border: 1px solid var(--tcp-border, #E8E2D8);
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 48px;
    transition: transform 0.4s var(--ease-fluid), box-shadow 0.4s var(--ease-fluid);
  }

  .tcp-pushpa-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 48px rgba(31, 29, 27, 0.08);
  }

  .tcp-pushpa-item:nth-child(even) .tcp-pushpa-item__media {
    order: 2;
  }

  .tcp-pushpa-item:nth-child(even) .tcp-pushpa-item__content {
    order: 1;
  }

  .tcp-pushpa-item__media {
    position: relative;
    aspect-ratio: 4 / 3.5;
    background: var(--tcp-stone, #F3EFEA);
    overflow: hidden;
  }

  .tcp-pushpa-item__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-fluid);
  }

  .tcp-pushpa-item:hover .tcp-pushpa-item__img {
    transform: scale(1.04);
  }

  .tcp-pushpa-item__badge-gold {
    position: absolute;
    top: 16px;
    left: 16px;
    background: rgba(31, 29, 27, 0.88);
    backdrop-filter: blur(8px);
    color: var(--tcp-gold-light, #DFBA5E);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 2px;
  }

  .tcp-pushpa-item__content {
    padding: 48px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .tcp-pushpa-item__head-group {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 6px;
  }

  .tcp-pushpa-item__name {
    font-family: var(--font-serif, serif);
    font-size: 36px;
    font-weight: 600;
    color: var(--tcp-dark, #1F1D1B);
    line-height: 1;
  }

  .tcp-pushpa-item__hindi {
    font-family: var(--font-devanagari, serif);
    font-size: 22px;
    color: var(--tcp-gold, #C29B38);
    font-weight: 500;
  }

  .tcp-pushpa-item__tagline {
    font-family: var(--font-serif, serif);
    font-size: 18px;
    font-style: italic;
    color: var(--tcp-muted, #68625B);
    margin-bottom: 20px;
  }

  .tcp-pushpa-item__desc {
    font-family: var(--font-sans, sans-serif);
    font-size: 14.5px;
    color: var(--tcp-muted, #68625B);
    line-height: 1.75;
    margin-bottom: 28px;
  }

  .tcp-pushpa-item__specs-pill {
    display: flex;
    gap: 16px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .tcp-pushpa-spec-tag {
    background: var(--tcp-stone, #F3EFEA);
    border: 1px solid var(--tcp-border, #E8E2D8);
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    color: var(--tcp-brown, #352922);
  }

  .tcp-pushpa-item__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-sans, sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #FFFFFF;
    background: var(--tcp-dark, #1F1D1B);
    padding: 15px 30px;
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.3s var(--ease-fluid);
  }

  .tcp-pushpa-item__btn:hover {
    background: var(--tcp-gold, #C29B38);
    transform: translateY(-2px);
  }

  /* ── Craft & Impact Quote Section ── */
  .tcp-pushpa-craft-quote {
    background: var(--tcp-brown, #352922);
    color: var(--tcp-sand, #FBF9F5);
    padding: 80px 40px;
    text-align: center;
  }

  .tcp-pushpa-craft-quote__inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .tcp-pushpa-craft-quote h3 {
    font-family: var(--font-serif, serif);
    font-size: 32px;
    color: #FFFFFF;
    margin-bottom: 12px;
    letter-spacing: 1px;
  }

  .tcp-pushpa-craft-quote p {
    font-family: var(--font-sans, sans-serif);
    font-size: 14.5px;
    color: rgba(251, 249, 245, 0.8);
    line-height: 1.8;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .tcp-pushpa-item {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .tcp-pushpa-item:nth-child(even) .tcp-pushpa-item__media {
      order: 1;
    }
    .tcp-pushpa-item:nth-child(even) .tcp-pushpa-item__content {
      order: 2;
    }
    .tcp-pushpa-item__content {
      padding: 32px 24px;
    }
  }

  @media (max-width: 600px) {
    .tcp-pushpa-hero {
      padding: 60px 20px;
    }
    .tcp-pushpa-hero__title {
      font-size: 52px;
    }
    .tcp-pushpa-expressions {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>

<div class="tcp-pushpa-page" id="tcp-pushpa-page-root">
  <!-- Hero Section with Full Image Background (Copied from Shop) -->
  <section class="tcp-pushpa-hero">
    {% if section.settings.hero_image != blank %}
      <img
        src="{{ section.settings.hero_image | image_url: width: 2200 }}"
        alt="{{ section.settings.hero_image.alt | default: 'Pushpa Legacy Tableware Collection' | escape }}"
        class="tcp-pushpa-hero__bg"
        loading="eager"
      >
    {% else %}
      <img
        src="https://images.unsplash.com/photo-1610701596007-11502861dcfa?q=80&w=2200&auto=format&fit=crop"
        alt="Pushpa Legacy Dinner Sets"
        class="tcp-pushpa-hero__bg"
        loading="eager"
      >
    {% endif %}

    <div class="tcp-pushpa-hero__overlay"></div>

    <div class="tcp-pushpa-container">
      <div class="tcp-pushpa-hero__content">
        <span class="tcp-pushpa-hero__pill">{{ section.settings.hero_pill | default: 'INTRODUCING' }}</span>
        <h1 class="tcp-pushpa-hero__title">{{ section.settings.hero_title | default: 'Pushpa' }}</h1>
        <span class="tcp-pushpa-hero__caps">{{ section.settings.hero_caps | default: 'THE LEGACY DINNER COLLECTION' }}</span>
        <p class="tcp-pushpa-hero__desc">
          {{ section.settings.hero_desc | default: 'Seven designs. Seven expressions.' }}
        </p>
        <div class="tcp-pushpa-hero__actions">
          {% if section.settings.hero_btn_text != blank %}
            <a href="{{ section.settings.hero_btn_url | default: '#expressions' }}" class="tcp-btn-primary">
              {{ section.settings.hero_btn_text }} &rarr;
            </a>
          {% endif %}
          {% if section.settings.hero_link_text != blank %}
            <a href="{{ section.settings.hero_link_url | default: '/pages/story' }}" class="tcp-btn-secondary">
              {{ section.settings.hero_link_text }} &rarr;
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <!-- Tribute Description Section -->
  <section class="tcp-pushpa-tribute">
    <div class="tcp-pushpa-tribute__inner">
      <span class="tcp-pushpa-tribute__label">THE DEDICATION &amp; CONCEPT</span>
      <h2 class="tcp-pushpa-tribute__quote">
        “Memory enters life through the things we touch, use and cherish.”
      </h2>
      <p class="tcp-pushpa-tribute__body">
        The collection is dedicated to my mother, <strong>Pushpa</strong>, an artist and entrepreneur whom I lost a few years ago. It is an expression of the enduring presence of someone who may no longer be physically present, but whose memory continues to live through the objects we create.
        <br><br>
        <strong>Smriti</strong> explores how memory can be translated into objects that become part of everyday rituals. The collection deliberately embraces the raw and organic character of clay, rather than pursuing industrial uniformity. Each object retains subtle variations in form, contour, texture, and edge. These are not imperfections to be corrected, but traces of the material and the maker's hand.
      </p>
    </div>
  </section>

  <!-- The 7 Expressions Alternating Cards -->
  <section class="tcp-pushpa-expressions">
    <div class="tcp-pushpa-expressions__header">
      <span class="tcp-pushpa-hero__caps" style="color:var(--tcp-gold);">THE SEVEN EXPRESSIONS</span>
      <h2 class="tcp-pushpa-expressions__title">Seven Expressions of Legacy</h2>
    </div>

    <!-- 1. Smriti -->
    <div class="tcp-pushpa-item">
      <div class="tcp-pushpa-item__media">
        <span class="tcp-pushpa-item__badge-gold">Flagship Legacy Set</span>
        {% if section.settings.smriti_img != blank %}
          <img class="tcp-pushpa-item__img" src="{{ section.settings.smriti_img | image_url: width: 800 }}" alt="Smriti Dinner Set" loading="lazy">
        {% else %}
          <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background: radial-gradient(circle, #FAF8F4 0%, #EDE5D8 100%);">
            <svg width="140" height="140" viewBox="0 0 140 140" fill="none"><circle cx="70" cy="70" r="56" stroke="#C29B38" stroke-width="3" stroke-dasharray="24 6 12 4"/><circle cx="70" cy="70" r="38" stroke="#1F1D1B" stroke-width="1.2"/><circle cx="70" cy="70" r="20" fill="#E8DEC\-D" stroke="#DFBA5E" stroke-width="2"/></svg>
          </div>
        {% endif %}
      </div>
      <div class="tcp-pushpa-item__content">
        <div class="tcp-pushpa-item__head-group">
          <h3 class="tcp-pushpa-item__name">Smriti</h3>
          <span class="tcp-pushpa-item__hindi">(स्मृति)</span>
        </div>
        <p class="tcp-pushpa-item__tagline">&ldquo;Memory &amp; Remembrance&rdquo;</p>
        <p class="tcp-pushpa-item__desc">
          Symbolizes cherished memories and the everlasting presence of mother’s teachings, even in her absence. Mould-free recycled clay, raw contour edges, and 24k gold leaf brushwork.
        </p>
        <div class="tcp-pushpa-item__specs-pill">
          <span class="tcp-pushpa-spec-tag">Charger Plate 11.5"</span>
          <span class="tcp-pushpa-spec-tag">Dinner Plate 10"</span>
          <span class="tcp-pushpa-spec-tag">Katori Bowl 4.5"</span>
          <span class="tcp-pushpa-spec-tag">24k Gold Rim</span>
        </div>
        <a href="/products/smriti-dinner-set" class="tcp-pushpa-item__btn">Order Smriti Set &rarr;</a>
      </div>
    </div>

    <!-- 2. Shakti -->
    <div class="tcp-pushpa-item">
      <div class="tcp-pushpa-item__media">
        {% if section.settings.shakti_img != blank %}
          <img class="tcp-pushpa-item__img" src="{{ section.settings.shakti_img | image_url: width: 800 }}" alt="Shakti Dinner Set" loading="lazy">
        {% else %}
          <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background: radial-gradient(circle, #FAF8F4 0%, #EDE5D8 100%);">
            <svg width="140" height="140" viewBox="0 0 140 140" fill="none"><circle cx="70" cy="70" r="54" stroke="#1F1D1B" stroke-width="2.5"/><circle cx="70" cy="70" r="36" stroke="#C29B38" stroke-width="2"/></svg>
          </div>
        {% endif %}
      </div>
      <div class="tcp-pushpa-item__content">
        <div class="tcp-pushpa-item__head-group">
          <h3 class="tcp-pushpa-item__name">Shakti</h3>
          <span class="tcp-pushpa-item__hindi">(शक्ति)</span>
        </div>
        <p class="tcp-pushpa-item__tagline">&ldquo;Quiet Strength&rdquo;</p>
        <p class="tcp-pushpa-item__desc">
          Grounded architectural weight, earthy raw clay finish, high-fired at 1280°C for daily resilience. Embodies the quiet fortitude left behind in spirit.
        </p>
        <div class="tcp-pushpa-item__specs-pill">
          <span class="tcp-pushpa-spec-tag">Dinner Plate 10.5"</span>
          <span class="tcp-pushpa-spec-tag">Pasta Bowl 8"</span>
          <span class="tcp-pushpa-spec-tag">Stoneware Rim</span>
        </div>
        <a href="/products/shakti-dinner-set" class="tcp-pushpa-item__btn">Order Shakti Set &rarr;</a>
      </div>
    </div>

    <!-- 3. Shringaar -->
    <div class="tcp-pushpa-item">
      <div class="tcp-pushpa-item__media">
        {% if section.settings.shringaar_img != blank %}
          <img class="tcp-pushpa-item__img" src="{{ section.settings.shringaar_img | image_url: width: 800 }}" alt="Shringaar Set" loading="lazy">
        {% else %}
          <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background: radial-gradient(circle, #FAF8F4 0%, #EDE5D8 100%);">
            <svg width="140" height="140" viewBox="0 0 140 140" fill="none"><circle cx="70" cy="70" r="50" stroke="#DFBA5E" stroke-width="2"/><ellipse cx="70" cy="70" rx="35" ry="25" stroke="#C29B38" stroke-width="1.8"/></svg>
          </div>
        {% endif %}
      </div>
      <div class="tcp-pushpa-item__content">
        <div class="tcp-pushpa-item__head-group">
          <h3 class="tcp-pushpa-item__name">Shringaar</h3>
          <span class="tcp-pushpa-item__hindi">(शृंगार)</span>
        </div>
        <p class="tcp-pushpa-item__tagline">&ldquo;Adornment &amp; Grace&rdquo;</p>
        <p class="tcp-pushpa-item__desc">
          Refined organic curves, luminous crackle glaze, and delicate gold-brushed lip. An ode to graceful ceremonial dining and festive gathering.
        </p>
        <div class="tcp-pushpa-item__specs-pill">
          <span class="tcp-pushpa-spec-tag">Side Plate 7.5"</span>
          <span class="tcp-pushpa-spec-tag">Sharing Dish 9"</span>
          <span class="tcp-pushpa-spec-tag">Crackle Glaze</span>
        </div>
        <a href="/products/shringaar-dinner-set" class="tcp-pushpa-item__btn">Order Shringaar Set &rarr;</a>
      </div>
    </div>

    <!-- 4. Sneha -->
    <div class="tcp-pushpa-item">
      <div class="tcp-pushpa-item__media">
        <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background: radial-gradient(circle, #FAF8F4 0%, #EDE5D8 100%);">
