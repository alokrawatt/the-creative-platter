{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Pushpa Dinner Sets Page
  ============================================================
  Hero banner + "The Seven Expressions" alternating layout
  with each dinner set (Smriti, Shakti, Shringaar, Sneha,
  Sammaan, Aaradhya, Karuna) + bottom quote + trust badges.
  Copy into Shopify: sections/section-pushpa-dinner-sets.liquid
{% endcomment %}

<style>
  /* ── Hero ── */
  .tcp-pushpa-hero {
    position: relative;
    min-height: 460px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .tcp-pushpa-hero__bg {
    position: absolute;
    inset: 0;
  }

  .tcp-pushpa-hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tcp-pushpa-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(35, 28, 22, 0.8) 0%, rgba(35, 28, 22, 0.3) 60%, rgba(35, 28, 22, 0.15) 100%);
  }

  .tcp-pushpa-hero__inner {
    position: relative;
    z-index: 2;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 80px 56px;
    width: 100%;
  }

  .tcp-pushpa-hero__title {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: clamp(44px, 6vw, 72px);
    font-weight: 400;
    color: var(--tcp-white, #FFFFFF);
    line-height: 1.05;
    margin-bottom: 8px;
  }

  .tcp-pushpa-hero__subtitle-line {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: 18px;
    font-weight: 400;
    font-style: italic;
    color: var(--tcp-white, #FFFFFF);
    display: block;
    margin-bottom: 4px;
  }

  .tcp-pushpa-hero__divider {
    width: 48px;
    height: 2px;
    background-color: var(--tcp-gold, #C8A96E);
    margin: 16px 0;
  }

  .tcp-pushpa-hero__desc {
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 15px;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    max-width: 440px;
    margin-bottom: 28px;
  }

  .tcp-pushpa-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--tcp-white, #FFFFFF);
    text-decoration: none;
    padding: 14px 28px;
    background-color: var(--tcp-dark, #2D2D2D);
    border: 1.5px solid var(--tcp-dark, #2D2D2D);
    transition: all 0.3s ease;
  }

  .tcp-pushpa-hero__btn:hover {
    background-color: var(--tcp-gold, #C8A96E);
    border-color: var(--tcp-gold, #C8A96E);
  }

  /* ── Expressions Title ── */
  .tcp-pushpa-expressions {
    background-color: var(--tcp-white, #FFFFFF);
    padding: 80px 0 0;
  }

  .tcp-pushpa-expressions__header {
    text-align: center;
    margin-bottom: 64px;
  }

  .tcp-pushpa-expressions__title {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 400;
    color: var(--tcp-dark, #2D2D2D);
    margin-bottom: 12px;
  }

  .tcp-pushpa-expressions__subtitle {
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 15px;
    color: var(--tcp-muted, #6B6560);
    line-height: 1.6;
  }

  /* ── Expression Cards (Alternating) ── */
  .tcp-expression {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    min-height: 400px;
    overflow: hidden;
  }

  .tcp-expression:nth-child(even) .tcp-expression__content {
    order: 1;
  }

  .tcp-expression:nth-child(even) .tcp-expression__image-wrap {
    order: 2;
  }

  .tcp-expression:nth-child(odd) .tcp-expression__content {
    order: 2;
  }

  .tcp-expression:nth-child(odd) .tcp-expression__image-wrap {
    order: 1;
  }

  .tcp-expression__image-wrap {
    position: relative;
    overflow: hidden;
    background-color: var(--tcp-beige, #F5F0E8);
  }

  .tcp-expression__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 400px;
    transition: transform 0.8s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .tcp-expression:hover .tcp-expression__image {
    transform: scale(1.04);
  }

  .tcp-expression__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 48px 60px;
    background-color: var(--tcp-cream, #FAF8F4);
  }

  .tcp-expression:nth-child(even) .tcp-expression__content {
    background-color: var(--tcp-white, #FFFFFF);
  }

  .tcp-expression__name {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 400;
    color: var(--tcp-dark, #2D2D2D);
    margin-bottom: 4px;
  }

  .tcp-expression__tagline {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: 16px;
    font-weight: 400;
    font-style: italic;
    color: var(--tcp-gold, #C8A96E);
    margin-bottom: 20px;
  }

  .tcp-expression__description {
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 14px;
    color: var(--tcp-muted, #6B6560);
    line-height: 1.7;
    max-width: 380px;
    margin-bottom: 28px;
  }

  .tcp-expression__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--tcp-gold, #C8A96E);
    text-decoration: none;
    transition: color 0.3s ease;
    align-self: flex-start;
  }

  .tcp-expression__cta:hover {
    color: var(--tcp-gold-hover, #B8965A);
  }

  .tcp-expression__cta svg {
    width: 14px;
    height: 14px;
    transition: transform 0.3s ease;
  }

  .tcp-expression__cta:hover svg {
    transform: translateX(4px);
  }

  /* ── Bottom Quote ── */
  .tcp-pushpa-quote {
    position: relative;
    min-height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-top: 0;
  }

  .tcp-pushpa-quote__bg {
    position: absolute;
    inset: 0;
  }

  .tcp-pushpa-quote__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tcp-pushpa-quote__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(35, 28, 22, 0.75);
  }

  .tcp-pushpa-quote__text {
    position: relative;
    z-index: 2;
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: clamp(24px, 3.5vw, 40px);
    font-weight: 400;
    color: var(--tcp-white, #FFFFFF);
    text-align: center;
    line-height: 1.3;
    max-width: 700px;
    padding: 0 40px;
  }

  /* ── Trust Badges ── */
  .tcp-pushpa-trust {
    background-color: var(--tcp-cream, #FAF8F4);
    padding: 40px 0;
    border-top: 1px solid var(--tcp-border, #E5DFD5);
  }

  .tcp-pushpa-trust__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    justify-content: center;
    gap: 48px;
    flex-wrap: wrap;
  }

  .tcp-pushpa-trust__badge {
    display: flex;
    align-items: center;
    gap: 12px;
    text-align: left;
  }

  .tcp-pushpa-trust__badge-icon {
    width: 32px;
    height: 32px;
    color: var(--tcp-gold, #C8A96E);
    flex-shrink: 0;
  }

  .tcp-pushpa-trust__badge-title {
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--tcp-dark, #2D2D2D);
    display: block;
    margin-bottom: 2px;
  }

  .tcp-pushpa-trust__badge-desc {
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 11px;
    color: var(--tcp-muted, #6B6560);
  }

  /* ── View All CTA ── */
  .tcp-pushpa-view-all {
    text-align: center;
    padding: 32px 40px;
    background-color: var(--tcp-cream, #FAF8F4);
  }

  .tcp-pushpa-view-all__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--tcp-white, #FFFFFF);
    text-decoration: none;
    padding: 16px 36px;
    background-color: var(--tcp-dark, #2D2D2D);
    border: 1.5px solid var(--tcp-dark, #2D2D2D);
    transition: all 0.3s ease;
  }

  .tcp-pushpa-view-all__btn:hover {
    background-color: var(--tcp-gold, #C8A96E);
    border-color: var(--tcp-gold, #C8A96E);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .tcp-expression {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .tcp-expression__content {
      order: 2 !important;
      padding: 36px 24px;
    }

    .tcp-expression__image-wrap {
      order: 1 !important;
    }

    .tcp-expression__image {
      min-height: 280px;
    }

    .tcp-pushpa-hero__inner {
      padding: 0 24px 40px;
    }

    .tcp-pushpa-trust__inner {
      gap: 24px;
    }

    .tcp-pushpa-trust__badge {
      flex: 0 0 calc(50% - 12px);
    }
  }

  @media (max-width: 600px) {
    .tcp-pushpa-hero {
      min-height: 360px;
    }

    .tcp-pushpa-trust__badge {
      flex: 0 0 100%;
      justify-content: center;
    }
  }
</style>

<!-- ── Hero ── -->
<section class="tcp-pushpa-hero" id="tcp-pushpa-hero">
  <div class="tcp-pushpa-hero__bg">
    {% if section.settings.hero_image != blank %}
      <img class="tcp-pushpa-hero__bg-img" src="{{ section.settings.hero_image | image_url: width: 1600 }}" alt="Pushpa Dinner Sets" loading="eager" fetchpriority="high" width="1600" height="600">
    {% else %}
      <div class="tcp-pushpa-hero__bg-img" style="background: linear-gradient(135deg, #5C4F44, #3A2F28);"></div>
    {% endif %}
    <div class="tcp-pushpa-hero__overlay"></div>
  </div>

  <div class="tcp-pushpa-hero__inner">
    <h1 class="tcp-pushpa-hero__title">{{ section.settings.hero_title }}</h1>
    <div class="tcp-pushpa-hero__divider"></div>
    <p class="tcp-pushpa-hero__desc">{{ section.settings.hero_description }}</p>
    {% if section.settings.hero_cta_text != blank %}
      <a href="{{ section.settings.hero_cta_url | default: '#' }}" class="tcp-pushpa-hero__btn">
        {{ section.settings.hero_cta_text }}
      </a>
    {% endif %}
  </div>
</section>

<!-- ── The Seven Expressions ── -->
<div class="tcp-pushpa-expressions" id="tcp-pushpa-expressions">
  <div class="tcp-pushpa-expressions__header">
    <h2 class="tcp-pushpa-expressions__title">{{ section.settings.expressions_title }}</h2>
    <p class="tcp-pushpa-expressions__subtitle">{{ section.settings.expressions_subtitle }}</p>
  </div>

  {% for block in section.blocks %}
    {% if block.type == 'expression' %}
      <div class="tcp-expression" {{ block.shopify_attributes }}>
        <div class="tcp-expression__image-wrap">
          {% if block.settings.image != blank %}
            <img class="tcp-expression__image" src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.name }}" loading="lazy" width="800" height="600">
          {% else %}
            <div class="tcp-expression__image" style="background: var(--tcp-warm-bg);"></div>
          {% endif %}
        </div>
        <div class="tcp-expression__content">
          <h3 class="tcp-expression__name">{{ block.settings.name }}</h3>
          <p class="tcp-expression__tagline">{{ block.settings.tagline }}</p>
          <p class="tcp-expression__description">{{ block.settings.description }}</p>
          <a href="{{ block.settings.link_url | default: '#' }}" class="tcp-expression__cta">
            SHOP THE COLLECTION
            <svg viewBox="0 0 14 14" fill="none"><path d="M2 7h9M7.5 3.5L11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>

<!-- ── Bottom Quote ── -->
{% if section.settings.show_quote %}
  <div class="tcp-pushpa-quote">
    <div class="tcp-pushpa-quote__bg">
      {% if section.settings.quote_bg_image != blank %}
        <img class="tcp-pushpa-quote__bg-img" src="{{ section.settings.quote_bg_image | image_url: width: 1600 }}" alt="" loading="lazy" width="1600" height="400">
      {% else %}
        <div class="tcp-pushpa-quote__bg-img" style="background: var(--tcp-brown);"></div>
      {% endif %}
      <div class="tcp-pushpa-quote__overlay"></div>
    </div>
    <p class="tcp-pushpa-quote__text">{{ section.settings.quote_text }}</p>
  </div>
{% endif %}

<!-- ── View All CTA ── -->
{% if section.settings.show_view_all %}
  <div class="tcp-pushpa-view-all">
    <a href="{{ section.settings.view_all_url | default: '#' }}" class="tcp-pushpa-view-all__btn">
      {{ section.settings.view_all_text }}
    </a>
  </div>
{% endif %}

<!-- ── Trust Badges ── -->
<div class="tcp-pushpa-trust">
  <div class="tcp-pushpa-trust__inner">
    {% for block in section.blocks %}
      {% if block.type == 'trust_badge' %}
        <div class="tcp-pushpa-trust__badge" {{ block.shopify_attributes }}>
          <svg class="tcp-pushpa-trust__badge-icon" viewBox="0 0 32 32" fill="none">
            {% case block.settings.icon %}
              {% when 'handcrafted' %}
                <path d="M16 6C12 6 8 10 8 14c0 4 4 8 8 12 4-4 8-8 8-12 0-4-4-8-8-8z" stroke="currentColor" stroke-width="1.5" fill="none"/>
                <circle cx="16" cy="14" r="3" stroke="currentColor" stroke-width="1.5"/>
              {% when 'lead_free' %}
                <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.5"/>
                <path d="M11 16l3 3 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              {% when 'dishwasher' %}
                <rect x="6" y="8" width="20" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
                <path d="M6 14h20" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="12" cy="20" r="2" stroke="currentColor" stroke-width="1"/>
                <circle cx="20" cy="20" r="2" stroke="currentColor" stroke-width="1"/>
              {% when 'made_to_last' %}
                <path d="M16 4v24M8 12l8-8 8 8M8 20l8 8 8-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              {% else %}
                <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.5"/>
                <path d="M11 16l3 3 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            {% endcase %}
          </svg>
          <div>
            <span class="tcp-pushpa-trust__badge-title">{{ block.settings.title }}</span>
            <span class="tcp-pushpa-trust__badge-desc">{{ block.settings.description }}</span>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "TCP Pushpa Dinner Sets",
  "tag": "section",
  "class": "tcp-pushpa-section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_title", "label": "Hero title", "default": "Pushpa\nDinner Sets" },
    { "type": "textarea", "id": "hero_description", "label": "Hero description", "default": "Seven expressions of a mother's presence—each set carrying a different emotion, yet belonging to the same story." },
    { "type": "text", "id": "hero_cta_text", "label": "Hero CTA text", "default": "EXPLORE THE COLLECTION" },
    { "type": "url", "id": "hero_cta_url", "label": "Hero CTA URL" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero background image" },

    { "type": "header", "content": "Expressions Section" },
    { "type": "text", "id": "expressions_title", "label": "Expressions title", "default": "The Seven Expressions" },
    { "type": "text", "id": "expressions_subtitle", "label": "Expressions subtitle", "default": "Choose the emotion that resonates with your table." },

    { "type": "header", "content": "Quote Banner" },
    { "type": "checkbox", "id": "show_quote", "label": "Show quote banner", "default": true },
    { "type": "text", "id": "quote_text", "label": "Quote text", "default": "A table is not just set—\nit is remembered." },
    { "type": "image_picker", "id": "quote_bg_image", "label": "Quote background image" },

    { "type": "header", "content": "View All CTA" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all button", "default": true },
    { "type": "text", "id": "view_all_text", "label": "View all text", "default": "VIEW ALL DINNER SETS" },
    { "type": "url", "id": "view_all_url", "label": "View all URL" }
  ],
  "blocks": [
    {
      "type": "expression",
      "name": "Dinner Set Expression",
      "settings": [
        { "type": "text", "id": "name", "label": "Set name", "default": "Smriti" },
        { "type": "text", "id": "tagline", "label": "Tagline", "default": "Memory & Remembrance" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Symbolizes cherished memories and the everlasting presence of love." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link_url", "label": "Collection link" }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        { "type": "text", "id": "title", "label": "Badge title", "default": "HANDCRAFTED" },
        { "type": "text", "id": "description", "label": "Badge description", "default": "in India" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "handcrafted",
          "options": [
            { "value": "handcrafted", "label": "Handcrafted" },
            { "value": "lead_free", "label": "Lead-free / Safe" },
            { "value": "dishwasher", "label": "Dishwasher" },
            { "value": "made_to_last", "label": "Made to last" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TCP Pushpa Dinner Sets",
      "blocks": [
        { "type": "expression", "settings": { "name": "Smriti", "tagline": "Memory & Remembrance", "description": "Symbolizes cherished memories and the everlasting presence of love." } },
        { "type": "expression", "settings": { "name": "Shakti", "tagline": "Power & Strength", "description": "Represents resilience, inner strength, and the divine feminine energy." } },
        { "type": "expression", "settings": { "name": "Shringaar", "tagline": "Beauty & Grace", "description": "Expresses elegance, charm, and the aesthetic beauty of a mother's presence." } },
        { "type": "expression", "settings": { "name": "Sneha", "tagline": "Love & Affection", "description": "Represents warmth, care, and unconditional love that nurtures." } },
        { "type": "expression", "settings": { "name": "Sammaan", "tagline": "Respect & Honor", "description": "Embodies gratitude and appreciation for a mother's impact and values." } },
        { "type": "expression", "settings": { "name": "Aaradhya", "tagline": "Reverence & Devotion", "description": "Symbolizes deep devotion and a sacred bond with life, family and purpose." } },
        { "type": "expression", "settings": { "name": "Karuna", "tagline": "Compassion & Empathy", "description": "Reflects kindness, selflessness, and the gentle love that makes the world better." } },
        { "type": "trust_badge", "settings": { "title": "HANDCRAFTED", "description": "in India", "icon": "handcrafted" } },
        { "type": "trust_badge", "settings": { "title": "LEAD-FREE GLAZE", "description": "Food safe", "icon": "lead_free" } },
        { "type": "trust_badge", "settings": { "title": "DISHWASHER SAFE", "description": "For everyday use", "icon": "dishwasher" } },
        { "type": "trust_badge", "settings": { "title": "MADE TO BE LOVED", "description": "And passed on", "icon": "made_to_last" } }
      ]
    }
  ]
}
{% endschema %}
