{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Gifting & Experiences Split
  ============================================================
  Twin editorial cards for Gifting and Immersive Studio Experiences.
  Copy into Shopify: sections/section-home-gifting-experiences.liquid
{% endcomment %}

<style>
  .tcp-split {
    background-color: var(--tcp-sand, #FBF9F5);
    padding: 80px 0;
  }

  .tcp-split__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .tcp-split__card {
    background: var(--tcp-white, #FFFFFF);
    border: 1px solid var(--tcp-border, #E8E2D8);
    border-radius: 6px;
    padding: 48px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.4s var(--ease-fluid), box-shadow 0.4s var(--ease-fluid), border-color 0.3s ease;
  }

  .tcp-split__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(31, 29, 27, 0.08);
    border-color: var(--tcp-gold-light, #DFBA5E);
  }

  .tcp-split__label {
    font-family: var(--font-sans, sans-serif);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2.2px;
    text-transform: uppercase;
    color: var(--tcp-gold, #C29B38);
    margin-bottom: 12px;
    display: block;
  }

  .tcp-split__heading {
    font-family: var(--font-serif, serif);
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 400;
    color: var(--tcp-dark, #1F1D1B);
    line-height: 1.2;
    margin: 0 0 12px;
  }

  .tcp-split__description {
    font-family: var(--font-sans, sans-serif);
    font-size: 14px;
    color: var(--tcp-muted, #68625B);
    line-height: 1.7;
    margin: 0 0 24px;
  }

  .tcp-split__image-wrap {
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 28px;
    background: var(--tcp-stone, #F3EFEA);
  }

  .tcp-split__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .tcp-split__card:hover .tcp-split__image {
    transform: scale(1.04);
  }

  .tcp-split__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans, sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--tcp-dark, #1F1D1B);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1.5px solid var(--tcp-dark, #1F1D1B);
    transition: all 0.3s ease;
    align-self: flex-start;
  }

  .tcp-split__cta:hover {
    color: var(--tcp-gold, #C29B38);
    border-bottom-color: var(--tcp-gold, #C29B38);
    transform: translateX(4px);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .tcp-split__inner {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .tcp-split__card {
      padding: 32px 24px;
    }
  }
</style>

<section class="tcp-split" id="tcp-home-gifting-experiences">
  <div class="tcp-split__inner">

    {% for block in section.blocks %}
      {% if block.type == 'split_card' %}
        <div class="tcp-split__card" {{ block.shopify_attributes }}>
          <div>
            <span class="tcp-split__label">{{ block.settings.label }}</span>
            <h3 class="tcp-split__heading">{{ block.settings.heading }}</h3>
            <p class="tcp-split__description">{{ block.settings.description }}</p>
          </div>

          <div class="tcp-split__image-wrap">
            {% if block.settings.image != blank %}
              <img 
                class="tcp-split__image"
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.heading | strip_html }}"
                loading="lazy"
                width="800"
                height="450"
              >
            {% else %}
              <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background: radial-gradient(circle, #FAF8F4 0%, #EDE6DC 100%);">
                <svg width="60" height="60" viewBox="0 0 60 60" fill="none" opacity="0.6">
                  <rect x="10" y="10" width="40" height="40" rx="2" stroke="#C29B38" stroke-width="1.5"/>
                  <path d="M10 30h40M30 10v40" stroke="#DFBA5E" stroke-width="1.2"/>
                </svg>
              </div>
            {% endif %}
          </div>

          <a href="{{ block.settings.cta_url | default: '#' }}" class="tcp-split__cta">
            {{ block.settings.cta_text }} &rarr;
          </a>
        </div>
      {% endif %}
    {% endfor %}

  </div>
</section>

{% schema %}
{
  "name": "TCP Gifting & Experiences",
  "tag": "section",
  "class": "tcp-split-section",
  "blocks": [
    {
      "type": "split_card",
      "name": "Split Card",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "CURATED GIFTING" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Thoughtful by Design. Made to be Remembered." },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Bespoke gift boxes for weddings, corporate tokens of gratitude, and cherished family milestones." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Explore Gifting" },
        { "type": "url", "id": "cta_url", "label": "CTA URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TCP Gifting & Experiences",
      "blocks": [
        {
          "type": "split_card",
          "settings": {
            "label": "CURATED GIFTING",
            "heading": "Thoughtful by Design. Made to be Remembered.",
            "description": "Bespoke handcrafted gift sets and signature boxes wrapped in natural unbleached cotton.",
            "cta_text": "Explore Gift Boxes",
            "cta_url": "/collections/gifting"
          }
        },
        {
          "type": "split_card",
          "settings": {
            "label": "STUDIO EXPERIENCES",
            "heading": "Shared Rituals Around Clay & Making.",
            "description": "Engage directly with raw clay, tactile wheel throwing, and sensory tablescaping masterclasses.",
            "cta_text": "Book An Experience",
            "cta_url": "/pages/experiences"
          }
        }
      ]
    }
  ]
}
{% endschema %}
