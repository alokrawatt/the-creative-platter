    { "type": "text", "id": "set_2_name", "label": "Set 2 Name", "default": "Mrida" },
    { "type": "text", "id": "set_2_tagline", "label": "Set 2 Tagline", "default": "Earthy • Raw • Grounded" },
    { "type": "url", "id": "set_2_url", "label": "Set 2 URL" },
    {
      "type": "header",
      "content": "Set 3: Rekh"
    },
    { "type": "image_picker", "id": "set_3_image", "label": "Set 3 Image" },
    { "type": "text", "id": "set_3_name", "label": "Set 3 Name", "default": "Rekh" },
    { "type": "text", "id": "set_3_tagline", "label": "Set 3 Tagline", "default": "Minimal • Modern • Refined" },
    { "type": "url", "id": "set_3_url", "label": "Set 3 URL" },
    {
      "type": "header",
      "content": "Set 4: Viraasat"
    },
    { "type": "image_picker", "id": "set_4_image", "label": "Set 4 Image" },
    { "type": "text", "id": "set_4_name", "label": "Set 4 Name", "default": "Viraasat" },
    { "type": "text", "id": "set_4_tagline", "label": "Set 4 Tagline", "default": "Rich • Layered • Celebratory" },
    { "type": "url", "id": "set_4_url", "label": "Set 4 URL" },
    {
      "type": "header",
      "content": "Set 5: Neer"
    },
    { "type": "image_picker", "id": "set_5_image", "label": "Set 5 Image" },
    { "type": "text", "id": "set_5_name", "label": "Set 5 Name", "default": "Neer" },
    { "type": "text", "id": "set_5_tagline", "label": "Set 5 Tagline", "default": "Light • Calm • Everyday" },
    { "type": "url", "id": "set_5_url", "label": "Set 5 URL" }
  ],
  "presets": [
    {
      "name": "Shop — Signature Sets"
    }
  ]
