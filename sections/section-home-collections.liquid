{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Home Collections Grid
  ============================================================
  4-column grid showcasing collection categories:
  Dinnerware, Linen, Serveware, Objects.
  Copy into Shopify: sections/section-home-collections.liquid
{% endcomment %}

<style>
  .tcp-collections {
    background-color: var(--tcp-white, #FFFFFF);
    padding: 80px 0;
  }

  .tcp-collections__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .tcp-collections__header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 40px;
  }

  .tcp-collections__title {
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--tcp-dark, #2D2D2D);
    white-space: nowrap;
  }

  .tcp-collections__line {
    flex: 1;
    height: 1px;
    background-color: var(--tcp-border, #E5DFD5);
  }

  .tcp-collections__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  /* ── Collection Card ── */
  .tcp-collection-card {
    position: relative;
    overflow: hidden;
    background-color: var(--tcp-beige, #F5F0E8);
    text-decoration: none;
    display: block;
    group: true;
  }

  .tcp-collection-card__image-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .tcp-collection-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .tcp-collection-card:hover .tcp-collection-card__image {
    transform: scale(1.06);
  }

  .tcp-collection-card__content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background-color: var(--tcp-white, #FFFFFF);
  }

  .tcp-collection-card__name {
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--tcp-dark, #2D2D2D);
  }

  .tcp-collection-card__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--tcp-border, #E5DFD5);
    color: var(--tcp-dark, #2D2D2D);
    transition: all 0.3s ease;
  }

  .tcp-collection-card:hover .tcp-collection-card__arrow {
    background-color: var(--tcp-gold, #C8A96E);
    border-color: var(--tcp-gold, #C8A96E);
    color: var(--tcp-white, #FFFFFF);
  }

  .tcp-collection-card__arrow svg {
    width: 12px;
    height: 12px;
    transition: transform 0.3s ease;
  }

  .tcp-collection-card:hover .tcp-collection-card__arrow svg {
    transform: translateX(2px);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .tcp-collections__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .tcp-collections {
      padding: 60px 0;
    }
  }

  @media (max-width: 500px) {
    .tcp-collections__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .tcp-collections__inner {
      padding: 0 24px;
    }
  }
</style>

<section class="tcp-collections" id="tcp-home-collections">
  <div class="tcp-collections__inner">

    <div class="tcp-collections__header">
      <h2 class="tcp-collections__title">{{ section.settings.heading | default: 'EXPLORE OUR COLLECTION' }}</h2>
      <div class="tcp-collections__line"></div>
    </div>

    <div class="tcp-collections__grid">
      {% for block in section.blocks %}
        {% if block.type == 'collection_card' %}
          <a href="{{ block.settings.link_url | default: '#' }}" class="tcp-collection-card" {{ block.shopify_attributes }}>
            <div class="tcp-collection-card__image-wrap">
              {% if block.settings.image != blank %}
                <img 
                  class="tcp-collection-card__image"
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.name }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="tcp-collection-card__image" style="background: var(--tcp-warm-bg, #EDE8E0);"></div>
              {% endif %}
            </div>
            <div class="tcp-collection-card__content">
              <span class="tcp-collection-card__name">{{ block.settings.name }}</span>
              <span class="tcp-collection-card__arrow">
                <svg viewBox="0 0 14 14" fill="none"><path d="M2 7h9M7.5 3.5L11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "TCP Collections Grid",
  "tag": "section",
  "class": "tcp-collections-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "EXPLORE OUR COLLECTION"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Collection name",
          "default": "DINNERWARE"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Collection image"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Collection link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TCP Collections Grid",
      "blocks": [
        { "type": "collection_card", "settings": { "name": "DINNERWARE" } },
        { "type": "collection_card", "settings": { "name": "LINEN" } },
        { "type": "collection_card", "settings": { "name": "SERVEWARE" } },
        { "type": "collection_card", "settings": { "name": "OBJECTS" } }
      ]
    }
  ]
}
{% endschema %}
