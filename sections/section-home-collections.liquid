{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Home Collections Grid (Nicobar Inspired)
  ============================================================
  Fluid editorial collection showcase featuring Pushpa Legacy Sets,
  Dinnerware, Serveware, and Table Linens with micro-zoom & counts.
  Copy into Shopify: sections/section-home-collections.liquid
{% endcomment %}

<style>
  .tcp-collections {
    background-color: var(--tcp-white, #FFFFFF);
    padding: 90px 0;
    position: relative;
  }

  .tcp-collections__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .tcp-collections__header-wrap {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 48px;
    gap: 24px;
  }

  .tcp-collections__title-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tcp-collections__label {
    font-family: var(--font-sans, sans-serif);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2.2px;
    text-transform: uppercase;
    color: var(--tcp-gold, #C29B38);
  }

  .tcp-collections__heading {
    font-family: var(--font-serif, serif);
    font-size: clamp(32px, 3.8vw, 46px);
    font-weight: 400;
    color: var(--tcp-dark, #1F1D1B);
    line-height: 1.1;
    margin: 0;
  }

  .tcp-collections__view-all {
    font-family: var(--font-sans, sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--tcp-dark, #1F1D1B);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 4px;
    border-bottom: 1.5px solid var(--tcp-dark, #1F1D1B);
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .tcp-collections__view-all:hover {
    color: var(--tcp-gold, #C29B38);
    border-bottom-color: var(--tcp-gold, #C29B38);
    transform: translateX(3px);
  }

  /* ── 4-Column Fluid Grid ── */
  .tcp-collections__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  .tcp-collection-card {
    position: relative;
    text-decoration: none;
    color: var(--tcp-dark, #1F1D1B);
    display: flex;
    flex-direction: column;
    group: true;
    background: var(--tcp-sand, #FBF9F5);
    border: 1px solid var(--tcp-border, #E8E2D8);
    border-radius: 4px;
    overflow: hidden;
    transition: transform 0.4s var(--ease-fluid), box-shadow 0.4s var(--ease-fluid), border-color 0.3s ease;
  }

  .tcp-collection-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(31, 29, 27, 0.08);
    border-color: var(--tcp-gold-light, #DFBA5E);
  }

  .tcp-collection-card__media {
    position: relative;
    aspect-ratio: 1 / 1.15;
    overflow: hidden;
    background: var(--tcp-stone, #F3EFEA);
  }

  .tcp-collection-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-fluid);
  }

  .tcp-collection-card:hover .tcp-collection-card__img {
    transform: scale(1.06);
  }

  .tcp-collection-card__tag {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    border: 1px solid var(--tcp-border, #E8E2D8);
    padding: 3px 8px;
    border-radius: 2px;
    font-family: var(--font-sans, sans-serif);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--tcp-brown, #352922);
  }

  .tcp-collection-card__content {
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--tcp-white, #FFFFFF);
    border-top: 1px solid var(--tcp-border, #E8E2D8);
  }

  .tcp-collection-card__info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .tcp-collection-card__name {
    font-family: var(--font-serif, serif);
    font-size: 19px;
    font-weight: 600;
    color: var(--tcp-dark, #1F1D1B);
    line-height: 1.2;
    transition: color 0.2s ease;
  }

  .tcp-collection-card:hover .tcp-collection-card__name {
    color: var(--tcp-gold-hover, #A8822B);
  }

  .tcp-collection-card__sub {
    font-family: var(--font-sans, sans-serif);
    font-size: 11px;
    color: var(--tcp-muted, #68625B);
  }

  .tcp-collection-card__arrow-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--tcp-stone, #F3EFEA);
    border: 1px solid var(--tcp-border, #E8E2D8);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--tcp-dark, #1F1D1B);
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .tcp-collection-card:hover .tcp-collection-card__arrow-btn {
    background: var(--tcp-dark, #1F1D1B);
    border-color: var(--tcp-dark, #1F1D1B);
    color: #FFFFFF;
    transform: rotate(-45deg);
  }

  .tcp-collection-card__arrow-btn svg {
    width: 13px;
    height: 13px;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .tcp-collections__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 600px) {
    .tcp-collections {
      padding: 60px 0;
    }
    .tcp-collections__inner {
      padding: 0 20px;
    }
    .tcp-collections__header-wrap {
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: 32px;
    }
    .tcp-collections__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>

<section class="tcp-collections" id="tcp-home-collections">
  <div class="tcp-collections__inner">

    <div class="tcp-collections__header-wrap">
      <div class="tcp-collections__title-group">
        <span class="tcp-collections__label">{{ section.settings.label | default: 'CRAFTED FOR RITUAL' }}</span>
        <h2 class="tcp-collections__heading">{{ section.settings.heading | default: 'Explore By Category' }}</h2>
      </div>
      <a href="{{ section.settings.view_all_url | default: '/collections/all' }}" class="tcp-collections__view-all">
        {{ section.settings.view_all_text | default: 'View Complete Catalog' }} &rarr;
      </a>
    </div>

    <div class="tcp-collections__grid">
      {% for block in section.blocks %}
        {% if block.type == 'collection_card' %}
          <a href="{{ block.settings.link_url | default: '#' }}" class="tcp-collection-card" {{ block.shopify_attributes }}>
            <div class="tcp-collection-card__media">
              {% if block.settings.tag != blank %}
                <span class="tcp-collection-card__tag">{{ block.settings.tag }}</span>
              {% endif %}

              {% if block.settings.image != blank %}
                <img 
                  class="tcp-collection-card__img"
                  src="{{ block.settings.image | image_url: width: 700 }}"
                  alt="{{ block.settings.name }}"
                  loading="lazy"
                  width="700"
                  height="800"
                >
              {% else %}
                <!-- Fallback Luxury Ceramic Category Graphic -->
                <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background: radial-gradient(circle, #FAF8F4 0%, #EDE7DD 100%);">
                  <svg width="100" height="100" viewBox="0 0 100 100" fill="none" opacity="0.6">
                    <circle cx="50" cy="50" r="38" stroke="#C29B38" stroke-width="1.5" stroke-dasharray="6 3"/>
                    <ellipse cx="50" cy="50" rx="26" ry="18" stroke="#1F1D1B" stroke-width="1.2"/>
                  </svg>
                </div>
              {% endif %}
            </div>

            <div class="tcp-collection-card__content">
              <div class="tcp-collection-card__info">
                <span class="tcp-collection-card__name">{{ block.settings.name }}</span>
                <span class="tcp-collection-card__sub">{{ block.settings.subtext | default: 'Explore Curated Pieces' }}</span>
              </div>
              <span class="tcp-collection-card__arrow-btn">
                <svg viewBox="0 0 14 14" fill="none"><path d="M2 7h9M7.5 3.5L11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "TCP Collections Grid",
  "tag": "section",
  "class": "tcp-collections-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Top label",
      "default": "CRAFTED FOR RITUAL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Explore By Category"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all link text",
      "default": "View Complete Catalog"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all link URL"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Badge tag",
          "default": "Legacy 2025"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Collection name",
          "default": "Pushpa Dinner Sets"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtitle / count",
          "default": "7 Unique Expressions"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Collection image"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Collection link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TCP Collections Grid",
      "blocks": [
        { "type": "collection_card", "settings": { "name": "Pushpa Dinner Sets", "tag": "The 7 Expressions", "subtext": "Smriti, Shakti & More", "link_url": "/collections/pushpa" } },
        { "type": "collection_card", "settings": { "name": "Plates & Bowls", "tag": "Everyday Dining", "subtext": "Individual Dining Essentials", "link_url": "/collections/plates" } },
        { "type": "collection_card", "settings": { "name": "Serveware & Platters", "tag": "Feasting", "subtext": "Mould-free Centerpieces", "link_url": "/collections/platters" } },
        { "type": "collection_card", "settings": { "name": "Table Linens & Decor", "tag": "Handloom", "subtext": "Organic Cotton & Ceramic Objects", "link_url": "/collections/linen" } }
      ]
    }
  ]
}
{% endschema %}
