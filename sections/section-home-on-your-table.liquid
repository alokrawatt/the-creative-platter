{% comment %}
  ============================================================
  THE CREATIVE PLATTER — On Your Table & Editorial Press
  ============================================================
  Press accolades (Vogue, Condé Nast, The Hindu) +
  living customer tablescapes.
  Copy into Shopify: sections/section-home-on-your-table.liquid
{% endcomment %}

<style>
  .tcp-on-table {
    background: var(--tcp-white, #FFFFFF);
    padding: 80px 0;
    position: relative;
    border-top: 1px solid var(--tcp-border, #E8E2D8);
  }

  .tcp-on-table__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ── Press Marquee / Logo Bar ── */
  .tcp-press-bar {
    text-align: center;
    margin-bottom: 60px;
    padding-bottom: 50px;
    border-bottom: 1px solid var(--tcp-border, #E8E2D8);
  }

  .tcp-press-bar__label {
    font-family: var(--font-sans, sans-serif);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--tcp-muted, #68625B);
    margin-bottom: 24px;
    display: block;
  }

  .tcp-press-bar__logos {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 48px;
    flex-wrap: wrap;
  }

  .tcp-press-item {
    font-family: var(--font-serif, serif);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--tcp-brown-light, #52443A);
    opacity: 0.85;
    transition: opacity 0.3s ease, color 0.3s ease;
  }

  .tcp-press-item:hover {
    opacity: 1;
    color: var(--tcp-gold, #C29B38);
  }

  /* ── Hero Banner ── */
  .tcp-on-table__banner {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    min-height: 400px;
    display: flex;
    align-items: flex-end;
    background: #2B231D;
  }

  .tcp-on-table__banner-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.65;
    transition: transform 0.8s var(--ease-fluid);
  }

  .tcp-on-table__banner:hover .tcp-on-table__banner-img {
    transform: scale(1.03);
  }

  .tcp-on-table__banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(31, 29, 27, 0.9) 0%, rgba(31, 29, 27, 0.2) 60%, transparent 100%);
  }

  .tcp-on-table__banner-content {
    position: relative;
    z-index: 2;
    padding: 48px;
    max-width: 600px;
  }

  .tcp-on-table__heading {
    font-family: var(--font-serif, serif);
    font-size: clamp(34px, 4.5vw, 52px);
    font-weight: 400;
    color: #FFFFFF;
    line-height: 1.1;
    margin: 0 0 12px;
  }

  .tcp-on-table__description {
    font-family: var(--font-sans, sans-serif);
    font-size: 14.5px;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .tcp-on-table__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans, sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--tcp-gold-light, #DFBA5E);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1.5px solid var(--tcp-gold-light, #DFBA5E);
    transition: all 0.3s ease;
  }

  .tcp-on-table__cta:hover {
    color: #FFFFFF;
    border-bottom-color: #FFFFFF;
    transform: translateX(4px);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .tcp-on-table__inner {
      padding: 0 20px;
    }
    .tcp-press-bar__logos {
      gap: 24px;
    }
    .tcp-press-item {
      font-size: 16px;
    }
    .tcp-on-table__banner-content {
      padding: 32px 20px;
    }
  }
</style>

<section class="tcp-on-table" id="tcp-home-on-your-table">
  <div class="tcp-on-table__inner">

    <!-- Press Accolades -->
    <div class="tcp-press-bar">
      <span class="tcp-press-bar__label">RECOGNISED BY LEADING EDITORIAL PLATFORMS</span>
      <div class="tcp-press-bar__logos">
        <span class="tcp-press-item">VOGUE</span>
        <span class="tcp-press-item">CONDÉ NAST TRAVELLER</span>
        <span class="tcp-press-item">THE HINDU</span>
        <span class="tcp-press-item">TODAY'S HOME</span>
      </div>
    </div>

    <!-- Lifestyle Hero Banner -->
    <div class="tcp-on-table__banner">
      {% if section.settings.bg_image != blank %}
        <img 
          class="tcp-on-table__banner-img"
          src="{{ section.settings.bg_image | image_url: width: 1600 }}"
          alt="{{ section.settings.heading | strip_html }}"
          loading="lazy"
          width="1600"
          height="600"
        >
      {% endif %}
      <div class="tcp-on-table__banner-overlay"></div>

      <div class="tcp-on-table__banner-content">
        <h2 class="tcp-on-table__heading">{{ section.settings.heading | default: 'On Your Table' }}</h2>
        <p class="tcp-on-table__description">
          {{ section.settings.description | default: 'Designed to be used. Loved. Lived with. Ceramic objects that participate quietly in the human ritual of gathering.' }}
        </p>
        <a href="{{ section.settings.cta_url | default: 'https://instagram.com/thecreativeplatter_studio' }}" target="_blank" rel="noopener" class="tcp-on-table__cta">
          {{ section.settings.cta_text | default: 'View On Instagram @thecreativeplatter_studio' }} &rarr;
        </a>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "TCP On Your Table",
  "tag": "section",
  "class": "tcp-on-table-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "On Your Table"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Designed to be used. Loved. Lived with. Ceramic objects that participate quietly in the human ritual of gathering."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Follow @thecreativeplatter_studio"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    }
  ],
  "presets": [
    {
      "name": "TCP On Your Table"
    }
  ]
}
{% endschema %}
