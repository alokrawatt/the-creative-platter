{% comment %}
  ============================================================
  THE CREATIVE PLATTER — PDP Story & Accordion Split Section
  ============================================================
  Left: Editorial craft story & interactive accordions (Details, Care, Shipping, Promise)
  Right: High-impact lifestyle pottery staging imagery
{% endcomment %}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Raleway:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet">

<style>
  #tcp-pdp-story-{{ section.id }} {
    --tcp-gold-bright: #fcce3a;
    --tcp-accent-gold: #A6732E;
    --tcp-charcoal: #2D2A27;
    --tcp-stone-bg: #FAF7F2;
    --tcp-border-subtle: #E8E2D8;
    
    background-color: #FFFFFF;
    border-top: 1px solid var(--tcp-border-subtle);
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    position: relative;
    box-sizing: border-box;
  }

  .tcp-pdp-story__container {
    max-width: {{ section.settings.container_width | default: 1440 }}px;
    margin: 0 auto;
    padding: 0 40px;
    box-sizing: border-box;
  }

  @media (max-width: 768px) {
    .tcp-pdp-story__container {
      padding: 0 20px;
    }
  }

  .tcp-pdp-story__grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 64px;
    align-items: center;
  }

  @media (max-width: 1024px) {
    .tcp-pdp-story__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  /* Left Narrative */
  .tcp-pdp-story__narrative {
    max-width: 540px;
  }

  .tcp-pdp-story__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(32px, 4vw, 46px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.5px;
    color: var(--tcp-charcoal);
    margin: 0 0 16px;
  }

  .tcp-pdp-story__divider {
    width: 32px;
    height: 2px;
    background-color: var(--tcp-accent-gold);
    margin-bottom: 20px;
  }

  .tcp-pdp-story__desc {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 14px;
    line-height: 1.65;
    color: #545454;
    margin: 0 0 32px;
  }

  /* Accordions */
  .tcp-pdp-story__accordions {
    border-top: 1px solid var(--tcp-border-subtle);
  }

  .tcp-pdp-accordion-item {
    border-bottom: 1px solid var(--tcp-border-subtle);
  }

  .tcp-pdp-accordion-header {
    width: 100%;
    padding: 16px 0;
    background: transparent;
    border: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: var(--tcp-charcoal);
    cursor: pointer;
    text-align: left;
    transition: color 0.2s ease;
  }

  .tcp-pdp-accordion-header:hover {
    color: var(--tcp-accent-gold);
  }

  .tcp-pdp-accordion-icon {
    font-size: 14px;
    color: #8E8981;
    transition: transform 0.3s ease;
  }

  .tcp-pdp-accordion-item.is-open .tcp-pdp-accordion-icon {
    transform: rotate(90deg);
    color: var(--tcp-accent-gold);
  }

  .tcp-pdp-accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 13px;
    line-height: 1.65;
    color: #6A6560;
  }

  .tcp-pdp-accordion-inner {
    padding-bottom: 18px;
  }

  /* Right Media */
  .tcp-pdp-story__media-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 2px;
    background: var(--tcp-stone-bg);
    border: 1px solid var(--tcp-border-subtle);
  }

  .tcp-pdp-story__media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tcp-pdp-story__media-wrap:hover .tcp-pdp-story__media-img {
    transform: scale(1.03);
  }

  .tcp-pdp-story__fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at 45% 45%, #FAF7F2 0%, #E5DDD0 100%);
  }

  .tcp-pdp-story__fallback svg {
    width: 60%;
    height: 60%;
    opacity: 0.35;
  }
</style>

<section id="tcp-pdp-story-{{ section.id }}" class="tcp-pdp-story-section">
  <div class="tcp-pdp-story__container">
    <div class="tcp-pdp-story__grid">
      
      {% comment %} Left Column: Narrative & Accordions {% endcomment %}
      <div class="tcp-pdp-story__narrative">
        <h2 class="tcp-pdp-story__title">
          {{ section.settings.heading | default: 'A form shaped by memory.' }}
        </h2>
        <div class="tcp-pdp-story__divider"></div>
        <p class="tcp-pdp-story__desc">
          {{ section.settings.description | default: 'Each piece in the Pushpa collection is handcrafted in small batches. The Sand Form Plate is designed to bring balance to your table—quiet, timeless and made to be used, every day.' }}
        </p>

        <div class="tcp-pdp-story__accordions">
          {% comment %} Accordion 1: Product Details {% endcomment %}
          <div class="tcp-pdp-accordion-item">
            <button type="button" class="tcp-pdp-accordion-header">
              <span>{{ section.settings.acc_1_title | default: 'Product Details' }}</span>
              <span class="tcp-pdp-accordion-icon">&rsaquo;</span>
            </button>
            <div class="tcp-pdp-accordion-content">
              <div class="tcp-pdp-accordion-inner">
                {{ section.settings.acc_1_content | default: 'High-fired stoneware (1260–1280°C). Hand-formed organic edges with zero material off-cuts. Durable, chip-resistant and designed for daily hospitality and home rituals.' }}
              </div>
            </div>
          </div>

          {% comment %} Accordion 2: Care Instructions {% endcomment %}
          <div class="tcp-pdp-accordion-item">
            <button type="button" class="tcp-pdp-accordion-header">
              <span>{{ section.settings.acc_2_title | default: 'Care Instructions' }}</span>
              <span class="tcp-pdp-accordion-icon">&rsaquo;</span>
            </button>
            <div class="tcp-pdp-accordion-content">
              <div class="tcp-pdp-accordion-inner">
                {{ section.settings.acc_2_content | default: '100% Dishwasher and microwave safe. Hand-washing with a soft sponge and mild soap will help preserve the matte artisanal glaze for decades.' }}
              </div>
            </div>
          </div>

          {% comment %} Accordion 3: Shipping & Delivery {% endcomment %}
          <div class="tcp-pdp-accordion-item">
            <button type="button" class="tcp-pdp-accordion-header">
              <span>{{ section.settings.acc_3_title | default: 'Shipping & Delivery' }}</span>
              <span class="tcp-pdp-accordion-icon">&rsaquo;</span>
            </button>
            <div class="tcp-pdp-accordion-content">
              <div class="tcp-pdp-accordion-inner">
                {{ section.settings.acc_3_content | default: 'Dispatched within 2–3 business days. Delivered in 5–7 working days across India in reinforced eco-cushioned break-safe packaging.' }}
              </div>
            </div>
          </div>

          {% comment %} Accordion 4: Our Promise {% endcomment %}
          <div class="tcp-pdp-accordion-item">
            <button type="button" class="tcp-pdp-accordion-header">
              <span>{{ section.settings.acc_4_title | default: 'Our Promise' }}</span>
              <span class="tcp-pdp-accordion-icon">&rsaquo;</span>
            </button>
            <div class="tcp-pdp-accordion-content">
              <div class="tcp-pdp-accordion-inner">
                {{ section.settings.acc_4_content | default: '100% Lead-free and food safe. Produced in collaboration with village women artisans as an impact-driven craft practice.' }}
              </div>
            </div>
          </div>
        </div>

      </div>

      {% comment %} Right Column: Editorial Lifestyle Media {% endcomment %}
      <div class="tcp-pdp-story__media-wrap">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 1400 }}"
            srcset="
              {{ section.settings.image | image_url: width: 700 }} 700w,
              {{ section.settings.image | image_url: width: 1200 }} 1200w,
              {{ section.settings.image | image_url: width: 1600 }} 1600w
            "
            sizes="(max-width: 1024px) 100vw, 50vw"
            alt="{{ section.settings.heading | escape }}"
            class="tcp-pdp-story__media-img"
            loading="lazy"
          >
        {% else %}
          <div class="tcp-pdp-story__fallback">
            <svg viewBox="0 0 400 250" fill="none" xmlns="http://www.w3.org/2000/svg">
              <ellipse cx="200" cy="140" rx="140" ry="80" fill="#FAF7F2" stroke="#A6732E" stroke-width="2.5"/>
              <ellipse cx="200" cy="140" rx="100" ry="55" fill="#EDE4D6" stroke="#A6732E" stroke-width="1.5"/>
              <path d="M120 140 Q200 110 280 140" stroke="#fcce3a" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</section>

<script>
  (function() {
    function initPdpStoryAccordions(secEl) {
      if (!secEl) return;
      const items = secEl.querySelectorAll('.tcp-pdp-accordion-item');
      items.forEach((item) => {
        const header = item.querySelector('.tcp-pdp-accordion-header');
        const content = item.querySelector('.tcp-pdp-accordion-content');
        if (header && content) {
          header.addEventListener('click', () => {
            const isOpen = item.classList.contains('is-open');
            // Close others
            items.forEach((other) => {
              other.classList.remove('is-open');
              const c = other.querySelector('.tcp-pdp-accordion-content');
              if (c) c.style.maxHeight = null;
            });
            if (!isOpen) {
              item.classList.add('is-open');
              content.style.maxHeight = content.scrollHeight + 'px';
            }
          });
        }
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.tcp-pdp-story-section').forEach(initPdpStoryAccordions);
    });
    document.addEventListener('shopify:section:load', (e) => {
      const sec = e.target.querySelector('.tcp-pdp-story-section');
      if (sec) initPdpStoryAccordions(sec);
    });
  })();
</script>

{% schema %}
{
  "name": "TCP PDP — Story & Details",
  "tag": "section",
  "class": "tcp-pdp-story-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Story Heading",
      "default": "A form shaped by memory."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Story Description",
      "default": "Each piece in the Pushpa collection is handcrafted in small batches. The Sand Form Plate is designed to bring balance to your table—quiet, timeless and made to be used, every day."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial Lifestyle Image"
    },
    {
      "type": "header",
      "content": "Accordion 1"
    },
    {
      "type": "text",
      "id": "acc_1_title",
      "label": "Accordion 1 Title",
      "default": "Product Details"
    },
    {
      "type": "textarea",
      "id": "acc_1_content",
      "label": "Accordion 1 Content",
      "default": "High-fired stoneware (1260–1280°C). Hand-formed organic edges with zero material off-cuts. Durable, chip-resistant and designed for daily hospitality and home rituals."
    },
    {
      "type": "header",
      "content": "Accordion 2"
    },
    {
      "type": "text",
      "id": "acc_2_title",
      "label": "Accordion 2 Title",
      "default": "Care Instructions"
    },
    {
      "type": "textarea",
      "id": "acc_2_content",
      "label": "Accordion 2 Content",
      "default": "100% Dishwasher and microwave safe. Hand-washing with a soft sponge and mild soap will help preserve the matte artisanal glaze for decades."
    },
    {
      "type": "header",
      "content": "Accordion 3"
    },
    {
      "type": "text",
      "id": "acc_3_title",
      "label": "Accordion 3 Title",
      "default": "Shipping & Delivery"
    },
    {
      "type": "textarea",
      "id": "acc_3_content",
      "label": "Accordion 3 Content",
      "default": "Dispatched within 2–3 business days. Delivered in 5–7 working days across India in reinforced eco-cushioned break-safe packaging."
    },
    {
      "type": "header",
      "content": "Accordion 4"
    },
    {
      "type": "text",
      "id": "acc_4_title",
      "label": "Accordion 4 Title",
      "default": "Our Promise"
    },
    {
      "type": "textarea",
      "id": "acc_4_content",
      "label": "Accordion 4 Content",
      "default": "100% Lead-free and food safe. Produced in collaboration with village women artisans as an impact-driven craft practice."
    },
    {
      "type": "header",
      "content": "Layout & Padding"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1200,
      "max": 1600,
      "step": 40,
      "unit": "px",
      "label": "Container Width",
      "default": 1440
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "TCP PDP — Story & Details"
    }
  ]
}
{% endschema %}
