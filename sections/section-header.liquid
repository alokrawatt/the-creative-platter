{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Blended Floating Navbar
  ============================================================
  Seamless transparent navbar overlaid directly on top of the hero,
  matching image reference with clean minimal navigation & cart bag count.
  Copy into Shopify: sections/section-header.liquid
{% endcomment %}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Sacramento&display=swap" rel="stylesheet">

<style>
  /* ── Core Design Tokens ── */
  :root {
    --tcp-sand: #FBF9F5;
    --tcp-stone: #F3EFEA;
    --tcp-gold: #A6732E;
    --tcp-gold-hover: #8C5F22;
    --tcp-gold-light: #DFBA5E;
    --tcp-dark: #1F1D1B;
    --tcp-brown: #352922;
    --tcp-muted: #68625B;
    --tcp-border: #E8E2D8;
    --tcp-white: #FFFFFF;

    --font-serif: 'Cormorant Garamond', Georgia, serif;
    --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-script: 'Sacramento', cursive;
    --font-hand: 'Caveat', cursive;

    --header-height: 90px;
    --ease-fluid: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ── Floating Header Wrapper ── */
  .tcp-header-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    background: transparent;
  }

  /* ── Announcement Bar ── */
  .tcp-announcement {
    background: rgba(35, 31, 28, 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--tcp-sand);
    padding: 8px 24px;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    position: relative;
    z-index: 1002;
    overflow: hidden;
    transition: transform 0.4s var(--ease-fluid), opacity 0.3s ease;
  }

  .tcp-announcement.is-hidden {
    transform: translateY(-100%);
    opacity: 0;
    height: 0;
    padding: 0;
  }

  .tcp-announcement__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    max-width: 1440px;
    margin: 0 auto;
    text-align: center;
  }

  .tcp-announcement__text {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tcp-announcement__badge {
    background: var(--tcp-gold);
    color: #FFFFFF;
    font-size: 9px;
    font-weight: 700;
    padding: 2px 7px;
    letter-spacing: 1px;
    border-radius: 2px;
  }

  .tcp-announcement a {
    color: var(--tcp-gold-light);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tcp-announcement__close {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: rgba(251, 249, 245, 0.7);
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
  }

  /* ── Main Blended Header Bar ── */
  .tcp-header {
    background: transparent;
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
    transition: background 0.35s var(--ease-fluid), box-shadow 0.35s var(--ease-fluid), border-color 0.35s ease;
  }

  .tcp-header.is-scrolled {
    background: rgba(251, 249, 245, 0.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 4px 24px rgba(31, 29, 27, 0.06);
    border-bottom-color: rgba(232, 226, 216, 0.8);
  }

  .tcp-header__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 48px;
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    transition: height 0.3s var(--ease-fluid);
  }

  .tcp-header.is-scrolled .tcp-header__inner {
    height: 74px;
  }

  /* ── Left: Logo Branding ── */
  .tcp-header__left {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .tcp-mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: var(--tcp-dark);
    flex-direction: column;
    gap: 5px;
    width: 32px;
    justify-content: center;
  }

  .tcp-mobile-toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    background-color: currentColor;
    transition: transform 0.3s var(--ease-fluid), opacity 0.3s ease;
  }

  .tcp-header__logo-wrap {
    flex-shrink: 0;
    text-align: left;
    text-decoration: none;
    color: var(--tcp-dark);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
  }

  .tcp-header__logo-the {
    font-family: var(--font-script);
    font-size: 24px;
    line-height: 0.8;
    color: var(--tcp-dark);
    letter-spacing: 0.5px;
  }

  .tcp-header__logo-name {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    line-height: 1.1;
    color: var(--tcp-dark);
  }

  .tcp-header__logo-sub {
    font-family: var(--font-sans);
    font-size: 7.5px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--tcp-dark);
    opacity: 0.85;
    line-height: 1;
    margin-top: 3px;
  }

  /* ── Center: Minimal Navigation Menu ── */
  .tcp-nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .tcp-nav__item {
    position: relative;
  }

  .tcp-nav__link {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--tcp-dark);
    text-decoration: none;
    padding: 8px 6px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    position: relative;
    transition: color 0.2s ease;
  }

  .tcp-nav__link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 6px;
    right: 6px;
    height: 1.5px;
    background: var(--tcp-gold);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s var(--ease-fluid);
  }

  .tcp-nav__link:hover {
    color: var(--tcp-gold);
  }

  .tcp-nav__link:hover::after {
    transform: scaleX(1);
  }

  /* ── Right: Search & Cart Bag ── */
  .tcp-header__right {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-shrink: 0;
  }

  .tcp-header__action-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--tcp-dark);
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .tcp-header__action-btn:hover {
    color: var(--tcp-gold);
    transform: scale(1.05);
  }

  .tcp-header__action-btn svg {
    width: 19px;
    height: 19px;
  }

  .tcp-header__cart-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--tcp-dark);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    padding: 6px;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .tcp-header__cart-link:hover {
    color: var(--tcp-gold);
  }

  .tcp-header__bag-icon {
    width: 19px;
    height: 19px;
  }

  .tcp-cart-text {
    font-size: 12px;
    font-weight: 600;
    color: currentColor;
  }

  /* ── Search Overlay Modal ── */
  .tcp-search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(31, 29, 27, 0.7);
    backdrop-filter: blur(8px);
    z-index: 1100;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s var(--ease-fluid), visibility 0.3s ease;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 100px;
  }

  .tcp-search-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  .tcp-search-box {
    background: var(--tcp-white);
    width: 100%;
    max-width: 680px;
    padding: 32px 40px;
    border-radius: 6px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.25);
    transform: translateY(-20px);
    transition: transform 0.3s var(--ease-fluid);
    position: relative;
    margin: 0 20px;
  }

  .tcp-search-overlay.is-active .tcp-search-box {
    transform: translateY(0);
  }

  .tcp-search-form {
    display: flex;
    align-items: center;
    border-bottom: 2px solid var(--tcp-dark);
    padding-bottom: 8px;
    gap: 12px;
  }

  .tcp-search-input {
    flex: 1;
    border: none;
    outline: none;
    font-family: var(--font-serif);
    font-size: 24px;
    color: var(--tcp-dark);
    background: transparent;
  }

  .tcp-search-close {
    position: absolute;
    top: 16px;
    right: 20px;
    background: none;
    border: none;
    font-size: 28px;
    color: var(--tcp-muted);
    cursor: pointer;
  }

  /* ── Mobile Drawer ── */
  .tcp-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(31, 29, 27, 0.6);
    backdrop-filter: blur(4px);
    z-index: 1050;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .tcp-drawer-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .tcp-mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 85%;
    max-width: 380px;
    background: var(--tcp-sand);
    z-index: 1060;
    transform: translateX(-100%);
    transition: transform 0.35s var(--ease-fluid);
    display: flex;
    flex-direction: column;
    box-shadow: 10px 0 40px rgba(0, 0, 0, 0.15);
  }

  .tcp-mobile-drawer.is-open {
    transform: translateX(0);
  }

  .tcp-mobile-drawer__header {
    padding: 24px;
    border-bottom: 1px solid var(--tcp-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .tcp-mobile-drawer__body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex: 1;
  }

  .tcp-mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .tcp-mobile-nav-link {
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--tcp-dark);
    text-decoration: none;
    display: block;
    font-weight: 600;
    padding: 8px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .tcp-nav {
      display: none;
    }
    .tcp-mobile-toggle {
      display: flex;
    }
    .tcp-header__inner {
      padding: 0 20px;
    }
  }
</style>

<div class="tcp-header-wrapper" id="tcp-header-root">
  <!-- Announcement Bar -->
  {% if section.settings.show_announcement %}
    <div class="tcp-announcement" id="tcp-announcement-bar">
      <div class="tcp-announcement__inner">
        <div class="tcp-announcement__text">
          <span class="tcp-announcement__badge">2025–26</span>
          <span>{{ section.settings.announcement_text | default: 'Introducing Pushpa — The Legacy Dinner Collection. Hand-formed from recycled clay.' }}</span>
          {% if section.settings.announcement_link_text != blank %}
            <a href="{{ section.settings.announcement_link_url | default: '/collections/pushpa' }}">{{ section.settings.announcement_link_text }} &rarr;</a>
          {% endif %}
        </div>
      </div>
      <button class="tcp-announcement__close" id="tcp-announcement-close" aria-label="Close notification">&times;</button>
    </div>
  {% endif %}

  <!-- Main Header Navigation (Blended Overlay) -->
  <header class="tcp-header" id="tcp-main-header">
    <div class="tcp-header__inner">

      <!-- Left: Logo & Mobile Trigger -->
      <div class="tcp-header__left">
        <button class="tcp-mobile-toggle" id="tcp-mobile-open" aria-label="Open navigation menu">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <a href="/" class="tcp-header__logo-wrap" aria-label="The Creative Platter Studio">
          <span class="tcp-header__logo-the">the</span>
          <span class="tcp-header__logo-name">CREATIVE PLATTER</span>
          <span class="tcp-header__logo-sub">BESPOKE TABLEWARE. EXPERIENCES. ADVISORY.</span>
        </a>
      </div>

      <!-- Center Desktop Navigation -->
      <nav class="tcp-nav" aria-label="Main Navigation">
        <div class="tcp-nav__item"><a href="/collections/all" class="tcp-nav__link">SHOP</a></div>
        <div class="tcp-nav__item"><a href="/pages/story" class="tcp-nav__link">STORY</a></div>
        <div class="tcp-nav__item"><a href="/collections/dinner-sets" class="tcp-nav__link">BESPOKE (HOMES)</a></div>
        <div class="tcp-nav__item"><a href="/pages/bespoke-b2b" class="tcp-nav__link">BESPOKE (B2B)</a></div>
        <div class="tcp-nav__item"><a href="/collections/gifting" class="tcp-nav__link">GIFTING</a></div>
        <div class="tcp-nav__item"><a href="/pages/experiences" class="tcp-nav__link">EXPERIENCES</a></div>
        <div class="tcp-nav__item"><a href="/blogs/news" class="tcp-nav__link">JOURNAL</a></div>
      </nav>

      <!-- Right: Search & Cart Bag Count -->
      <div class="tcp-header__right">
        <button class="tcp-header__action-btn" id="tcp-search-trigger" aria-label="Search catalog">
          <svg viewBox="0 0 20 20" fill="none"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.6"/><path d="M12.5 12.5L17 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </button>

        <a href="/cart" class="tcp-header__cart-link" aria-label="Shopping Cart">
          <svg viewBox="0 0 20 20" fill="none" class="tcp-header__bag-icon"><path d="M4 5h12l-1.2 9H5.2L4 5z" stroke="currentColor" stroke-width="1.6"/><path d="M7 5V3.8a3 3 0 016 0V5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <span class="tcp-cart-text">({{ cart.item_count }})</span>
        </a>
      </div>

    </div>
  </header>
</div>

<!-- Search Overlay Modal -->
<div class="tcp-search-overlay" id="tcp-search-modal">
  <div class="tcp-search-box">
    <button class="tcp-search-close" id="tcp-search-close" aria-label="Close search">&times;</button>
    <form class="tcp-search-form" action="/search" method="get">
      <input type="text" name="q" class="tcp-search-input" placeholder="Search Pushpa dinnerware, vases, linen..." autofocus>
      <button type="submit" style="background:none; border:none; cursor:pointer; color:var(--tcp-dark);">
        <svg width="22" height="22" viewBox="0 0 20 20" fill="none"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.8"/><path d="M12.5 12.5L17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </form>
  </div>
</div>

<!-- Mobile Drawer -->
<div class="tcp-drawer-overlay" id="tcp-drawer-overlay"></div>
<div class="tcp-mobile-drawer" id="tcp-mobile-drawer">
  <div class="tcp-mobile-drawer__header">
    <div class="tcp-header__logo-wrap">
      <span class="tcp-header__logo-the">the</span>
      <span class="tcp-header__logo-name" style="font-size: 15px;">CREATIVE PLATTER</span>
    </div>
    <button id="tcp-mobile-close" style="background:none; border:none; font-size: 24px; cursor:pointer;">&times;</button>
  </div>
  <div class="tcp-mobile-drawer__body">
    <ul class="tcp-mobile-nav-list">
      <li><a href="/collections/all" class="tcp-mobile-nav-link">Shop</a></li>
      <li><a href="/pages/story" class="tcp-mobile-nav-link">Story</a></li>
      <li><a href="/collections/dinner-sets" class="tcp-mobile-nav-link">Bespoke (Homes)</a></li>
      <li><a href="/pages/bespoke-b2b" class="tcp-mobile-nav-link">Bespoke (B2B)</a></li>
      <li><a href="/collections/gifting" class="tcp-mobile-nav-link">Gifting</a></li>
      <li><a href="/pages/experiences" class="tcp-mobile-nav-link">Experiences</a></li>
      <li><a href="/blogs/news" class="tcp-mobile-nav-link">Journal</a></li>
    </ul>
  </div>
</div>

<script>
  (function() {
    // Header Scroll Glass Background
    const header = document.getElementById('tcp-main-header');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 25) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    }, { passive: true });

    // Announcement Close
    const annBar = document.getElementById('tcp-announcement-bar');
    const annClose = document.getElementById('tcp-announcement-close');
    if (annClose && annBar) {
      annClose.addEventListener('click', () => {
        annBar.classList.add('is-hidden');
      });
    }

    // Search Modal
    const searchTrigger = document.getElementById('tcp-search-trigger');
    const searchModal = document.getElementById('tcp-search-modal');
    const searchClose = document.getElementById('tcp-search-close');
    if (searchTrigger && searchModal && searchClose) {
      searchTrigger.addEventListener('click', () => searchModal.classList.add('is-active'));
      searchClose.addEventListener('click', () => searchModal.classList.remove('is-active'));
      searchModal.addEventListener('click', (e) => {
        if (e.target === searchModal) searchModal.classList.remove('is-active');
      });
    }

    // Mobile Drawer
    const mobileOpen = document.getElementById('tcp-mobile-open');
    const mobileClose = document.getElementById('tcp-mobile-close');
    const mobileDrawer = document.getElementById('tcp-mobile-drawer');
    const drawerOverlay = document.getElementById('tcp-drawer-overlay');

    function toggleDrawer(open) {
      if (open) {
        mobileDrawer.classList.add('is-open');
        drawerOverlay.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      } else {
        mobileDrawer.classList.remove('is-open');
        drawerOverlay.classList.remove('is-open');
        document.body.style.overflow = '';
      }
    }

    if (mobileOpen) mobileOpen.addEventListener('click', () => toggleDrawer(true));
    if (mobileClose) mobileClose.addEventListener('click', () => toggleDrawer(false));
    if (drawerOverlay) drawerOverlay.addEventListener('click', () => toggleDrawer(false));
  })();
</script>

{% schema %}
{
  "name": "TCP Global Header",
  "tag": "section",
  "class": "tcp-header-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": false
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Introducing Pushpa — The Legacy Dinner Collection 2025–26. Mould-free & crafted from recycled clay."
    },
    {
      "type": "text",
      "id": "announcement_link_text",
      "label": "Announcement link text",
      "default": "Explore The Collection"
    },
    {
      "type": "url",
      "id": "announcement_link_url",
      "label": "Announcement link URL"
    }
  ]
}
{% endschema %}
