{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Global Header & Fluid Navigation
  ============================================================
  Inspired by Nicobar (D2C Lifestyle & Editorial Storytelling)
  and Kevala Ceramics (B2B Luxury Hospitality & Architectural Studio).
  Features:
  - Dual-Mode Switcher: [ Shop Collection (D2C) | Hospitality & Bespoke (B2B) ]
  - Sticky glassmorphic bar with fluid scroll blur
  - Rich Mega Menus with featured Pushpa Legacy highlights
  - Announcement Marquee with dismissible alerts
  - Quick Search drawer & Cart slide-out trigger
  - Fluid mobile navigation drawer
  Copy into Shopify: sections/section-header.liquid
{% endcomment %}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Sacramento&family=Noto+Serif+Devanagari:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  /* ── Core Design Tokens (Global) ── */
  :root {
    --tcp-sand: #FBF9F5;
    --tcp-stone: #F3EFEA;
    --tcp-beige: #F5F0E8;
    --tcp-warm-card: #FAF7F2;
    --tcp-gold: #C29B38;
    --tcp-gold-hover: #A8822B;
    --tcp-gold-light: #DFBA5E;
    --tcp-gold-glow: rgba(194, 155, 56, 0.16);
    --tcp-dark: #1F1D1B;
    --tcp-brown: #352922;
    --tcp-brown-light: #52443A;
    --tcp-muted: #68625B;
    --tcp-muted-light: #9B948C;
    --tcp-border: #E8E2D8;
    --tcp-border-dark: #C9BFB0;
    --tcp-white: #FFFFFF;
    --tcp-terracotta: #9E6747;
    --tcp-overlay: rgba(31, 29, 27, 0.6);

    --font-serif: 'Cormorant Garamond', Georgia, serif;
    --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-script: 'Sacramento', cursive;
    --font-devanagari: 'Noto Serif Devanagari', serif;

    --header-height: 80px;
    --announcement-height: 38px;
    --ease-fluid: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-snappy: cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  /* ── Reset & Baseline ── */
  .tcp-header-wrapper {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }

  /* ── Announcement Marquee ── */
  .tcp-announcement {
    background: var(--tcp-brown);
    color: var(--tcp-sand);
    padding: 9px 24px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    position: relative;
    z-index: 1002;
    overflow: hidden;
    transition: transform 0.4s var(--ease-fluid), opacity 0.3s ease;
  }

  .tcp-announcement.is-hidden {
    transform: translateY(-100%);
    opacity: 0;
    height: 0;
    padding: 0;
  }

  .tcp-announcement__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    max-width: 1440px;
    margin: 0 auto;
    text-align: center;
  }

  .tcp-announcement__text {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tcp-announcement__badge {
    background: var(--tcp-gold);
    color: var(--tcp-dark);
    font-size: 9px;
    font-weight: 700;
    padding: 2px 7px;
    letter-spacing: 1px;
    border-radius: 2px;
  }

  .tcp-announcement a {
    color: var(--tcp-gold-light);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .tcp-announcement a:hover {
    color: #FFF;
  }

  .tcp-announcement__close {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: rgba(251, 249, 245, 0.7);
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    transition: color 0.2s;
  }

  .tcp-announcement__close:hover {
    color: #FFF;
  }

  /* ── Header Bar ── */
  .tcp-header {
    background: rgba(251, 249, 245, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--tcp-border);
    transition: background 0.3s var(--ease-fluid), box-shadow 0.3s var(--ease-fluid), padding 0.3s var(--ease-fluid);
  }

  .tcp-header.is-scrolled {
    background: rgba(251, 249, 245, 0.98);
    box-shadow: 0 4px 24px rgba(31, 29, 27, 0.06);
    border-bottom-color: rgba(232, 226, 216, 0.8);
  }

  .tcp-header__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    transition: height 0.3s var(--ease-fluid);
  }

  .tcp-header.is-scrolled .tcp-header__inner {
    height: 70px;
  }

  /* ── Left: Logo & Mobile Trigger ── */
  .tcp-header__left {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .tcp-mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: var(--tcp-dark);
    flex-direction: column;
    gap: 5px;
    width: 32px;
    justify-content: center;
  }

  .tcp-mobile-toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    background-color: currentColor;
    transition: transform 0.3s var(--ease-fluid), opacity 0.3s ease;
  }

  /* ── Left-Aligned Logo Branding ── */
  .tcp-header__logo-wrap {
    flex-shrink: 0;
    text-align: left;
    text-decoration: none;
    color: var(--tcp-dark);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .tcp-header__logo-the {
    font-family: var(--font-script);
    font-size: 20px;
    line-height: 0.8;
    color: var(--tcp-gold);
    letter-spacing: 1px;
  }

  .tcp-header__logo-name {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 3.5px;
    text-transform: uppercase;
    line-height: 1;
    color: var(--tcp-dark);
  }

  .tcp-header__logo-sub {
    font-family: var(--font-sans);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--tcp-muted);
    line-height: 1;
    margin-top: 2px;
  }

  /* ── Navigation Menu (Desktop) ── */
  .tcp-nav {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .tcp-nav__item {
    position: relative;
  }

  .tcp-nav__link {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--tcp-dark);
    text-decoration: none;
    padding: 10px 14px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    position: relative;
    transition: color 0.2s ease;
  }

  .tcp-nav__link::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 14px;
    right: 14px;
    height: 1.5px;
    background: var(--tcp-gold);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s var(--ease-fluid);
  }

  .tcp-nav__link:hover,
  .tcp-nav__item.is-active .tcp-nav__link {
    color: var(--tcp-brown);
  }

  .tcp-nav__link:hover::after,
  .tcp-nav__item.is-active .tcp-nav__link::after {
    transform: scaleX(1);
  }

  .tcp-nav__badge-pushpa {
    background: linear-gradient(135deg, #DFBA5E 0%, #C29B38 100%);
    color: #FFF;
    font-size: 8.5px;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 10px;
    letter-spacing: 0.5px;
    margin-left: 2px;
  }

  .tcp-nav__chevron {
    width: 8px;
    height: 8px;
    transition: transform 0.3s var(--ease-fluid);
  }

  .tcp-nav__item:hover .tcp-nav__chevron {
    transform: rotate(180deg);
  }

  /* ── Rich Mega Menu ── */
  .tcp-mega-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(12px);
    width: 920px;
    background: var(--tcp-white);
    border: 1px solid var(--tcp-border);
    box-shadow: 0 20px 48px rgba(31, 29, 27, 0.12);
    border-radius: 4px;
    padding: 32px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s var(--ease-fluid), transform 0.3s var(--ease-fluid), visibility 0.3s ease;
    z-index: 1050;
  }

  .tcp-nav__item:hover .tcp-mega-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .tcp-mega-menu__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1.4fr;
    gap: 28px;
  }

  .tcp-mega-col__title {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--tcp-gold);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tcp-mega-col__title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--tcp-border);
  }

  .tcp-mega-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tcp-mega-list a {
    font-size: 13px;
    color: var(--tcp-muted);
    text-decoration: none;
    display: flex;
    align-items: baseline;
    gap: 6px;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .tcp-mega-list a:hover {
    color: var(--tcp-dark);
    transform: translateX(3px);
  }

  .tcp-mega-list a .hindi-tag {
    font-family: var(--font-devanagari);
    font-size: 11px;
    color: var(--tcp-gold);
    font-weight: 500;
  }

  /* ── Mega Menu Featured Banner ── */
  .tcp-mega-featured {
    background: var(--tcp-stone);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 200px;
    border: 1px solid var(--tcp-border);
    text-decoration: none;
    color: var(--tcp-dark);
    transition: transform 0.3s ease;
  }

  .tcp-mega-featured:hover {
    transform: translateY(-2px);
  }

  .tcp-mega-featured__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: var(--tcp-brown);
    color: var(--tcp-sand);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 2px;
  }

  .tcp-mega-featured__title {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    color: var(--tcp-dark);
    line-height: 1.2;
    margin-bottom: 4px;
  }

  .tcp-mega-featured__sub {
    font-size: 11.5px;
    color: var(--tcp-muted);
    line-height: 1.4;
  }

  .tcp-mega-featured__link {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--tcp-gold-hover);
    margin-top: 10px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* ── Right: Utility Actions (Search, Trade RFQ, Cart) ── */
  .tcp-header__right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    flex: 1;
  }

  .tcp-header__action-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--tcp-dark);
    padding: 8px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s ease;
    position: relative;
  }

  .tcp-header__action-btn:hover {
    color: var(--tcp-gold-hover);
  }

  .tcp-header__action-btn svg {
    width: 18px;
    height: 18px;
  }

  .tcp-header__trade-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    padding: 8px 14px;
    border: 1px solid var(--tcp-dark);
    color: var(--tcp-dark);
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.25s var(--ease-fluid);
  }

  .tcp-header__trade-cta:hover {
    background: var(--tcp-dark);
    color: var(--tcp-sand);
    border-color: var(--tcp-dark);
  }

  .tcp-cart-count {
    position: absolute;
    top: 2px;
    right: 2px;
    background: var(--tcp-gold);
    color: #FFF;
    font-size: 9px;
    font-weight: 700;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  /* ── Fluid Search Overlay Drawer ── */
  .tcp-search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(31, 29, 27, 0.7);
    backdrop-filter: blur(8px);
    z-index: 1100;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s var(--ease-fluid), visibility 0.3s ease;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 100px;
  }

  .tcp-search-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  .tcp-search-box {
    background: var(--tcp-white);
    width: 100%;
    max-width: 680px;
    padding: 32px 40px;
    border-radius: 6px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.25);
    transform: translateY(-20px);
    transition: transform 0.3s var(--ease-fluid);
    position: relative;
    margin: 0 20px;
  }

  .tcp-search-overlay.is-active .tcp-search-box {
    transform: translateY(0);
  }

  .tcp-search-form {
    display: flex;
    align-items: center;
    border-bottom: 2px solid var(--tcp-dark);
    padding-bottom: 8px;
    gap: 12px;
  }

  .tcp-search-input {
    flex: 1;
    border: none;
    outline: none;
    font-family: var(--font-serif);
    font-size: 24px;
    color: var(--tcp-dark);
    background: transparent;
  }

  .tcp-search-input::placeholder {
    color: var(--tcp-muted-light);
    font-style: italic;
  }

  .tcp-search-tags {
    margin-top: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tcp-search-tags span {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--tcp-muted);
  }

  .tcp-search-tag {
    font-size: 12px;
    color: var(--tcp-brown);
    background: var(--tcp-stone);
    padding: 4px 10px;
    border-radius: 20px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .tcp-search-tag:hover {
    background: var(--tcp-border);
  }

  .tcp-search-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: var(--tcp-muted);
    font-size: 20px;
  }

  /* ── Fluid Mobile Navigation Drawer ── */
  .tcp-mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 320px;
    max-width: 85vw;
    background: var(--tcp-sand);
    box-shadow: 10px 0 40px rgba(0, 0, 0, 0.15);
    z-index: 1200;
    transform: translateX(-100%);
    transition: transform 0.4s var(--ease-fluid);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .tcp-mobile-drawer.is-open {
    transform: translateX(0);
  }

  .tcp-drawer-overlay {
    position: fixed;
    inset: 0;
    background: var(--tcp-overlay);
    backdrop-filter: blur(4px);
    z-index: 1150;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .tcp-drawer-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .tcp-mobile-drawer__header {
    padding: 24px;
    border-bottom: 1px solid var(--tcp-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .tcp-mobile-drawer__body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex: 1;
  }

  .tcp-mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .tcp-mobile-nav-link {
    font-family: var(--font-serif);
    font-size: 22px;
    color: var(--tcp-dark);
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 500;
  }

  .tcp-mobile-nav-sublist {
    list-style: none;
    padding: 8px 0 0 16px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tcp-mobile-nav-sublist a {
    font-size: 13px;
    color: var(--tcp-muted);
    text-decoration: none;
  }

  /* ── Responsive Breakpoints ── */
  @media (max-width: 1180px) {
    .tcp-nav {
      display: none;
    }
    .tcp-mobile-toggle {
      display: flex;
    }
    .tcp-header__left {
      flex: 0 0 auto;
    }
    .tcp-header__right {
      flex: 1;
    }
  }

  @media (max-width: 768px) {
    .tcp-header__inner {
      padding: 0 20px;
    }
    .tcp-mode-switcher {
      display: none;
    }
    .tcp-header__trade-cta {
      display: none;
    }
  }
</style>

<div class="tcp-header-wrapper" id="tcp-header-root">
  <!-- Announcement Bar -->
  {% if section.settings.show_announcement %}
    <div class="tcp-announcement" id="tcp-announcement-bar">
      <div class="tcp-announcement__inner">
        <div class="tcp-announcement__text">
          <span class="tcp-announcement__badge">2025–26</span>
          <span>{{ section.settings.announcement_text | default: 'Introducing Pushpa — The Legacy Dinner Collection. Hand-formed from recycled clay.' }}</span>
          {% if section.settings.announcement_link_text != blank %}
            <a href="{{ section.settings.announcement_link_url | default: '/collections/pushpa' }}">{{ section.settings.announcement_link_text }} &rarr;</a>
          {% endif %}
        </div>
      </div>
      <button class="tcp-announcement__close" id="tcp-announcement-close" aria-label="Close notification">&times;</button>
    </div>
  {% endif %}

  <!-- Main Header Navigation -->
  <header class="tcp-header" id="tcp-main-header">
    <div class="tcp-header__inner">

      <!-- Left: Logo & Mobile Trigger -->
      <div class="tcp-header__left">
        <button class="tcp-mobile-toggle" id="tcp-mobile-open" aria-label="Open navigation menu">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <a href="/" class="tcp-header__logo-wrap" aria-label="The Creative Platter Studio">
          <span class="tcp-header__logo-the">the</span>
          <span class="tcp-header__logo-name">CREATIVE PLATTER</span>
          <span class="tcp-header__logo-sub">STUDIO • HOSPITALITY • BESPOKE</span>
        </a>
      </div>

      <!-- Center Desktop Navigation -->
      <nav class="tcp-nav" aria-label="Main Navigation">
        <!-- Item 1: Pushpa Legacy Collection (Mega Menu) -->
        <div class="tcp-nav__item">
          <a href="/collections/pushpa" class="tcp-nav__link">
            Pushpa Legacy <span class="tcp-nav__badge-pushpa">New</span>
            <svg class="tcp-nav__chevron" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          </a>
          <div class="tcp-mega-menu">
            <div class="tcp-mega-menu__grid">
              <div class="tcp-mega-col">
                <span class="tcp-mega-col__title">The 7 Expressions</span>
                <ul class="tcp-mega-list">
                  <li><a href="/products/smriti-dinner-set"><strong>Smriti</strong> <span class="hindi-tag">(स्मृति)</span> — Memory &amp; Remembrance</a></li>
                  <li><a href="/products/shakti-dinner-set"><strong>Shakti</strong> <span class="hindi-tag">(शक्ति)</span> — Quiet Strength</a></li>
                  <li><a href="/products/shringaar-dinner-set"><strong>Shringaar</strong> <span class="hindi-tag">(शृंगार)</span> — Adornment &amp; Grace</a></li>
                  <li><a href="/products/sneha-dinner-set"><strong>Sneha</strong> <span class="hindi-tag">(स्नेह)</span> — Affection &amp; Warmth</a></li>
