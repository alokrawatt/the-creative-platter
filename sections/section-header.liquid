<script>
  (function() {
    // Header Scroll Shadow
    const header = document.getElementById('tcp-main-header');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 30) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    }, { passive: true });

    // Announcement Close
    const annBar = document.getElementById('tcp-announcement-bar');
    const annClose = document.getElementById('tcp-announcement-close');
    if (annClose && annBar) {
      annClose.addEventListener('click', () => {
        annBar.classList.add('is-hidden');
      });
    }

    // Search Modal
    const searchTrigger = document.getElementById('tcp-search-trigger');
    const searchModal = document.getElementById('tcp-search-modal');
    const searchClose = document.getElementById('tcp-search-close');
    if (searchTrigger && searchModal && searchClose) {
      searchTrigger.addEventListener('click', () => searchModal.classList.add('is-active'));
      searchClose.addEventListener('click', () => searchModal.classList.remove('is-active'));
      searchModal.addEventListener('click', (e) => {
        if (e.target === searchModal) searchModal.classList.remove('is-active');
      });
    }

    // Mobile Drawer
    const mobileOpen = document.getElementById('tcp-mobile-open');
    const mobileClose = document.getElementById('tcp-mobile-close');
    const mobileDrawer = document.getElementById('tcp-mobile-drawer');
    const drawerOverlay = document.getElementById('tcp-drawer-overlay');

    function toggleDrawer(open) {
      if (open) {
        mobileDrawer.classList.add('is-open');
        drawerOverlay.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      } else {
        mobileDrawer.classList.remove('is-open');
        drawerOverlay.classList.remove('is-open');
        document.body.style.overflow = '';
      }
    }

    if (mobileOpen) mobileOpen.addEventListener('click', () => toggleDrawer(true));
    if (mobileClose) mobileClose.addEventListener('click', () => toggleDrawer(false));
    if (drawerOverlay) drawerOverlay.addEventListener('click', () => toggleDrawer(false));
  })();
</script>

