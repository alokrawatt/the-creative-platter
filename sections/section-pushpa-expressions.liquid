  </div>

  <!-- 1. Smriti -->
  <div class="tcp-pushpa-item">
    <div class="tcp-pushpa-item__media">
      <span class="tcp-pushpa-item__badge-gold">Flagship Legacy Set</span>
      {% if section.settings.smriti_img != blank %}
        <img class="tcp-pushpa-item__img" src="{{ section.settings.smriti_img | image_url: width: 900 }}" alt="Smriti Dinner Set" loading="lazy">
      {% else %}
        <img class="tcp-pushpa-item__img" src="https://images.unsplash.com/photo-1578749556568-bc2c40e68b61?q=80&w=900&auto=format&fit=crop" alt="Smriti Dinner Set" loading="lazy">
      {% endif %}
    </div>
    <div class="tcp-pushpa-item__content">
      <div class="tcp-pushpa-item__head-group">
        <h3 class="tcp-pushpa-item__name">{{ section.settings.smriti_name | default: 'Smriti' }}</h3>
        <span class="tcp-pushpa-item__hindi">(स्मृति)</span>
      </div>
      <p class="tcp-pushpa-item__tagline">&ldquo;{{ section.settings.smriti_tagline | default: 'Memory & Remembrance' }}&rdquo;</p>
      <p class="tcp-pushpa-item__desc">
        {{ section.settings.smriti_desc | default: "Symbolizes cherished memories and the everlasting presence of mother's teachings, even in her absence. Mould-free recycled clay, raw contour edges, and 24k gold leaf brushwork." }}
      </p>
      <div class="tcp-pushpa-item__specs-pill">
        <span class="tcp-pushpa-spec-tag">Charger Plate 11.5"</span>
        <span class="tcp-pushpa-spec-tag">Dinner Plate 10"</span>
        <span class="tcp-pushpa-spec-tag">Katori Bowl 4.5"</span>
        <span class="tcp-pushpa-spec-tag">24k Gold Rim</span>
      </div>
      <a href="{{ section.settings.smriti_url | default: '/products/smriti-dinner-set' }}" class="tcp-pushpa-item__btn">Order Smriti Set &rarr;</a>
    </div>
  </div>

  <!-- 2. Shakti -->
