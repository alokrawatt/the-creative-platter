    { "type": "textarea", "id": "smriti_desc", "label": "Smriti Description" },
    { "type": "url", "id": "smriti_url", "label": "Smriti Product URL" },

    { "type": "header", "content": "2. Shakti" },
    { "type": "image_picker", "id": "shakti_img", "label": "Shakti Image" },
    { "type": "text", "id": "shakti_name", "label": "Shakti Name", "default": "Shakti" },
    { "type": "text", "id": "shakti_tagline", "label": "Shakti Tagline", "default": "Quiet Strength" },
    { "type": "textarea", "id": "shakti_desc", "label": "Shakti Description" },
    { "type": "url", "id": "shakti_url", "label": "Shakti Product URL" },

    { "type": "header", "content": "3. Shringaar" },
    { "type": "image_picker", "id": "shringaar_img", "label": "Shringaar Image" },
    { "type": "text", "id": "shringaar_name", "label": "Shringaar Name", "default": "Shringaar" },
    { "type": "text", "id": "shringaar_tagline", "label": "Shringaar Tagline", "default": "Adornment & Grace" },
    { "type": "textarea", "id": "shringaar_desc", "label": "Shringaar Description" },
    { "type": "url", "id": "shringaar_url", "label": "Shringaar Product URL" },

    { "type": "header", "content": "4. Sneha" },
    { "type": "image_picker", "id": "sneha_img", "label": "Sneha Image" },
    { "type": "text", "id": "sneha_name", "label": "Sneha Name", "default": "Sneha" },
    { "type": "text", "id": "sneha_tagline", "label": "Sneha Tagline", "default": "Affection & Warmth" },
    { "type": "textarea", "id": "sneha_desc", "label": "Sneha Description" },
    { "type": "url", "id": "sneha_url", "label": "Sneha Product URL" },

    { "type": "header", "content": "5. Sammaan" },
    { "type": "image_picker", "id": "sammaan_img", "label": "Sammaan Image" },
    { "type": "text", "id": "sammaan_name", "label": "Sammaan Name", "default": "Sammaan" },
    { "type": "text", "id": "sammaan_tagline", "label": "Sammaan Tagline", "default": "Honor & Legacy" },
    { "type": "textarea", "id": "sammaan_desc", "label": "Sammaan Description" },
    { "type": "url", "id": "sammaan_url", "label": "Sammaan Product URL" },

    { "type": "header", "content": "6. Aaradhya" },
    { "type": "image_picker", "id": "aaradhya_img", "label": "Aaradhya Image" },
    { "type": "text", "id": "aaradhya_name", "label": "Aaradhya Name", "default": "Aaradhya" },
    { "type": "text", "id": "aaradhya_tagline", "label": "Aaradhya Tagline", "default": "Devotion & Ritual" },
    { "type": "textarea", "id": "aaradhya_desc", "label": "Aaradhya Description" },
    { "type": "url", "id": "aaradhya_url", "label": "Aaradhya Product URL" },

    { "type": "header", "content": "7. Karuna" },
    { "type": "image_picker", "id": "karuna_img", "label": "Karuna Image" },
    { "type": "text", "id": "karuna_name", "label": "Karuna Name", "default": "Karuna" },
    { "type": "text", "id": "karuna_tagline", "label": "Karuna Tagline", "default": "Compassion & Care" },
    { "type": "textarea", "id": "karuna_desc", "label": "Karuna Description" },
    { "type": "url", "id": "karuna_url", "label": "Karuna Product URL" }
  ],
  "presets": [
    {
      "name": "Pushpa — 7 Expressions"
    }
