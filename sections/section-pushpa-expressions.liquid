{% schema %}
{
  "name": "Pushpa — 7 Expressions",
  "tag": "section",
  "class": "tcp-pushpa-expressions-section",
  "settings": [
    {
      "type": "text",
      "id": "expressions_pill",
      "label": "Eyebrow Pill",
      "default": "THE SEVEN EXPRESSIONS"
    },
    {
      "type": "text",
      "id": "expressions_title",
      "label": "Section Title",
      "default": "Seven Expressions of Legacy"
    },
    { "type": "header", "content": "1. Smriti" },
    { "type": "image_picker", "id": "smriti_img", "label": "Smriti Image" },
