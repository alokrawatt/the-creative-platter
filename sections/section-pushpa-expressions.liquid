<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Raleway:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet">

<style>
  .tcp-pushpa-expressions {
    padding: 90px 0;
    max-width: 1400px;
    margin: 0 auto;
    padding-left: 40px;
    padding-right: 40px;
  }

  @media (max-width: 768px) {
    .tcp-pushpa-expressions {
      padding: 60px 20px;
    }
  }

  .tcp-pushpa-expressions__header {
    text-align: center;
    margin-bottom: 64px;
  }

  .tcp-pushpa-expressions__pill {
    display: inline-block;
    font-family: var(--font-brand, 'Raleway', sans-serif);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #A6732E;
    margin-bottom: 12px;
  }

  .tcp-pushpa-expressions__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(34px, 4.5vw, 48px);
    font-weight: 400;
    color: #2D2A27;
    margin: 0 0 12px;
    letter-spacing: -0.3px;
  }

  .tcp-pushpa-item {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    background: #FFFFFF;
    border: 1px solid #ECE7DF;
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 48px;
    box-shadow: 0 4px 18px rgba(45, 42, 39, 0.04);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }

  .tcp-pushpa-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(45, 42, 39, 0.08);
  }

  .tcp-pushpa-item:nth-child(even) .tcp-pushpa-item__media {
    order: 2;
  }

  .tcp-pushpa-item:nth-child(even) .tcp-pushpa-item__content {
    order: 1;
  }

  .tcp-pushpa-item__media {
    position: relative;
    aspect-ratio: 4 / 3.4;
    background: #F6F3EE;
    overflow: hidden;
  }

  .tcp-pushpa-item__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tcp-pushpa-item:hover .tcp-pushpa-item__img {
    transform: scale(1.04);
  }

  .tcp-pushpa-item__badge-gold {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(31, 29, 27, 0.88);
    backdrop-filter: blur(8px);
    color: #fcce3a;
    font-family: var(--font-brand, 'Raleway', sans-serif);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 2px;
    z-index: 2;
  }

  .tcp-pushpa-item__content {
    padding: 48px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  @media (max-width: 1024px) {
    .tcp-pushpa-item {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .tcp-pushpa-item:nth-child(even) .tcp-pushpa-item__media {
      order: 1;
    }
    .tcp-pushpa-item:nth-child(even) .tcp-pushpa-item__content {
      order: 2;
    }
    .tcp-pushpa-item__content {
      padding: 32px 24px;
    }
  }

  .tcp-pushpa-item__head-group {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 6px;
  }

  .tcp-pushpa-item__name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 34px;
    font-weight: 500;
    color: #2D2A27;
    line-height: 1;
    letter-spacing: -0.2px;
  }

  .tcp-pushpa-item__hindi {
    font-size: 20px;
    color: #A6732E;
    font-weight: 500;
  }

  .tcp-pushpa-item__tagline {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 18px;
    font-style: italic;
    color: #8E8981;
    margin-bottom: 18px;
  }

  .tcp-pushpa-item__desc {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 14px;
    color: #5C5650;
    line-height: 1.75;
    margin-bottom: 24px;
  }

  .tcp-pushpa-item__specs-pill {
    display: flex;
    gap: 10px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .tcp-pushpa-spec-tag {
    background: #FAF8F5;
    border: 1px solid #ECE7DF;
    padding: 5px 12px;
    border-radius: 20px;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 10.5px;
    font-weight: 600;
    color: #545454;
  }

  .tcp-pushpa-item__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #FFFFFF;
    background: #2D2A27;
    padding: 13px 26px;
    text-decoration: none;
    border-radius: 2px;
    box-shadow: 0 4px 12px rgba(45, 42, 39, 0.15);
    transition: all 0.3s ease;
  }

  .tcp-pushpa-item__btn:hover {
    background: #A6732E;
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(166, 115, 46, 0.35);
  }
</style>

<section class="tcp-pushpa-expressions" id="expressions">
  <div class="tcp-pushpa-expressions__header">
    <span class="tcp-pushpa-expressions__pill">{{ section.settings.expressions_pill | default: 'THE SEVEN EXPRESSIONS' }}</span>
