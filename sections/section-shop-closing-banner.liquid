{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Shop Closing Statement Banner
  ============================================================
{% endcomment %}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Raleway:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Sacramento&display=swap" rel="stylesheet">

<style>
  .tcp-closing-banner {
    background: radial-gradient(circle at 85% 50%, rgba(252, 206, 58, 0.12) 0%, transparent 55%),
                radial-gradient(circle at 15% 50%, rgba(166, 115, 46, 0.08) 0%, transparent 50%),
                #181614;
    color: #FFFFFF;
    padding: 70px 40px;
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(252, 206, 58, 0.25);
    border-bottom: 1px solid rgba(252, 206, 58, 0.25);
  }

  .tcp-closing-banner__inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    position: relative;
    z-index: 2;
  }

  @media (max-width: 900px) {
    .tcp-closing-banner {
      padding: 50px 20px;
    }
    .tcp-closing-banner__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
    }
  }

  .tcp-closing-banner__content {
    max-width: 700px;
  }

  .tcp-closing-banner__pill {
    display: inline-block;
    font-family: var(--font-brand, 'Raleway', sans-serif);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #fcce3a;
    margin-bottom: 10px;
  }

  .tcp-closing-banner__text {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 400;
    line-height: 1.1;
    color: #FFFFFF;
    margin: 0 0 10px;
    letter-spacing: -0.5px;
  }

  .tcp-closing-banner__text span.dot {
    color: #fcce3a;
  }

  .tcp-closing-banner__desc {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 13.5px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
    line-height: 1.6;
  }

  .tcp-closing-banner__actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .tcp-closing-banner__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #fcce3a;
    color: #1A1815;
    padding: 15px 34px;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(252, 206, 58, 0.35);
    border-radius: 2px;
    white-space: nowrap;
  }

  .tcp-closing-banner__btn:hover {
    background: #e5b92e;
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(252, 206, 58, 0.5);
  }

  .tcp-closing-banner__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .tcp-closing-banner__link:hover {
    color: #fcce3a;
  }
</style>

<section class="tcp-closing-banner" id="tcp-closing-banner-root">
  <div class="tcp-closing-banner__inner">
    <div class="tcp-closing-banner__content">
      <span class="tcp-closing-banner__pill">{{ section.settings.closing_pill | default: 'THE PUSHPA LEGACY 2025–26' }}</span>
      <h2 class="tcp-closing-banner__text">
        {{ section.settings.closing_title | default: 'Bring Pushpa to your table' }}<span class="dot">.</span>
      </h2>
      <p class="tcp-closing-banner__desc">
        {{ section.settings.closing_desc | default: 'Hand-formed, twice-fired stoneware crafted with patience and memory.' }}
      </p>
    </div>

    <div class="tcp-closing-banner__actions">
      {% if section.settings.closing_btn_text != blank %}
        <a href="{{ section.settings.closing_btn_url | default: '/collections/all' }}" class="tcp-closing-banner__btn">
          {{ section.settings.closing_btn_text }} &rarr;
        </a>
      {% endif %}
      {% if section.settings.closing_link_text != blank %}
        <a href="{{ section.settings.closing_link_url | default: '/pages/bespoke-b2b' }}" class="tcp-closing-banner__link">
          {{ section.settings.closing_link_text }} &rarr;
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop — Closing Banner",
  "tag": "section",
  "class": "tcp-shop-closing-banner-section",
  "settings": [
    {
      "type": "text",
      "id": "closing_pill",
      "label": "Eyebrow Pill",
      "default": "THE PUSHPA LEGACY 2025–26"
    },
    {
      "type": "text",
      "id": "closing_title",
      "label": "Heading",
      "default": "Bring Pushpa to your table"
    },
    {
      "type": "text",
      "id": "closing_desc",
      "label": "Subtitle Description",
      "default": "Hand-formed, twice-fired stoneware crafted with patience and memory."
    },
    {
      "type": "text",
      "id": "closing_btn_text",
      "label": "Button Text",
      "default": "SHOP THE COLLECTION"
    },
    {
      "type": "url",
      "id": "closing_btn_url",
      "label": "Button URL"
    },
    {
      "type": "text",
      "id": "closing_link_text",
      "label": "Secondary Link Text",
      "default": "BESPOKE INQUIRIES"
    },
    {
      "type": "url",
      "id": "closing_link_url",
      "label": "Secondary Link URL"
    }
  ],
  "presets": [
    {
      "name": "Shop — Closing Banner"
    }
  ]
}
{% endschema %}
