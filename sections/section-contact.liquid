{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Contact & Studio Visit
  ============================================================
  Connect with founder Amankshii Rawatt & the Gurugram studio.
  Copy into Shopify: sections/section-contact.liquid
{% endcomment %}

<style>
  .tcp-contact {
    background-color: var(--tcp-sand, #FBF9F5);
    padding: 80px 0 100px;
    font-family: var(--font-sans, sans-serif);
    color: var(--tcp-dark, #1F1D1B);
  }

  .tcp-contact__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 80px;
    align-items: start;
  }

  .tcp-contact__label {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--tcp-gold, #C29B38);
    display: block;
    margin-bottom: 12px;
  }

  .tcp-contact__heading {
    font-family: var(--font-serif, serif);
    font-size: clamp(36px, 4.5vw, 54px);
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 16px;
  }

  .tcp-contact__subtitle {
    font-size: 15px;
    color: var(--tcp-muted, #68625B);
    line-height: 1.75;
    margin-bottom: 40px;
    max-width: 440px;
  }

  .tcp-contact__cards {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .tcp-contact-card {
    background: var(--tcp-white, #FFFFFF);
    border: 1px solid var(--tcp-border, #E8E2D8);
    border-radius: 4px;
    padding: 24px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .tcp-contact-card__icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--tcp-stone, #F3EFEA);
    color: var(--tcp-gold, #C29B38);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .tcp-contact-card__icon svg {
    width: 18px;
    height: 18px;
  }

  .tcp-contact-card__title {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--tcp-brown, #352922);
    margin: 0 0 4px;
  }

  .tcp-contact-card__text {
    font-size: 14px;
    color: var(--tcp-muted, #68625B);
    margin: 0;
    line-height: 1.5;
  }

  .tcp-contact-card__text a {
    color: var(--tcp-dark, #1F1D1B);
    text-decoration: none;
    font-weight: 600;
  }

  .tcp-contact-card__text a:hover {
    color: var(--tcp-gold, #C29B38);
  }

  /* ── Right: Form ── */
  .tcp-contact__form-box {
    background: var(--tcp-white, #FFFFFF);
    border: 1px solid var(--tcp-border, #E8E2D8);
    border-radius: 6px;
    padding: 48px;
    box-shadow: 0 16px 40px rgba(31, 29, 27, 0.05);
  }

  .tcp-contact__form-title {
    font-family: var(--font-serif, serif);
    font-size: 28px;
    font-weight: 600;
    margin: 0 0 8px;
  }

  .tcp-contact__form-sub {
    font-size: 13.5px;
    color: var(--tcp-muted, #68625B);
    margin-bottom: 28px;
  }

  .tcp-contact__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .tcp-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .tcp-form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tcp-form-field label {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--tcp-brown, #352922);
  }

  .tcp-form-field input,
  .tcp-form-field select,
  .tcp-form-field textarea {
    background: var(--tcp-sand, #FBF9F5);
    border: 1px solid var(--tcp-border, #E8E2D8);
    border-radius: 3px;
    padding: 13px 16px;
    font-family: var(--font-sans, sans-serif);
    font-size: 14px;
    color: var(--tcp-dark, #1F1D1B);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .tcp-form-field input:focus,
  .tcp-form-field select:focus,
  .tcp-form-field textarea:focus {
    border-color: var(--tcp-gold, #C29B38);
    background: #FFFFFF;
  }

  .tcp-form-submit {
    font-family: var(--font-sans, sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #FFFFFF;
    background: var(--tcp-dark, #1F1D1B);
    border: none;
    padding: 16px;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 8px;
  }

  .tcp-form-submit:hover {
    background: var(--tcp-gold, #C29B38);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .tcp-contact__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .tcp-form-row {
      grid-template-columns: 1fr;
    }
    .tcp-contact__form-box {
      padding: 32px 20px;
    }
  }
</style>

<section class="tcp-contact" id="tcp-contact">
  <div class="tcp-contact__inner">
    <!-- Left: Details -->
    <div class="tcp-contact__info">
      <span class="tcp-contact__label">GET IN TOUCH</span>
      <h1 class="tcp-contact__heading">Connect With The Studio</h1>
      <p class="tcp-contact__subtitle">
        Whether you are planning a bespoke home dinner setting, seeking custom hospitality tableware, or booking a studio experience, we welcome your dialogue.
      </p>

      <div class="tcp-contact__cards">
        <div class="tcp-contact-card">
          <div class="tcp-contact-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <h4 class="tcp-contact-card__title">Village Studio &bull; Gurugram</h4>
            <p class="tcp-contact-card__text">The Creative Platter Studio<br>Near Gurugram, Haryana / New Delhi, India</p>
          </div>
        </div>

        <div class="tcp-contact-card">
          <div class="tcp-contact-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
          </div>
          <div>
            <h4 class="tcp-contact-card__title">Email Dialogue</h4>
            <p class="tcp-contact-card__text"><a href="mailto:info@thecreativeplatter.com">info@thecreativeplatter.com</a></p>
          </div>
        </div>

        <div class="tcp-contact-card">
          <div class="tcp-contact-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          </div>
          <div>
            <h4 class="tcp-contact-card__title">Direct &bull; WhatsApp</h4>
            <p class="tcp-contact-card__text"><a href="tel:+918586946814">+91-8586946814</a></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Form -->
    <div class="tcp-contact__form-box">
      <h2 class="tcp-contact__form-title">Send a Message</h2>
      <p class="tcp-contact__form-sub">We reply within 24 business hours.</p>

      <form class="tcp-contact__form" action="/contact#contact_form" method="post">
        <input type="hidden" name="form_type" value="contact">
        <input type="hidden" name="utf8" value="✓">

        <div class="tcp-form-row">
          <div class="tcp-form-field">
            <label>Your Name *</label>
            <input type="text" name="contact[name]" placeholder="Full Name" required>
          </div>
          <div class="tcp-form-field">
            <label>Email Address *</label>
            <input type="email" name="contact[email]" placeholder="email@domain.com" required>
          </div>
        </div>

        <div class="tcp-form-row">
          <div class="tcp-form-field">
            <label>Phone / WhatsApp</label>
            <input type="tel" name="contact[phone]" placeholder="+91 ...">
          </div>
          <div class="tcp-form-field">
            <label>Inquiry Nature</label>
            <select name="contact[topic]">
              <option>Retail &bull; Pushpa Collection Order</option>
              <option>Bespoke (Homes) Dinnerware</option>
              <option>Hospitality (B2B) Tableware RFQ</option>
              <option>Studio Workshop &bull; Booking</option>
              <option>Corporate Gifting &bull; Volume</option>
              <option>Press &bull; Media Inquiry</option>
            </select>
          </div>
        </div>

        <div class="tcp-form-field">
          <label>Your Message *</label>
          <textarea name="contact[body]" rows="5" placeholder="Share your table requirements, vision, or desired dates..." required></textarea>
        </div>

        <button type="submit" class="tcp-form-submit">Send Message &rarr;</button>
      </form>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCP Contact Section",
  "tag": "section",
  "class": "tcp-contact-section",
  "settings": [],
  "presets": [
    {
      "name": "TCP Contact Section"
    }
  ]
}
{% endschema %}
