{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Signature Dinner Sets
  ============================================================
  Showcase of the five signature dinner sets (Mrida, Rekh,
  Smriti, Viraasat, Neer) with descriptive subtitles.
  Copy into Shopify: sections/section-home-signature-sets.liquid
{% endcomment %}

<style>
  .tcp-signature {
    background-color: var(--tcp-cream, #FAF8F4);
    padding: 80px 0;
  }

  .tcp-signature__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .tcp-signature__top {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
    margin-bottom: 48px;
    align-items: end;
  }

  .tcp-signature__heading {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 400;
    color: var(--tcp-dark, #2D2D2D);
    line-height: 1.15;
    margin-bottom: 16px;
  }

  .tcp-signature__description {
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 14px;
    font-weight: 400;
    color: var(--tcp-muted, #6B6560);
    line-height: 1.7;
    margin-bottom: 24px;
    max-width: 300px;
  }

  .tcp-signature__feature-images {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
  }

  .tcp-signature__feature-img-wrap {
    position: relative;
    width: calc(33.333% - 8px);
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .tcp-signature__feature-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .tcp-signature__feature-img-wrap:hover .tcp-signature__feature-img {
    transform: scale(1.05);
  }

  .tcp-signature__feature-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px;
    background: linear-gradient(to top, rgba(45, 45, 45, 0.7) 0%, transparent 100%);
  }

  .tcp-signature__feature-name {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: 18px;
    font-weight: 500;
    color: var(--tcp-white, #FFFFFF);
    display: block;
    margin-bottom: 2px;
  }

  .tcp-signature__feature-sub {
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 11px;
    font-style: italic;
    color: rgba(255, 255, 255, 0.8);
    letter-spacing: 0.3px;
  }

  /* ── CTA Link ── */
  .tcp-signature__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--tcp-dark, #2D2D2D);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--tcp-dark, #2D2D2D);
    transition: all 0.3s ease;
  }

  .tcp-signature__cta:hover {
    color: var(--tcp-gold, #C8A96E);
    border-bottom-color: var(--tcp-gold, #C8A96E);
  }

  .tcp-signature__cta svg {
    width: 14px;
    height: 14px;
    transition: transform 0.3s ease;
  }

  .tcp-signature__cta:hover svg {
    transform: translateX(4px);
  }

  /* ── Bottom Grid (More Sets) ── */
  .tcp-signature__bottom-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    margin-top: 48px;
  }

  .tcp-signature__set-card {
    text-decoration: none;
    display: block;
  }

  .tcp-signature__set-img-wrap {
    aspect-ratio: 1;
    overflow: hidden;
    margin-bottom: 12px;
    background-color: var(--tcp-beige, #F5F0E8);
  }

  .tcp-signature__set-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .tcp-signature__set-card:hover .tcp-signature__set-img {
    transform: scale(1.06);
  }

  .tcp-signature__set-name {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: 18px;
    font-weight: 500;
    color: var(--tcp-dark, #2D2D2D);
    margin-bottom: 3px;
    display: block;
  }

  .tcp-signature__set-sub {
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 12px;
    font-style: italic;
    color: var(--tcp-muted, #6B6560);
    letter-spacing: 0.3px;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .tcp-signature__top {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .tcp-signature__bottom-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 600px) {
    .tcp-signature {
      padding: 50px 0;
    }

    .tcp-signature__inner {
      padding: 0 24px;
    }

    .tcp-signature__feature-images {
      flex-direction: column;
    }

    .tcp-signature__feature-img-wrap {
      width: 100%;
      aspect-ratio: 4 / 3;
    }

    .tcp-signature__bottom-grid {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
  }
</style>

<section class="tcp-signature" id="tcp-home-signature-sets">
  <div class="tcp-signature__inner">

    <!-- Top Area -->
    <div class="tcp-signature__top">
      <div>
        <h2 class="tcp-signature__heading">{{ section.settings.heading }}</h2>
        <p class="tcp-signature__description">{{ section.settings.description }}</p>
        <a href="{{ section.settings.cta_url | default: '#' }}" class="tcp-signature__cta">
          {{ section.settings.cta_text }}
          <svg viewBox="0 0 14 14" fill="none"><path d="M2 7h9M7.5 3.5L11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      <!-- Feature Images (Top 3 highlighted) -->
      <div class="tcp-signature__feature-images">
        {% for block in section.blocks %}
          {% if block.type == 'featured_set' %}
            <a href="{{ block.settings.link_url | default: '#' }}" class="tcp-signature__feature-img-wrap" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img 
                  class="tcp-signature__feature-img"
                  src="{{ block.settings.image | image_url: width: 500 }}"
                  alt="{{ block.settings.name }}"
                  loading="lazy"
                  width="500"
                  height="667"
                >
              {% else %}
                <div class="tcp-signature__feature-img" style="background: var(--tcp-warm-bg);"></div>
              {% endif %}
              <div class="tcp-signature__feature-label">
                <span class="tcp-signature__feature-name">{{ block.settings.name }}</span>
                <span class="tcp-signature__feature-sub">{{ block.settings.subtitle }}</span>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Bottom Grid (More Sets) -->
    <div class="tcp-signature__bottom-grid">
      {% for block in section.blocks %}
        {% if block.type == 'set_card' %}
          <a href="{{ block.settings.link_url | default: '#' }}" class="tcp-signature__set-card" {{ block.shopify_attributes }}>
            <div class="tcp-signature__set-img-wrap">
              {% if block.settings.image != blank %}
                <img 
                  class="tcp-signature__set-img"
                  src="{{ block.settings.image | image_url: width: 400 }}"
                  alt="{{ block.settings.name }}"
                  loading="lazy"
                  width="400"
                  height="400"
                >
              {% else %}
                <div class="tcp-signature__set-img" style="background: var(--tcp-warm-bg);"></div>
              {% endif %}
            </div>
            <span class="tcp-signature__set-name">{{ block.settings.name }}</span>
            <span class="tcp-signature__set-sub">{{ block.settings.subtitle }}</span>
          </a>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "TCP Signature Sets",
  "tag": "section",
  "class": "tcp-signature-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Signature\nDinner Sets"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Five expressions.\nRooted in tradition,\ndesigned for today."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "EXPLORE ALL COLLECTIONS"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    }
  ],
  "blocks": [
    {
      "type": "featured_set",
      "name": "Featured Set (Top Row)",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "name", "label": "Set name", "default": "Mrida" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Earthy · Raw · Grounded" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link_url", "label": "Link URL" }
      ]
    },
    {
      "type": "set_card",
      "name": "Set Card (Bottom Row)",
      "settings": [
        { "type": "text", "id": "name", "label": "Set name", "default": "Smriti" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Timeless · Soft · Nostalgic" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link_url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TCP Signature Sets",
      "blocks": [
        { "type": "featured_set", "settings": { "name": "Mrida", "subtitle": "Earthy · Raw · Grounded" } },
        { "type": "featured_set", "settings": { "name": "Rekh", "subtitle": "Minimal · Modern · Refined" } },
        { "type": "set_card", "settings": { "name": "Smriti", "subtitle": "Timeless · Soft · Nostalgic" } },
        { "type": "set_card", "settings": { "name": "Viraasat", "subtitle": "Rich · Layered · Celebratory" } },
        { "type": "set_card", "settings": { "name": "Neer", "subtitle": "Light · Calm · Everyday" } }
      ]
    }
  ]
}
{% endschema %}
