{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Bespoke (Homes) Custom Dinnerware
  ============================================================
  Tailored tableware for private residences and dinnerware rituals.
  Copy into Shopify: sections/section-home-bespoke-homes.liquid
{% endcomment %}

<style>
  .tcp-bespoke-homes {
    background-color: var(--tcp-sand, #FBF9F5);
    padding: 80px 0;
  }

  .tcp-bespoke-homes__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 48px;
    align-items: center;
    background: var(--tcp-white, #FFFFFF);
    border: 1px solid var(--tcp-border, #E8E2D8);
    border-radius: 6px;
    overflow: hidden;
  }

  .tcp-bespoke-homes__content {
    padding: 60px 40px 60px 60px;
    display: flex;
    flex-direction: column;
  }

  .tcp-bespoke-homes__label {
    font-family: var(--font-sans, sans-serif);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2.2px;
    text-transform: uppercase;
    color: var(--tcp-gold, #C29B38);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .tcp-bespoke-homes__heading {
    font-family: var(--font-serif, serif);
    font-size: clamp(32px, 3.8vw, 46px);
    font-weight: 400;
    color: var(--tcp-dark, #1F1D1B);
    line-height: 1.15;
    margin: 0 0 16px;
  }

  .tcp-bespoke-homes__description {
    font-family: var(--font-sans, sans-serif);
    font-size: 14.5px;
    color: var(--tcp-muted, #68625B);
    line-height: 1.75;
    margin-bottom: 28px;
    max-width: 440px;
  }

  .tcp-bespoke-homes__steps-list {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tcp-bespoke-homes__step-item {
    font-family: var(--font-sans, sans-serif);
    font-size: 13px;
    color: var(--tcp-brown, #352922);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .tcp-bespoke-homes__step-icon {
    color: var(--tcp-gold, #C29B38);
    font-size: 16px;
  }

  .tcp-bespoke-homes__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-sans, sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #FFFFFF;
    background: var(--tcp-dark, #1F1D1B);
    text-decoration: none;
    padding: 15px 30px;
    border-radius: 2px;
    transition: all 0.3s var(--ease-fluid);
    align-self: flex-start;
  }

  .tcp-bespoke-homes__cta:hover {
    background: var(--tcp-gold, #C29B38);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(194, 155, 56, 0.25);
  }

  .tcp-bespoke-homes__image-wrap {
    position: relative;
    height: 100%;
    min-height: 440px;
    background: var(--tcp-stone, #F3EFEA);
  }

  .tcp-bespoke-homes__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-fluid);
  }

  .tcp-bespoke-homes:hover .tcp-bespoke-homes__image {
    transform: scale(1.04);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .tcp-bespoke-homes__inner {
      grid-template-columns: 1fr;
      padding: 0;
    }
    .tcp-bespoke-homes__content {
      padding: 40px 24px;
    }
    .tcp-bespoke-homes__image-wrap {
      min-height: 300px;
    }
  }
</style>

<section class="tcp-bespoke-homes" id="tcp-home-bespoke-homes">
  <div class="tcp-bespoke-homes__inner">

    <div class="tcp-bespoke-homes__content">
      <span class="tcp-bespoke-homes__label">{{ section.settings.label | default: 'BESPOKE RESIDENCES' }}</span>
      <h2 class="tcp-bespoke-homes__heading">{{ section.settings.heading | default: 'Tailored Dinnerware For Your Home' }}</h2>
      <p class="tcp-bespoke-homes__description">
        {{ section.settings.description | default: 'Defined by restraint and tactile clarity, our bespoke home commissions are shaped through a material-led dialogue. Designed to settle into your home quietly, revealing their character over time.' }}
      </p>

      <ul class="tcp-bespoke-homes__steps-list">
        <li class="tcp-bespoke-homes__step-item">
          <span class="tcp-bespoke-homes__step-icon">&bull;</span>
          <span>Custom Clay Body &amp; Hand-Mixed Glaze Selection</span>
        </li>
        <li class="tcp-bespoke-homes__step-item">
          <span class="tcp-bespoke-homes__step-icon">&bull;</span>
          <span>Personalized Monograms &amp; 24k Gold Edge Detailing</span>
        </li>
        <li class="tcp-bespoke-homes__step-item">
          <span class="tcp-bespoke-homes__step-icon">&bull;</span>
          <span>Tailored Setting Quantities (6, 12, 18 or 24 Guests)</span>
        </li>
      </ul>

      <a href="{{ section.settings.cta_url | default: '/pages/contact' }}" class="tcp-bespoke-homes__cta">
        {{ section.settings.cta_text | default: 'Consult With The Studio' }} &rarr;
      </a>
    </div>

    <div class="tcp-bespoke-homes__image-wrap">
      {% if section.settings.image != blank %}
        <img 
          class="tcp-bespoke-homes__image"
          src="{{ section.settings.image | image_url: width: 900 }}"
          alt="{{ section.settings.image_alt | default: 'Bespoke dinnerware for private homes' }}"
          loading="lazy"
          width="900"
          height="600"
        >
      {% else %}
        <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background: radial-gradient(circle, #FAF8F4 0%, #EDE6DC 100%);">
          <svg width="120" height="120" viewBox="0 0 120 120" fill="none">
            <ellipse cx="60" cy="60" rx="46" ry="46" stroke="#C29B38" stroke-width="1.5" stroke-dasharray="12 4"/>
            <ellipse cx="60" cy="60" rx="30" ry="30" stroke="#1F1D1B" stroke-width="1"/>
          </svg>
        </div>
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "TCP Bespoke Homes CTA",
  "tag": "section",
  "class": "tcp-bespoke-homes-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "BESPOKE RESIDENCES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tailored Dinnerware For Your Home"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Defined by restraint and tactile clarity, our bespoke home commissions are shaped through a material-led dialogue. Designed to settle into your home quietly, revealing their character over time."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Consult With The Studio"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section image"
    }
  ],
  "presets": [
    {
      "name": "TCP Bespoke Homes CTA"
    }
  ]
}
{% endschema %}
