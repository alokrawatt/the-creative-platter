{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Bespoke (Homes) CTA
  ============================================================
  Split layout CTA for bespoke home dinnerware customization.
  Copy into Shopify: sections/section-home-bespoke-homes.liquid
{% endcomment %}

<style>
  .tcp-bespoke-homes {
    background-color: var(--tcp-beige, #F5F0E8);
    overflow: hidden;
  }

  .tcp-bespoke-homes__inner {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 480px;
  }

  /* ── Content Side ── */
  .tcp-bespoke-homes__content {
    padding: 60px 60px 60px 80px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .tcp-bespoke-homes__label {
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--tcp-muted, #6B6560);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tcp-bespoke-homes__label::after {
    content: '';
    width: 40px;
    height: 1px;
    background-color: var(--tcp-border-dark, #C5BFB5);
  }

  .tcp-bespoke-homes__heading {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 400;
    color: var(--tcp-dark, #2D2D2D);
    line-height: 1.15;
    margin-bottom: 16px;
  }

  .tcp-bespoke-homes__description {
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 15px;
    font-weight: 400;
    color: var(--tcp-muted, #6B6560);
    line-height: 1.7;
    margin-bottom: 32px;
    max-width: 360px;
  }

  .tcp-bespoke-homes__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--tcp-dark, #2D2D2D);
    text-decoration: none;
    padding: 14px 28px;
    border: 1.5px solid var(--tcp-dark, #2D2D2D);
    transition: all 0.3s ease;
    align-self: flex-start;
  }

  .tcp-bespoke-homes__cta:hover {
    background-color: var(--tcp-gold, #C8A96E);
    border-color: var(--tcp-gold, #C8A96E);
    color: var(--tcp-white, #FFFFFF);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(200, 169, 110, 0.25);
  }

  .tcp-bespoke-homes__cta svg {
    width: 14px;
    height: 14px;
    transition: transform 0.3s ease;
  }

  .tcp-bespoke-homes__cta:hover svg {
    transform: translateX(4px);
  }

  /* ── Image Side ── */
  .tcp-bespoke-homes__image-wrap {
    position: relative;
    overflow: hidden;
  }

  .tcp-bespoke-homes__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .tcp-bespoke-homes:hover .tcp-bespoke-homes__image {
    transform: scale(1.03);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .tcp-bespoke-homes__inner {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .tcp-bespoke-homes__content {
      padding: 50px 40px;
      order: 2;
    }

    .tcp-bespoke-homes__image-wrap {
      height: 300px;
      order: 1;
    }
  }

  @media (max-width: 600px) {
    .tcp-bespoke-homes__content {
      padding: 36px 24px;
    }
  }
</style>

<section class="tcp-bespoke-homes" id="tcp-home-bespoke-homes">
  <div class="tcp-bespoke-homes__inner">

    <div class="tcp-bespoke-homes__content">
      <span class="tcp-bespoke-homes__label">{{ section.settings.label }}</span>
      <h2 class="tcp-bespoke-homes__heading">{{ section.settings.heading }}</h2>
      <p class="tcp-bespoke-homes__description">{{ section.settings.description }}</p>
      <a href="{{ section.settings.cta_url | default: '#' }}" class="tcp-bespoke-homes__cta">
        {{ section.settings.cta_text }}
        <svg viewBox="0 0 14 14" fill="none"><path d="M2 7h9M7.5 3.5L11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <div class="tcp-bespoke-homes__image-wrap">
      {% if section.settings.image != blank %}
        <img 
          class="tcp-bespoke-homes__image"
          src="{{ section.settings.image | image_url: width: 900 }}"
          alt="{{ section.settings.image_alt | default: 'Bespoke dinnerware for your home' }}"
          loading="lazy"
          width="900"
          height="600"
        >
      {% else %}
        <div class="tcp-bespoke-homes__image" style="background: linear-gradient(135deg, var(--tcp-beige) 0%, var(--tcp-warm-bg) 100%);"></div>
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "TCP Bespoke Homes CTA",
  "tag": "section",
  "class": "tcp-bespoke-homes-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "BESPOKE (HOMES)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Design your\nown dinnerware"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Choose forms, finishes and colours.\nCrafted just for your table."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "START YOUR JOURNEY"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Bespoke dinnerware for your home"
    }
  ],
  "presets": [
    {
      "name": "TCP Bespoke Homes CTA"
    }
  ]
}
{% endschema %}
