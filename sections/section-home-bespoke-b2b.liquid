{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Home Bespoke & Hospitality Teaser
  ============================================================
  Kevala Ceramics inspired B2B / Commercial showcase for
  chefs, Michelin restaurants, boutique hotels & architects.
  Copy into Shopify: sections/section-home-bespoke-b2b.liquid
{% endcomment %}

<style>
  .tcp-home-b2b {
    background-color: var(--tcp-sand, #FBF9F5);
    padding: 100px 0;
    position: relative;
    border-top: 1px solid var(--tcp-border, #E8E2D8);
  }

  .tcp-home-b2b__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .tcp-home-b2b__card {
    background: var(--tcp-dark, #1F1D1B);
    color: var(--tcp-sand, #FBF9F5);
    border-radius: 6px;
    padding: 64px 60px;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(31, 29, 27, 0.18);
  }

  .tcp-home-b2b__glow {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(194, 155, 56, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .tcp-home-b2b__label {
    font-family: var(--font-sans, sans-serif);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--tcp-gold-light, #DFBA5E);
    display: block;
    margin-bottom: 12px;
  }

  .tcp-home-b2b__title {
    font-family: var(--font-serif, serif);
    font-size: clamp(34px, 4vw, 50px);
    font-weight: 400;
    color: #FFFFFF;
    line-height: 1.1;
    margin: 0 0 16px;
  }

  .tcp-home-b2b__desc {
    font-family: var(--font-sans, sans-serif);
    font-size: 14.5px;
    color: rgba(251, 249, 245, 0.8);
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .tcp-home-b2b__specs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 36px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding: 20px 0;
  }

  .tcp-home-b2b__spec-item strong {
    display: block;
    font-family: var(--font-serif, serif);
    font-size: 24px;
    color: var(--tcp-gold-light, #DFBA5E);
    line-height: 1;
    margin-bottom: 4px;
  }

  .tcp-home-b2b__spec-item span {
    font-size: 11px;
    color: rgba(251, 249, 245, 0.7);
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }

  .tcp-home-b2b__ctas {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .tcp-home-b2b__btn-gold {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans, sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--tcp-dark, #1F1D1B);
    background: var(--tcp-gold, #C29B38);
    padding: 15px 30px;
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .tcp-home-b2b__btn-gold:hover {
    background: #FFFFFF;
    transform: translateY(-2px);
  }

  .tcp-home-b2b__btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans, sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #FFFFFF;
    background: transparent;
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    padding: 14px 26px;
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .tcp-home-b2b__btn-outline:hover {
    border-color: #FFFFFF;
    background: rgba(255, 255, 255, 0.1);
  }

  /* ── Right: Visual Showcase (Kevala style) ── */
  .tcp-home-b2b__visual {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    aspect-ratio: 4 / 3.5;
    background: #2D2722;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .tcp-home-b2b__visual-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tcp-home-b2b__visual-badge {
    position: absolute;
    bottom: 16px;
    left: 16px;
    background: rgba(31, 29, 27, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid var(--tcp-gold, #C29B38);
    padding: 8px 14px;
    border-radius: 4px;
    font-size: 11px;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .tcp-home-b2b__card {
      grid-template-columns: 1fr;
      padding: 40px 32px;
    }
  }

  @media (max-width: 600px) {
    .tcp-home-b2b {
      padding: 60px 0;
    }
    .tcp-home-b2b__inner {
      padding: 0 20px;
    }
    .tcp-home-b2b__card {
      padding: 32px 20px;
    }
    .tcp-home-b2b__specs {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .tcp-home-b2b__ctas {
      flex-direction: column;
      align-items: stretch;
    }
    .tcp-home-b2b__btn-gold,
    .tcp-home-b2b__btn-outline {
      justify-content: center;
    }
  }
</style>

<section class="tcp-home-b2b" id="tcp-home-hospitality">
  <div class="tcp-home-b2b__inner">
    <div class="tcp-home-b2b__card">
      <div class="tcp-home-b2b__glow"></div>

      <!-- Left Info -->
      <div class="tcp-home-b2b__content">
        <span class="tcp-home-b2b__label">B2B &bull; HOSPITALITY &amp; TRADE</span>
        <h2 class="tcp-home-b2b__title">Bespoke Tableware for Culinary Visionaries</h2>
        <p class="tcp-home-b2b__desc">
          Partnering with Michelin-starred chefs, luxury resort dining, boutique hotels, and architects worldwide. We engineer custom profiles, bespoke glazes, and heavy-duty stoneware tailored to your kitchen’s culinary rhythm.
        </p>

        <div class="tcp-home-b2b__specs">
          <div class="tcp-home-b2b__spec-item">
            <strong>1280°C</strong>
            <span>High-Temp Vitrified</span>
          </div>
          <div class="tcp-home-b2b__spec-item">
            <strong>50+</strong>
            <span>Low Custom MOQ</span>
          </div>
          <div class="tcp-home-b2b__spec-item">
            <strong>Custom</strong>
            <span>Glazes &amp; Relief Logo</span>
          </div>
        </div>

        <div class="tcp-home-b2b__ctas">
          <a href="/pages/bespoke-b2b" class="tcp-home-b2b__btn-gold">
            <span>Explore B2B Studio &rarr;</span>
          </a>
          <a href="/pages/bespoke-b2b#rfq" class="tcp-home-b2b__btn-outline">
            <span>Request Hospitality Sample</span>
          </a>
        </div>
      </div>

      <!-- Right Visual -->
      <div class="tcp-home-b2b__visual">
        {% if section.settings.b2b_image != blank %}
          <img 
            class="tcp-home-b2b__visual-img"
            src="{{ section.settings.b2b_image | image_url: width: 800 }}"
            alt="Hospitality Bespoke Tableware"
            loading="lazy"
          >
        {% else %}
          <!-- Architectural Ceramic Spec Graphic -->
          <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background: radial-gradient(circle, #3D352F 0%, #201B17 100%);">
            <svg width="140" height="140" viewBox="0 0 140 140" fill="none">
              <rect x="25" y="25" width="90" height="90" rx="4" stroke="#C29B38" stroke-width="1.5" stroke-dasharray="8 4"/>
              <circle cx="70" cy="70" r="35" stroke="#FAF8F4" stroke-width="1.2"/>
              <path d="M50 70 L90 70 M70 50 L70 90" stroke="#DFBA5E" stroke-width="1" stroke-dasharray="3 3"/>
            </svg>
          </div>
        {% endif %}

        <div class="tcp-home-b2b__visual-badge">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="#C29B38"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          <span>Commercial Dishwasher &amp; Oven Safe</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCP Home Hospitality B2B",
  "tag": "section",
  "class": "tcp-home-b2b-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "b2b_image",
      "label": "Hospitality visual image"
    }
  ],
  "presets": [
    {
      "name": "TCP Home Hospitality B2B"
    }
  ]
}
{% endschema %}
