{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Bespoke (B2B) CTA
  ============================================================
  Dark/moody CTA section for hospitality & business tableware.
  Copy into Shopify: sections/section-home-bespoke-b2b.liquid
{% endcomment %}

<style>
  .tcp-bespoke-b2b-cta {
    position: relative;
    overflow: hidden;
    min-height: 420px;
    display: flex;
    align-items: center;
  }

  .tcp-bespoke-b2b-cta__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .tcp-bespoke-b2b-cta__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tcp-bespoke-b2b-cta__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(35, 28, 22, 0.88) 0%, rgba(35, 28, 22, 0.65) 50%, rgba(35, 28, 22, 0.3) 100%);
    z-index: 1;
  }

  .tcp-bespoke-b2b-cta__inner {
    position: relative;
    z-index: 2;
    max-width: 1440px;
    margin: 0 auto;
    padding: 60px 80px;
    width: 100%;
  }

  .tcp-bespoke-b2b-cta__label {
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--tcp-gold-light, #D4BA85);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tcp-bespoke-b2b-cta__label::after {
    content: '';
    width: 40px;
    height: 1px;
    background-color: var(--tcp-gold, #C8A96E);
    opacity: 0.5;
  }

  .tcp-bespoke-b2b-cta__heading {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 400;
    color: var(--tcp-white, #FFFFFF);
    line-height: 1.15;
    margin-bottom: 16px;
    max-width: 500px;
  }

  .tcp-bespoke-b2b-cta__description {
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 15px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.7;
    margin-bottom: 32px;
    max-width: 420px;
  }

  .tcp-bespoke-b2b-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-sans, 'DM Sans', sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--tcp-dark, #2D2D2D);
    text-decoration: none;
    padding: 14px 28px;
    background-color: var(--tcp-gold, #C8A96E);
    border: 1.5px solid var(--tcp-gold, #C8A96E);
    transition: all 0.3s ease;
  }

  .tcp-bespoke-b2b-cta__btn:hover {
    background-color: var(--tcp-gold-hover, #B8965A);
    border-color: var(--tcp-gold-hover, #B8965A);
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(200, 169, 110, 0.35);
  }

  .tcp-bespoke-b2b-cta__btn svg {
    width: 14px;
    height: 14px;
    transition: transform 0.3s ease;
  }

  .tcp-bespoke-b2b-cta__btn:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .tcp-bespoke-b2b-cta__inner {
      padding: 40px 24px;
    }

    .tcp-bespoke-b2b-cta {
      min-height: 360px;
    }

    .tcp-bespoke-b2b-cta__overlay {
      background: linear-gradient(to bottom, rgba(35, 28, 22, 0.85) 0%, rgba(35, 28, 22, 0.6) 100%);
    }
  }
</style>

<section class="tcp-bespoke-b2b-cta" id="tcp-home-bespoke-b2b">
  <div class="tcp-bespoke-b2b-cta__bg">
    {% if section.settings.bg_image != blank %}
      <img 
        class="tcp-bespoke-b2b-cta__bg-img"
        src="{{ section.settings.bg_image | image_url: width: 1600 }}"
        alt=""
        loading="lazy"
        width="1600"
        height="600"
      >
    {% else %}
      <div class="tcp-bespoke-b2b-cta__bg-img" style="background: linear-gradient(135deg, #3A2F28, #2D2D2D);"></div>
    {% endif %}
    <div class="tcp-bespoke-b2b-cta__overlay"></div>
  </div>

  <div class="tcp-bespoke-b2b-cta__inner">
    <span class="tcp-bespoke-b2b-cta__label">{{ section.settings.label }}</span>
    <h2 class="tcp-bespoke-b2b-cta__heading">{{ section.settings.heading }}</h2>
    <p class="tcp-bespoke-b2b-cta__description">{{ section.settings.description }}</p>
    <a href="{{ section.settings.cta_url | default: '#' }}" class="tcp-bespoke-b2b-cta__btn">
      {{ section.settings.cta_text }}
      <svg viewBox="0 0 14 14" fill="none"><path d="M2 7h9M7.5 3.5L11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "TCP Bespoke B2B CTA",
  "tag": "section",
  "class": "tcp-bespoke-b2b-cta-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "BESPOKE (B2B)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bespoke for\nbusiness & spaces"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Thoughtfully designed tableware for hospitality, retail and interiors."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "EXPLORE STUDIO"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    }
  ],
  "presets": [
    {
      "name": "TCP Bespoke B2B CTA"
    }
  ]
}
{% endschema %}
