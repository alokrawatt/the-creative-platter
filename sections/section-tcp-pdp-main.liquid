{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Editorial Product Main Section
  ============================================================
  Matches the luxury ceramic PDP reference:
  - Dynamic breadcrumb navigation
  - Vertical desktop thumbnail stack + large main viewport with zoom
  - Mobile swipeable carousel with pagination dots
  - Eyebrow pill, editorial serif title, price with tax note
  - Pill size selectors with sold-out states
  - Circular textured finish swatches (Sand, Dune, Stone, Ash)
  - Quantity selector + Dynamic "ADD TO CART — ₹1,250" button + "BUY IT NOW"
  - Wishlist toggle button
{% endcomment %}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Raleway:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Sacramento&display=swap" rel="stylesheet">

<style>
  #tcp-pdp-main-{{ section.id }} {
    --tcp-gold-bright: #fcce3a;
    --tcp-accent-gold: #A6732E;
    --tcp-gold-hover: #8C5F22;
    --tcp-stone-bg: #FAF7F2;
    --tcp-border-subtle: #E8E2D8;
    --tcp-charcoal: #2D2A27;
    --tcp-body-grey: #545454;
    
    background-color: #FFFFFF;
    color: var(--tcp-charcoal);
    padding-top: {{ section.settings.padding_top | default: 32 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    position: relative;
    box-sizing: border-box;
  }

  .tcp-pdp-main__container {
    max-width: {{ section.settings.container_width | default: 1440 }}px;
    margin: 0 auto;
    padding: 0 40px;
    box-sizing: border-box;
  }

  @media (max-width: 768px) {
    .tcp-pdp-main__container {
      padding: 0 20px;
    }
  }

  /* ── Breadcrumb ── */
  .tcp-pdp-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 11px;
    color: #8E8981;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .tcp-pdp-breadcrumb a {
    color: #8E8981;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .tcp-pdp-breadcrumb a:hover {
    color: var(--tcp-accent-gold);
  }

  .tcp-pdp-breadcrumb__sep {
    font-size: 10px;
    opacity: 0.6;
  }

  .tcp-pdp-breadcrumb__current {
    color: var(--tcp-charcoal);
    font-weight: 500;
  }

  /* ── Main Layout Grid ── */
  .tcp-pdp-grid {
    display: grid;
    grid-template-columns: 1.18fr 1fr;
    gap: 56px;
    align-items: flex-start;
  }

  @media (max-width: 1024px) {
    .tcp-pdp-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  /* ── Left: Image Gallery ── */
  .tcp-pdp-gallery {
    display: flex;
    gap: 18px;
    position: sticky;
    top: 90px;
  }

  @media (max-width: 768px) {
    .tcp-pdp-gallery {
      position: relative;
      top: 0;
      flex-direction: column-reverse;
      gap: 12px;
    }
  }

  /* Vertical Thumbnail Strip (Desktop) */
  .tcp-pdp-gallery__thumbs {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 82px;
    flex-shrink: 0;
    max-height: 580px;
    overflow-y: auto;
    scrollbar-width: none; /* Firefox */
  }
  .tcp-pdp-gallery__thumbs::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 768px) {
    .tcp-pdp-gallery__thumbs {
      flex-direction: row;
      width: 100%;
      max-height: none;
      overflow-x: auto;
      justify-content: flex-start;
      gap: 8px;
    }
  }

  .tcp-pdp-gallery__thumb-item {
    width: 82px;
    height: 96px;
    border-radius: 2px;
    overflow: hidden;
    cursor: pointer;
    background: var(--tcp-stone-bg);
    border: 1.5px solid transparent;
    transition: all 0.25s ease;
    flex-shrink: 0;
    padding: 0;
  }

  @media (max-width: 768px) {
    .tcp-pdp-gallery__thumb-item {
      width: 64px;
      height: 72px;
    }
  }

  .tcp-pdp-gallery__thumb-item:hover {
    border-color: var(--tcp-accent-gold);
  }

  .tcp-pdp-gallery__thumb-item.is-active {
    border-color: var(--tcp-charcoal);
  }

  .tcp-pdp-gallery__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Main Featured Image Viewport */
  .tcp-pdp-gallery__main-wrap {
    position: relative;
    flex: 1;
    aspect-ratio: 1 / 1.08;
    background: var(--tcp-stone-bg);
    overflow: hidden;
    border-radius: 2px;
    border: 1px solid var(--tcp-border-subtle);
  }

  .tcp-pdp-gallery__main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tcp-pdp-gallery__main-wrap:hover .tcp-pdp-gallery__main-img {
    transform: scale(1.035);
  }

  .tcp-pdp-gallery__zoom-icon {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(6px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--tcp-charcoal);
    pointer-events: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  /* Fallback Graphic when no image */
  .tcp-pdp-gallery__fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at 60% 40%, #FAF7F2 0%, #EDE6D8 100%);
  }

  .tcp-pdp-gallery__fallback svg {
    width: 70%;
    height: 70%;
    max-width: 320px;
    max-height: 320px;
  }

  /* ── Right: Sticky Purchase Column ── */
  .tcp-pdp-info {
    display: flex;
    flex-direction: column;
  }

  /* Eyebrow */
  .tcp-pdp-info__eyebrow {
    font-family: var(--font-brand, 'Raleway', sans-serif);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #8E8981;
    margin-bottom: 6px;
    display: block;
  }

  /* Title */
  .tcp-pdp-info__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 400;
    letter-spacing: -0.5px;
    color: var(--tcp-charcoal);
    line-height: 1.1;
    margin: 0 0 14px;
  }

  /* Price Row */
  .tcp-pdp-info__price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 4px;
  }

  .tcp-pdp-info__price {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 24px;
    font-weight: 600;
    color: var(--tcp-charcoal);
  }

  .tcp-pdp-info__compare-price {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 16px;
    color: #8E8981;
    text-decoration: line-through;
  }

  .tcp-pdp-info__tax-note {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 11.5px;
    color: #8E8981;
    margin-bottom: 18px;
  }

  /* Short Description */
  .tcp-pdp-info__desc {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--tcp-body-grey);
    margin: 0 0 28px;
    border-bottom: 1px solid var(--tcp-border-subtle);
    padding-bottom: 24px;
  }

  /* Option Section Titles */
  .tcp-pdp-option__label {
    font-family: var(--font-brand, 'Raleway', sans-serif);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8E8981;
    margin-bottom: 10px;
    display: flex;
    justify-content: space-between;
  }

  .tcp-pdp-option__selected-value {
    color: var(--tcp-charcoal);
    font-weight: 600;
  }

  /* Option 1: Size Pills */
  .tcp-pdp-pills {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .tcp-pdp-pill {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 12px;
    font-weight: 500;
    color: var(--tcp-charcoal);
    padding: 10px 20px;
    background: #FFFFFF;
    border: 1px solid var(--tcp-border-subtle);
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tcp-pdp-pill:hover {
    border-color: var(--tcp-charcoal);
  }

  .tcp-pdp-pill.is-active {
    border-color: var(--tcp-charcoal);
    background: #FAF7F2;
    font-weight: 600;
    box-shadow: inset 0 0 0 1px var(--tcp-charcoal);
  }

  .tcp-pdp-pill.is-disabled {
    opacity: 0.45;
    text-decoration: line-through;
    cursor: not-allowed;
  }

  /* Option 2: Ceramic Finish Color Swatches */
  .tcp-pdp-swatches {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .tcp-pdp-swatch-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    cursor: pointer;
  }

  .tcp-pdp-swatch {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 2px solid transparent;
    padding: 2px;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  .tcp-pdp-swatch__inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: block;
    box-shadow: inset 0 0 4px rgba(0, 0, 0, 0.15);
  }

  .tcp-pdp-swatch-wrap:hover .tcp-pdp-swatch {
    transform: scale(1.08);
  }

  .tcp-pdp-swatch-wrap.is-active .tcp-pdp-swatch {
    border-color: var(--tcp-accent-gold);
  }

  .tcp-pdp-swatch__name {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 11px;
    color: #7A746D;
    letter-spacing: 0.5px;
  }

  .tcp-pdp-swatch-wrap.is-active .tcp-pdp-swatch__name {
    color: var(--tcp-charcoal);
    font-weight: 600;
  }

  /* Quantity Selector */
  .tcp-pdp-qty-wrap {
    margin-bottom: 24px;
  }

  .tcp-pdp-qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--tcp-border-subtle);
    border-radius: 2px;
    background: #FFFFFF;
    height: 44px;
  }

  .tcp-pdp-qty__btn {
    width: 44px;
    height: 100%;
    background: transparent;
    border: none;
    color: var(--tcp-charcoal);
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .tcp-pdp-qty__btn:hover {
    background: var(--tcp-stone-bg);
  }

  .tcp-pdp-qty__input {
    width: 48px;
    text-align: center;
    border: none;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: var(--tcp-charcoal);
    background: transparent;
    -moz-appearance: textfield;
  }
  .tcp-pdp-qty__input::-webkit-outer-spin-button,
  .tcp-pdp-qty__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* Action Buttons */
  .tcp-pdp-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
  }

  .tcp-pdp-btn-atc {
    width: 100%;
    padding: 16px 28px;
    background: #1F1D1B;
    color: #FFFFFF;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 2.2px;
    text-transform: uppercase;
    border: none;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }

  .tcp-pdp-btn-atc:hover {
    background: #3A3530;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
  }

  .tcp-pdp-btn-buy {
    width: 100%;
    padding: 15px 28px;
    background: var(--tcp-stone-bg);
    color: var(--tcp-charcoal);
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: 1px solid var(--tcp-border-subtle);
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.25s ease;
    text-align: center;
    text-decoration: none;
    display: block;
    box-sizing: border-box;
  }

  .tcp-pdp-btn-buy:hover {
    background: #EDE6D8;
    border-color: #D8CEBE;
  }

  /* Wishlist Link */
  .tcp-pdp-wishlist-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 12px;
    color: #7A746D;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s ease;
    background: none;
    border: none;
    padding: 0;
  }

  .tcp-pdp-wishlist-link:hover {
    color: var(--tcp-accent-gold);
  }

  .tcp-pdp-wishlist-link svg {
    width: 15px;
    height: 15px;
  }
</style>

<section id="tcp-pdp-main-{{ section.id }}" class="tcp-pdp-main-section">
  <div class="tcp-pdp-main__container">
    
    {% comment %} Breadcrumb Navigation {% endcomment %}
    <nav class="tcp-pdp-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="tcp-pdp-breadcrumb__sep">&rsaquo;</span>
      {% if collection %}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span class="tcp-pdp-breadcrumb__sep">&rsaquo;</span>
      {% else %}
        <a href="/collections/all">{{ section.settings.default_collection_name | default: 'Pushpa Collection' }}</a>
        <span class="tcp-pdp-breadcrumb__sep">&rsaquo;</span>
      {% endif %}
      <a href="/collections/all">Dinnerware</a>
      <span class="tcp-pdp-breadcrumb__sep">&rsaquo;</span>
      <span class="tcp-pdp-breadcrumb__current">{{ product.title | default: 'Sand Form Plate' }}</span>
    </nav>

    <div class="tcp-pdp-grid">
      
      {% comment %} LEFT: Media Gallery {% endcomment %}
      <div class="tcp-pdp-gallery">
        
        {% comment %} Thumbnails List {% endcomment %}
        <div class="tcp-pdp-gallery__thumbs">
          {% if product.media.size > 0 %}
            {% for media in product.media %}
              <button
                type="button"
                class="tcp-pdp-gallery__thumb-item {% if forloop.first %}is-active{% endif %}"
                data-target-index="{{ forloop.index0 }}"
                data-large-src="{{ media | image_url: width: 1400 }}"
                aria-label="View product image {{ forloop.index }}"
              >
                <img
                  src="{{ media | image_url: width: 180 }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  class="tcp-pdp-gallery__thumb-img"
                  loading="lazy"
                >
              </button>
            {% endfor %}
          {% else %}
            <!-- Demo Pottery Thumbnail Placeholders for Visual Preview -->
            <button type="button" class="tcp-pdp-gallery__thumb-item is-active">
              <div style="width: 100%; height: 100%; background: #FAF7F2; display: flex; align-items: center; justify-content: center; font-size: 9px; color: #8E8981;">Top View</div>
            </button>
            <button type="button" class="tcp-pdp-gallery__thumb-item">
              <div style="width: 100%; height: 100%; background: #FAF7F2; display: flex; align-items: center; justify-content: center; font-size: 9px; color: #8E8981;">Profile</div>
            </button>
            <button type="button" class="tcp-pdp-gallery__thumb-item">
              <div style="width: 100%; height: 100%; background: #FAF7F2; display: flex; align-items: center; justify-content: center; font-size: 9px; color: #8E8981;">Glaze</div>
            </button>
            <button type="button" class="tcp-pdp-gallery__thumb-item">
              <div style="width: 100%; height: 100%; background: #FAF7F2; display: flex; align-items: center; justify-content: center; font-size: 9px; color: #8E8981;">Stacked</div>
            </button>
          {% endif %}
        </div>

        {% comment %} Main Featured Image Viewport {% endcomment %}
        <div class="tcp-pdp-gallery__main-wrap">
          {% if product.featured_media != blank %}
            <img
              id="tcp-pdp-main-image-{{ section.id }}"
              src="{{ product.featured_media | image_url: width: 1400 }}"
              srcset="
                {{ product.featured_media | image_url: width: 600 }} 600w,
                {{ product.featured_media | image_url: width: 1000 }} 1000w,
                {{ product.featured_media | image_url: width: 1400 }} 1400w
              "
              sizes="(max-width: 1024px) 100vw, 55vw"
              alt="{{ product.title | escape }}"
              class="tcp-pdp-gallery__main-img"
              loading="eager"
            >
          {% else %}
            <!-- Fallback Artisan Stoneware Artwork -->
            <div class="tcp-pdp-gallery__fallback">
              <svg viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="150" cy="150" r="120" fill="#F4EFE6" stroke="#A6732E" stroke-width="2.5"/>
                <circle cx="150" cy="150" r="95" fill="#EDE4D6" stroke="#A6732E" stroke-width="1.5" stroke-dasharray="4 4"/>
                <circle cx="150" cy="150" r="60" fill="#FAF7F2" stroke="#A6732E" stroke-width="2"/>
                <path d="M150 120 C140 140 140 160 150 180" stroke="#A6732E" stroke-width="1.8" stroke-linecap="round"/>
                <circle cx="150" cy="115" r="4" fill="#fcce3a"/>
              </svg>
            </div>
          {% endif %}

          <div class="tcp-pdp-gallery__zoom-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </div>
        </div>

      </div>

      {% comment %} RIGHT: Product Information & Purchase Panel {% endcomment %}
      <div class="tcp-pdp-info">
        
        <span class="tcp-pdp-info__eyebrow">
          {{ product.metafields.custom.collection_name.value | default: section.settings.eyebrow_text | default: 'PUSHPA COLLECTION' }}
        </span>

        <h1 class="tcp-pdp-info__title">
          {{ product.title | default: 'Sand Form Plate' }}
        </h1>

        <div class="tcp-pdp-info__price-row">
          <span class="tcp-pdp-info__price" id="tcp-pdp-price-{{ section.id }}">
            {{ product.selected_or_first_available_variant.price | default: 125000 | money }}
          </span>
          {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
            <span class="tcp-pdp-info__compare-price">
              {{ product.selected_or_first_available_variant.compare_at_price | money }}
            </span>
          {% endif %}
        </div>

        <div class="tcp-pdp-info__tax-note">
          {{ section.settings.tax_note | default: 'Inclusive of all taxes' }}
        </div>

        <div class="tcp-pdp-info__desc">
          {% if product.description != blank %}
            {{ product.description | truncatewords: 35 }}
          {% else %}
            Handcrafted ceramic dinnerware with a soft textured glaze, designed to elevate everyday dining and special moments alike.
          {% endif %}
        </div>

        {% comment %} Product Form for Shopify Cart {% endcomment %}
        {% form 'product', product, id: 'tcp-product-form', class: 'tcp-pdp-form' %}
          <input type="hidden" name="id" id="tcp-selected-variant-id" value="{{ product.selected_or_first_available_variant.id }}">

          {% comment %} Size Selector {% endcomment %}
          <div class="tcp-pdp-option-group">
            <div class="tcp-pdp-option__label">
              <span>Size</span>
              <span class="tcp-pdp-option__selected-value" id="tcp-selected-size-label">Medium (10 in)</span>
            </div>
            <div class="tcp-pdp-pills">
              <button type="button" class="tcp-pdp-pill" data-option-value="Small (8 in)">Small (8 in)</button>
              <button type="button" class="tcp-pdp-pill is-active" data-option-value="Medium (10 in)">Medium (10 in)</button>
              <button type="button" class="tcp-pdp-pill" data-option-value="Large (12 in)">Large (12 in)</button>
            </div>
          </div>

          {% comment %} Finish Color Swatches {% endcomment %}
          <div class="tcp-pdp-option-group">
            <div class="tcp-pdp-option__label">
              <span>Finish</span>
              <span class="tcp-pdp-option__selected-value" id="tcp-selected-finish-label">Sand</span>
            </div>
            <div class="tcp-pdp-swatches">
              <div class="tcp-pdp-swatch-wrap is-active" data-finish-name="Sand">
                <span class="tcp-pdp-swatch">
                  <span class="tcp-pdp-swatch__inner" style="background-color: #D4C5B0; background-image: radial-gradient(#C4B39C 15%, transparent 16%); background-size: 6px 6px;"></span>
                </span>
                <span class="tcp-pdp-swatch__name">Sand</span>
              </div>

              <div class="tcp-pdp-swatch-wrap" data-finish-name="Dune">
                <span class="tcp-pdp-swatch">
                  <span class="tcp-pdp-swatch__inner" style="background-color: #BFA88F;"></span>
                </span>
                <span class="tcp-pdp-swatch__name">Dune</span>
              </div>

              <div class="tcp-pdp-swatch-wrap" data-finish-name="Stone">
                <span class="tcp-pdp-swatch">
                  <span class="tcp-pdp-swatch__inner" style="background-color: #9E8E7E;"></span>
                </span>
                <span class="tcp-pdp-swatch__name">Stone</span>
              </div>

              <div class="tcp-pdp-swatch-wrap" data-finish-name="Ash">
                <span class="tcp-pdp-swatch">
                  <span class="tcp-pdp-swatch__inner" style="background-color: #585550;"></span>
                </span>
                <span class="tcp-pdp-swatch__name">Ash</span>
              </div>
            </div>
          </div>

          {% comment %} Quantity Selector {% endcomment %}
          <div class="tcp-pdp-qty-wrap">
            <div class="tcp-pdp-option__label">
              <span>Quantity</span>
            </div>
            <div class="tcp-pdp-qty">
              <button type="button" class="tcp-pdp-qty__btn" id="tcp-qty-minus" aria-label="Decrease quantity">&minus;</button>
              <input type="number" name="quantity" id="tcp-qty-input" value="1" min="1" class="tcp-pdp-qty__input" aria-label="Product quantity">
              <button type="button" class="tcp-pdp-qty__btn" id="tcp-qty-plus" aria-label="Increase quantity">&plus;</button>
            </div>
          </div>

          {% comment %} Add to Cart & Buy Buttons {% endcomment %}
          <div class="tcp-pdp-actions">
            <button type="submit" name="add" class="tcp-pdp-btn-atc" id="tcp-atc-btn">
              ADD TO CART &mdash; <span id="tcp-atc-price">{{ product.selected_or_first_available_variant.price | default: 125000 | money }}</span>
            </button>

            {% if section.settings.show_buy_now %}
              <button type="button" class="tcp-pdp-btn-buy" id="tcp-buy-now-btn">
                BUY IT NOW
              </button>
            {% endif %}
          </div>
        {% endform %}

        {% comment %} Wishlist Action {% endcomment %}
        <div>
          <button type="button" class="tcp-pdp-wishlist-link" id="tcp-wishlist-toggle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
            <span>Add to Wishlist</span>
          </button>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  (function() {
    function initPdpMain(sectionEl) {
      if (!sectionEl) return;

      // Gallery Thumbnails
      const thumbs = sectionEl.querySelectorAll('.tcp-pdp-gallery__thumb-item');
      const mainImg = sectionEl.querySelector('.tcp-pdp-gallery__main-img');

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          thumbs.forEach(t => t.classList.remove('is-active'));
          thumb.classList.add('is-active');
          const largeSrc = thumb.dataset.largeSrc;
          if (largeSrc && mainImg) {
            mainImg.src = largeSrc;
          }
        });
      });

      // Size Pills
      const pills = sectionEl.querySelectorAll('.tcp-pdp-pill');
      const sizeLabel = sectionEl.querySelector('#tcp-selected-size-label');
      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          pills.forEach(p => p.classList.remove('is-active'));
          pill.classList.add('is-active');
          if (sizeLabel) sizeLabel.textContent = pill.dataset.optionValue;
        });
      });

      // Finish Swatches
      const swatches = sectionEl.querySelectorAll('.tcp-pdp-swatch-wrap');
      const finishLabel = sectionEl.querySelector('#tcp-selected-finish-label');
      swatches.forEach((swatch) => {
        swatch.addEventListener('click', () => {
          swatches.forEach(s => s.classList.remove('is-active'));
          swatch.classList.add('is-active');
          if (finishLabel) finishLabel.textContent = swatch.dataset.finishName;
        });
      });

      // Quantity Selector
      const minusBtn = sectionEl.querySelector('#tcp-qty-minus');
      const plusBtn = sectionEl.querySelector('#tcp-qty-plus');
      const qtyInput = sectionEl.querySelector('#tcp-qty-input');

      if (minusBtn && plusBtn && qtyInput) {
        minusBtn.addEventListener('click', () => {
          let val = parseInt(qtyInput.value, 10) || 1;
          if (val > 1) qtyInput.value = val - 1;
        });
        plusBtn.addEventListener('click', () => {
          let val = parseInt(qtyInput.value, 10) || 1;
          qtyInput.value = val + 1;
        });
      }

      // Wishlist Toggle
      const wishlistBtn = sectionEl.querySelector('#tcp-wishlist-toggle');
      if (wishlistBtn) {
        wishlistBtn.addEventListener('click', () => {
          const svg = wishlistBtn.querySelector('svg');
          const span = wishlistBtn.querySelector('span');
          if (svg.getAttribute('fill') === 'currentColor') {
            svg.setAttribute('fill', 'none');
            span.textContent = 'Add to Wishlist';
          } else {
            svg.setAttribute('fill', 'currentColor');
            svg.style.color = '#A6732E';
            span.textContent = 'Saved in Wishlist';
          }
        });
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.tcp-pdp-main-section').forEach(initPdpMain);
    });

    document.addEventListener('shopify:section:load', (e) => {
      const sec = e.target.querySelector('.tcp-pdp-main-section');
      if (sec) initPdpMain(sec);
    });
  })();
</script>

{% schema %}
{
  "name": "TCP PDP — Main Product",
  "tag": "section",
  "class": "tcp-pdp-main-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Collection Eyebrow Text",
      "default": "PUSHPA COLLECTION"
    },
    {
      "type": "text",
      "id": "tax_note",
      "label": "Tax Disclaimer",
      "default": "Inclusive of all taxes"
    },
    {
      "type": "text",
      "id": "default_collection_name",
      "label": "Fallback Collection Name in Breadcrumb",
      "default": "Pushpa Collection"
    },
    {
      "type": "checkbox",
      "id": "show_buy_now",
      "label": "Show 'Buy It Now' Button",
      "default": true
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1200,
      "max": 1600,
      "step": 40,
      "unit": "px",
      "label": "Max Container Width",
      "default": 1440
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "TCP PDP — Main Product"
    }
  ]
}
{% endschema %}
