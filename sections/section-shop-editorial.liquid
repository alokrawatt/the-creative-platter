    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #2D2A27;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s ease, gap 0.2s ease;
  }

  .tcp-gifting-content__link:hover {
    color: #A6732E;
    gap: 12px;
  }

  .tcp-gifting-features {
    display: flex;
    gap: 28px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid #E5DFD6;
  }

  @media (max-width: 600px) {
    .tcp-gifting-features {
      flex-direction: column;
      gap: 16px;
    }
  }

  .tcp-gifting-feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
  }

  .tcp-gifting-feature__icon {
    width: 28px;
    height: 28px;
    color: #A6732E;
    flex-shrink: 0;
  }

  .tcp-gifting-feature__text {
    font-family: var(--font-sans, sans-serif);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: #545454;
    line-height: 1.3;
  }

  /* ── 8. Dark Closing Statement Banner ── */
  .tcp-closing-banner {
    background: #25221F;
    color: #FFFFFF;
    padding: 50px 30px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .tcp-closing-banner__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    position: relative;
    z-index: 2;
  }

  .tcp-closing-banner__text {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(24px, 3.5vw, 38px);
    font-weight: 400;
    color: #FFFFFF;
    margin: 0;
    letter-spacing: -0.2px;
  }

  .tcp-closing-banner__btn {
    background: #A6732E;
    color: #FFFFFF;
    padding: 13px 30px;
    font-family: var(--font-sans, sans-serif);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .tcp-closing-banner__btn:hover {
    background: #8C5F22;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(166, 115, 46, 0.3);
  }

  /* ── 9. Trust Badges Strip ── */
  .tcp-trust-strip {
    padding: 32px 0;
    background: #FFFFFF;
    border-top: 1px solid #ECE7DF;
    border-bottom: 1px solid #ECE7DF;
  }

  .tcp-trust-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .tcp-trust-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 500px) {
    .tcp-trust-grid {
      grid-template-columns: 1fr;
    }
  }

  .tcp-trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tcp-trust-icon {
    width: 20px;
    height: 20px;
    color: #545454;
    flex-shrink: 0;
  }

  .tcp-trust-title {
    font-family: var(--font-sans, sans-serif);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #545454;
    line-height: 1.2;
  }

  .tcp-trust-sub {
    font-family: var(--font-sans, sans-serif);
    font-size: 9.5px;
    color: #8E8981;
    line-height: 1.2;
  }
</style>

