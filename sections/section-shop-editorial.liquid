          <!-- Step 3: Shaped by Hand -->
          <div class="tcp-craft-card">
            <div class="tcp-craft-card__img-wrap">
              {% if section.settings.craft_3_image != blank %}
                <img src="{{ section.settings.craft_3_image | image_url: width: 500 }}" alt="Shaped by Hand" class="tcp-craft-card__img" loading="lazy">
              {% else %}
                <img src="https://images.unsplash.com/photo-1565193566173-7a0ee3dbe261?q=80&w=500&auto=format&fit=crop" alt="Shaped by Hand" class="tcp-craft-card__img" loading="lazy">
              {% endif %}
            </div>
            <p class="tcp-craft-card__title">{{ section.settings.craft_3_title | default: 'Shaped by Hand' }}</p>
          </div>

          <!-- Step 4: Fired to Perfection -->
          <div class="tcp-craft-card">
            <div class="tcp-craft-card__img-wrap">
              {% if section.settings.craft_4_image != blank %}
                <img src="{{ section.settings.craft_4_image | image_url: width: 500 }}" alt="Fired to Perfection" class="tcp-craft-card__img" loading="lazy">
              {% else %}
                <img src="https://images.unsplash.com/photo-1513836279014-a89f7a76ae86?q=80&w=500&auto=format&fit=crop" alt="Fired to Perfection" class="tcp-craft-card__img" loading="lazy">
              {% endif %}
            </div>
            <p class="tcp-craft-card__title">{{ section.settings.craft_4_title | default: 'Fired to Perfection' }}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. "On Your Table" — Full-Width Image Overlay -->
  <section class="tcp-table-showcase">
    {% if section.settings.showcase_image != blank %}
      <img src="{{ section.settings.showcase_image | image_url: width: 2000 }}" alt="On Your Table" class="tcp-table-showcase__bg" loading="lazy">
    {% else %}
      <img src="https://images.unsplash.com/photo-1615865417491-9941019fbc00?q=80&w=2000&auto=format&fit=crop" alt="On Your Table" class="tcp-table-showcase__bg" loading="lazy">
    {% endif %}

    <div class="tcp-table-showcase__content">
      <h3 class="tcp-table-showcase__title">{{ section.settings.showcase_title | default: 'On Your Table' }}</h3>
      <div class="tcp-table-showcase__bar"></div>
      <p class="tcp-table-showcase__desc">{{ section.settings.showcase_desc | default: 'Designed to be used. Loved. Lived with.' }}</p>
      {% if section.settings.showcase_link_text != blank %}
        <a href="{{ section.settings.showcase_link_url | default: '/pages/story' }}" class="tcp-table-showcase__link">
          {{ section.settings.showcase_link_text }} &rarr;
        </a>
      {% endif %}
    </div>
  </section>

  <!-- 7. Gifting — Edge-to-Edge 50/50 Split -->
  <section class="tcp-gifting-section">
    <div class="tcp-gifting-grid">
      <div class="tcp-gifting-photo__wrap">
        {% if section.settings.gifting_image != blank %}
          <img src="{{ section.settings.gifting_image | image_url: width: 1200 }}" alt="Gifting Pushpa Dinnerware" class="tcp-gifting-photo" loading="lazy">
        {% else %}
          <img src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?q=80&w=1200&auto=format&fit=crop" alt="Gifting Pushpa Dinnerware" class="tcp-gifting-photo" loading="lazy">
        {% endif %}
      </div>

      <div class="tcp-gifting-content">
        <h2 class="tcp-gifting-content__title">{{ section.settings.gifting_title | default: 'Gifting' }}</h2>
        <div class="tcp-gifting-content__bar"></div>
        <p class="tcp-gifting-content__desc">{{ section.settings.gifting_desc | default: 'Not just a gift. A gesture that stays.' }}</p>
        {% if section.settings.gifting_link_text != blank %}
          <a href="{{ section.settings.gifting_link_url | default: '/collections/gifting' }}" class="tcp-gifting-content__link">
            {{ section.settings.gifting_link_text }} &rarr;
          </a>
        {% endif %}

        <div class="tcp-gifting-features">
          <div class="tcp-gifting-feature">
            <svg class="tcp-gifting-feature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M12 8v13M3 13h18"/><path d="M7.5 4a2.5 2.5 0 015 0c0 1.5-2.5 4-2.5 4s-2.5-2.5-2.5-4z"/><path d="M16.5 4a2.5 2.5 0 00-5 0c0 1.5 2.5 4 2.5 4s2.5-2.5 2.5-4z"/></svg>
            <span class="tcp-gifting-feature__text">Thoughtful<br>Packaging</span>
          </div>
          <div class="tcp-gifting-feature">
            <svg class="tcp-gifting-feature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
            <span class="tcp-gifting-feature__text">Gift Note<br>Available</span>
          </div>
          <div class="tcp-gifting-feature">
            <svg class="tcp-gifting-feature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <span class="tcp-gifting-feature__text">Nationwide<br>Delivery</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Dark Closing Statement Banner -->
  <section class="tcp-closing-banner">
    <div class="tcp-closing-banner__inner">
      <h3 class="tcp-closing-banner__text">{{ section.settings.closing_title | default: 'Bring Pushpa to your table.' }}</h3>
      {% if section.settings.closing_btn_text != blank %}
