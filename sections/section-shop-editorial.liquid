{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Editorial Shop Experience Page
  ============================================================
  Refined Luxury Ceramic & Tableware Shop Experience:
  1. Full Hero Background with elegant semi-transparent text treatment
  2. Compact "Our Signature Dinner Sets" Grid (all 5 sets visible in single viewport view)
  3. Redesigned "Build Your Table" Swatch Cards with Step Pills & Micro-interactions
  4. Modernized, compact glassmorphic "On Your Table" Showcase Card
  5. Material & Craft 4-step photographic craft journey
  6. Gifting partition (50/50 Furoshiki package + Gifting story)
  7. Dark closing statement banner
  8. Trust & Values strip
  Pure White (#FFFFFF) background with #545454 and #fcce3a brand colors.
{% endcomment %}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Raleway:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Sacramento&display=swap" rel="stylesheet">

<style>
  .tcp-shop-page {
    background-color: #FFFFFF !important;
    color: #545454;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  .tcp-shop-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media (max-width: 768px) {
    .tcp-shop-container {
      padding: 0 20px;
    }
  }

  /* ── 1. Full Background Hero Section ── */
  .tcp-shop-hero {
    position: relative;
    min-height: 600px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #1a1815;
  }

  .tcp-shop-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
    opacity: 1;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tcp-shop-hero:hover .tcp-shop-hero__bg {
    transform: scale(1.02);
  }

  .tcp-shop-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.35) 45%, rgba(0, 0, 0, 0.05) 100%);
    z-index: 2;
    pointer-events: none;
  }

  @media (max-width: 800px) {
    .tcp-shop-hero {
      min-height: 500px;
    }
    .tcp-shop-hero__overlay {
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.3) 60%, rgba(0, 0, 0, 0.1) 100%);
    }
  }

  .tcp-shop-hero .tcp-shop-container {
    width: 100%;
    display: flex;
    justify-content: flex-start;
  }

  .tcp-shop-hero__content {
    position: relative;
    z-index: 3;
    max-width: 540px;
    padding: 80px 0;
    text-align: left;
    margin-right: auto;
    margin-left: 0;
  }

  .tcp-shop-hero__pill {
    display: inline-block;
    font-family: var(--font-brand, 'Raleway', sans-serif);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: #fcce3a;
    margin-bottom: 14px;
    text-align: left;
  }

  .tcp-shop-hero__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(52px, 6.5vw, 84px);
    font-weight: 400;
    line-height: 0.92;
    color: #FFFFFF;
    margin: 0 0 4px;
    letter-spacing: -0.5px;
    text-align: left;
  }

  .tcp-shop-hero__title span.dot {
    color: #fcce3a;
  }

  .tcp-shop-hero__script {
    font-family: var(--font-script, 'Sacramento', cursive);
    font-size: clamp(30px, 4vw, 44px);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.15;
    display: block;
    margin-bottom: 18px;
    text-align: left;
  }

  .tcp-shop-hero__desc {
    font-family: var(--font-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 19px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
    max-width: 440px;
    margin: 0 0 30px;
    text-align: left;
  }

  .tcp-shop-hero__actions {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 20px;
    flex-wrap: wrap;
  }

  .tcp-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #A6732E;
    color: #FFFFFF;
    padding: 13px 28px;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(166, 115, 46, 0.2);
  }

  .tcp-btn-primary:hover {
    background: #8C5F22;
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(166, 115, 46, 0.3);
  }

  .tcp-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    padding: 6px 0;
    position: relative;
    transition: color 0.2s ease;
  }

  .tcp-btn-secondary:hover {
    color: #fcce3a;
  }

  /* ── 2. Philosophy Quote Banner ── */
  .tcp-philosophy-banner {
    padding: 48px 20px;
    text-align: center;
    background: #FFFFFF;
    border-top: 1px solid #F0ECE6;
    border-bottom: 1px solid #F0ECE6;
  }

  .tcp-philosophy-text {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(20px, 2.6vw, 30px);
    font-weight: 400;
    line-height: 1.5;
    color: #383431;
    max-width: 800px;
    margin: 0 auto 16px;
    letter-spacing: -0.2px;
  }

  .tcp-philosophy-emblem {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .tcp-philosophy-emblem svg {
    width: 26px;
    height: 26px;
    color: #fcce3a;
  }

  /* ── 3. Signature Dinner Sets — Editorial Side-by-Side ── */
  .tcp-sets-section {
    padding: 80px 0;
    background: #FFFFFF;
    border-bottom: 1px solid #F2EFEA;
  }

  .tcp-sets-emblem {
    display: flex;
    justify-content: center;
    margin-bottom: 50px;
  }

  .tcp-sets-emblem svg {
    width: 30px;
    height: 30px;
    color: #A6732E;
    opacity: 0.7;
  }

  .tcp-editorial-split {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 50px;
    align-items: start;
  }

  @media (max-width: 1024px) {
    .tcp-editorial-split {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .tcp-editorial-split--side {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 50px;
    align-items: center;
  }

  @media (max-width: 1024px) {
    .tcp-editorial-split--side {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  .tcp-editorial-info {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding-top: 10px;
  }

  .tcp-editorial-info__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(28px, 3.2vw, 38px);
    font-weight: 400;
    line-height: 1.15;
    color: #2D2A27;
    margin: 0 0 16px;
  }

  .tcp-editorial-info__bar {
    width: 32px;
    height: 1.5px;
    background: #A6732E;
    margin-bottom: 16px;
  }

  .tcp-editorial-info__desc {
    font-family: var(--font-sans, sans-serif);
    font-size: 13.5px;
    line-height: 1.65;
    color: #5C5650;
    margin: 0 0 28px;
  }

  .tcp-editorial-info__link {
    font-family: var(--font-sans, sans-serif);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #2D2A27;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s ease, gap 0.2s ease;
  }

  .tcp-editorial-info__link:hover {
    color: #A6732E;
    gap: 12px;
  }

  /* 2-Row Mosaic Grid */
  .tcp-sets-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    grid-template-rows: 240px 240px;
    gap: 12px;
  }

  @media (max-width: 900px) {
    .tcp-sets-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 200px 200px 200px;
    }
  }

  @media (max-width: 600px) {
    .tcp-sets-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
    .tcp-sets-grid .tcp-set-card {
      min-height: 240px;
    }
  }

  .tcp-set-card {
    position: relative;
    background: #C8BFB5;
    overflow: hidden;
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 3px;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .tcp-set-card--feature {
    grid-column: 1 / 2;
    grid-row: 1 / 3;
    height: 100%;
  }

  @media (max-width: 900px) {
    .tcp-set-card--feature {
      grid-column: 1 / -1;
      height: 280px;
    }
  }

  .tcp-set-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .tcp-set-card__img-wrap {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
  }

  .tcp-set-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .tcp-set-card:hover .tcp-set-card__img {
    transform: scale(1.04);
  }

  .tcp-set-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(20, 18, 16, 0.6) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 18px 20px;
    color: #FFFFFF;
  }

  .tcp-set-card__name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 22px;
    font-weight: 500;
    color: #FFFFFF;
    margin: 0 0 3px;
    line-height: 1.1;
  }

  .tcp-set-card--feature .tcp-set-card__name {
    font-size: 28px;
  }

  .tcp-set-card__tagline {
    font-family: var(--font-sans, sans-serif);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.5px;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
  }

  /* ── 4. Build Your Table — Clean Editorial ── */
  .tcp-build-section {
    padding: 70px 0;
    background: #FFFFFF;
    border-bottom: 1px solid #F2EFEA;
    position: relative;
  }

  .tcp-build-layout {
    display: grid;
    grid-template-columns: 195px 1fr;
    gap: 36px;
    align-items: center;
  }

  .tcp-build-info {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding-right: 8px;
  }

  .tcp-build-info__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(26px, 2.5vw, 34px);
    font-weight: 400;
    line-height: 1.15;
    color: #2D2A27;
    margin: 0 0 12px;
  }

  .tcp-build-info__bar {
    width: 32px;
    height: 1.5px;
    background: #A6732E;
    margin-bottom: 12px;
  }

  .tcp-build-info__desc {
    font-family: var(--font-sans, sans-serif);
    font-size: 13px;
    line-height: 1.6;
    color: #5C5650;
    margin: 0 0 20px;
  }

  .tcp-build-info__link {
    font-family: var(--font-sans, sans-serif);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #2D2A27;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s ease, gap 0.2s ease;
  }

  .tcp-build-info__link:hover {
    color: #A6732E;
    gap: 12px;
  }

  .tcp-formula-wrapper {
    width: 100%;
    min-width: 0;
  }

  .tcp-formula-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 6px;
    width: 100%;
  }

  .tcp-formula-item {
    flex: 1;
    text-align: left;
    min-width: 0;
    padding: 0 2px;
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform 0.3s ease;
  }

  .tcp-formula-item:hover {
    transform: translateY(-2px);
  }

  .tcp-formula-item__img-wrap {
    width: 100%;
    aspect-ratio: 1.1 / 1;
    overflow: hidden;
    margin-bottom: 10px;
    border-radius: 4px;
    background: #F6F3EE;
    position: relative;
    box-shadow: 0 2px 8px rgba(45, 42, 39, 0.04);
    border: 1px solid rgba(220, 215, 205, 0.5);
  }

  .tcp-formula-item__step-badge {
    position: absolute;
    top: 6px;
    left: 6px;
    font-family: var(--font-sans, sans-serif);
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #2D2A27;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(4px);
    padding: 2px 6px;
    border-radius: 3px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    z-index: 2;
  }

  .tcp-formula-item__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .tcp-formula-item:hover .tcp-formula-item__img {
    transform: scale(1.04);
  }

  .tcp-formula-item__title {
    font-family: var(--font-sans, sans-serif);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.8px;
    color: #545454;
    margin: 0 0 2px;
    white-space: normal;
    word-break: normal;
    line-height: 1.3;
  }

  .tcp-formula-item__sub {
    font-family: var(--font-sans, sans-serif);
    font-size: 10.5px;
    font-weight: 400;
    letter-spacing: 0.3px;
    color: #8E8981;
    margin: 0;
    white-space: normal;
    word-break: normal;
    line-height: 1.3;
  }

  .tcp-formula-symbol {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 22px;
    font-weight: 300;
    color: #B5AFA7;
    flex-shrink: 0;
    width: 16px;
    height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 42px;
    user-select: none;
  }

  .tcp-formula-hint {
    display: none;
  }

  /* Tablet & Mobile Breakpoints */
  @media (max-width: 900px) {
    .tcp-build-section {
      padding: 50px 0;
    }

    .tcp-build-layout {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .tcp-formula-wrapper {
      position: relative;
    }

    .tcp-formula-row {
      display: flex;
      flex-wrap: nowrap;
      align-items: flex-start;
      gap: 10px;
      width: 100%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding: 4px 4px 14px 4px;
      margin: 0 -15px;
      padding-left: 15px;
      padding-right: 15px;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .tcp-formula-row::-webkit-scrollbar {
      display: none;
    }

    .tcp-formula-item {
      flex: 0 0 145px;
      width: 145px;
      min-width: 145px;
      scroll-snap-align: start;
      padding: 0;
    }

    .tcp-formula-item__img-wrap {
      min-height: 130px;
      margin-bottom: 10px;
    }

    .tcp-formula-item__title {
      font-size: 12px;
      white-space: normal;
    }

    .tcp-formula-item__sub {
      font-size: 10.5px;
      white-space: normal;
    }

    .tcp-formula-symbol {
      flex: 0 0 18px;
      width: 18px;
      font-size: 22px;
      margin-top: 55px;
      display: flex;
    }

    .tcp-formula-hint {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-sans, sans-serif);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #A6732E;
      margin-top: 4px;
    }

    .tcp-formula-hint svg {
      width: 12px;
      height: 12px;
      animation: swipeBounce 1.5s infinite ease-in-out;
    }

    @keyframes swipeBounce {
      0%, 100% { transform: translateX(0); }
      50% { transform: translateX(4px); }
    }
  }

  @media (max-width: 480px) {
    .tcp-formula-item {
      flex: 0 0 135px;
      width: 135px;
      min-width: 135px;
    }

    .tcp-formula-item__img-wrap {
      min-height: 120px;
    }

    .tcp-formula-symbol {
      flex: 0 0 14px;
      width: 14px;
      font-size: 20px;
      margin-top: 50px;
    }
  }

  /* ── 5. Material & Craft Strip ── */
  .tcp-craft-section {
    padding: 65px 0;
    background: #FFFFFF;
  }

  .tcp-craft-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  @media (max-width: 900px) {
    .tcp-craft-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .tcp-craft-card {
    text-align: left;
  }

  .tcp-craft-card__img-wrap {
    width: 100%;
    aspect-ratio: 1.1 / 1;
    overflow: hidden;
    background: #F6F3EE;
    border-radius: 4px;
    margin-bottom: 10px;
  }

  .tcp-craft-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .tcp-craft-card:hover .tcp-craft-card__img {
    transform: scale(1.04);
  }

  .tcp-craft-card__title {
    font-family: var(--font-sans, sans-serif);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.8px;
    color: #545454;
    margin: 0;
  }

  /* ── 6. "On Your Table" — Full-Width Image with Direct Text Overlay ── */
  .tcp-table-showcase {
    position: relative;
    width: 100%;
    min-height: 450px;
    background: #2D2A27;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .tcp-table-showcase__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.85;
  }

  .tcp-table-showcase__content {
    position: relative;
    z-index: 2;
    padding: 60px;
    max-width: 380px;
    color: #FFFFFF;
  }

  @media (max-width: 768px) {
    .tcp-table-showcase {
      min-height: 380px;
    }
    .tcp-table-showcase__content {
      padding: 40px 24px;
      max-width: 300px;
    }
  }

  .tcp-table-showcase__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(28px, 3.5vw, 38px);
    font-weight: 400;
    color: #FFFFFF;
    margin: 0 0 12px;
    line-height: 1.15;
  }

  .tcp-table-showcase__bar {
    width: 30px;
    height: 1.5px;
    background: #A6732E;
    margin-bottom: 14px;
  }

  .tcp-table-showcase__desc {
    font-family: var(--font-sans, sans-serif);
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 22px;
  }

  .tcp-table-showcase__link {
    font-family: var(--font-sans, sans-serif);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #FFFFFF;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s ease, gap 0.2s ease;
  }

  .tcp-table-showcase__link:hover {
    color: #fcce3a;
    gap: 12px;
  }

  /* ── 7. Gifting — Edge-to-Edge 50/50 Split ── */
  .tcp-gifting-section {
    padding: 0;
    background: #FFFFFF;
  }

  .tcp-gifting-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: stretch;
    min-height: 480px;
  }

  @media (max-width: 900px) {
    .tcp-gifting-grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }
  }

  .tcp-gifting-photo__wrap {
    width: 100%;
    height: 100%;
    min-height: 400px;
    overflow: hidden;
    background: #E8E0D6;
  }

  .tcp-gifting-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .tcp-gifting-photo__wrap:hover .tcp-gifting-photo {
    transform: scale(1.03);
  }

  .tcp-gifting-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px 50px;
    background: #FAF7F2;
  }

  @media (max-width: 900px) {
    .tcp-gifting-content {
      padding: 40px 24px;
    }
  }

  .tcp-gifting-content__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(28px, 3.5vw, 38px);
    font-weight: 400;
    color: #2D2A27;
    margin: 0 0 12px;
  }

  .tcp-gifting-content__bar {
    width: 30px;
    height: 1.5px;
    background: #A6732E;
    margin-bottom: 16px;
  }

  .tcp-gifting-content__desc {
    font-family: var(--font-sans, sans-serif);
    font-size: 14px;
    color: #5C5650;
    line-height: 1.55;
    margin: 0 0 24px;
  }

  .tcp-gifting-content__link {
    font-family: var(--font-sans, sans-serif);
