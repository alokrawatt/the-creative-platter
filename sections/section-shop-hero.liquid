{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Shop Hero Section
  ============================================================
{% endcomment %}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Raleway:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Sacramento&display=swap" rel="stylesheet">

<style>
  .tcp-shop-hero {
    position: relative;
    min-height: 600px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #1a1815;
  }

  .tcp-shop-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
    opacity: 1;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tcp-shop-hero:hover .tcp-shop-hero__bg {
    transform: scale(1.02);
  }

  .tcp-shop-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.35) 45%, rgba(0, 0, 0, 0.05) 100%);
    z-index: 2;
    pointer-events: none;
  }

  @media (max-width: 800px) {
    .tcp-shop-hero {
      min-height: 500px;
    }
    .tcp-shop-hero__overlay {
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.3) 60%, rgba(0, 0, 0, 0.1) 100%);
    }
  }

  .tcp-shop-hero__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    width: 100%;
    display: flex;
    justify-content: flex-start;
  }

  @media (max-width: 768px) {
    .tcp-shop-hero__container {
      padding: 0 20px;
    }
  }

  .tcp-shop-hero__content {
    position: relative;
    z-index: 3;
    max-width: 540px;
    padding: 80px 0;
    text-align: left;
    margin-right: auto;
    margin-left: 0;
  }

  .tcp-shop-hero__pill {
    display: inline-block;
    font-family: var(--font-brand, 'Raleway', sans-serif);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: #fcce3a;
    margin-bottom: 14px;
    text-align: left;
  }

  .tcp-shop-hero__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(52px, 6.5vw, 84px);
    font-weight: 400;
    line-height: 0.92;
    color: #FFFFFF;
    margin: 0 0 4px;
    letter-spacing: -0.5px;
    text-align: left;
  }

  .tcp-shop-hero__title span.dot {
    color: #fcce3a;
  }

  .tcp-shop-hero__script {
    font-family: var(--font-script, 'Sacramento', cursive);
    font-size: clamp(30px, 4vw, 44px);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.15;
    display: block;
    margin-bottom: 18px;
    text-align: left;
  }

  .tcp-shop-hero__desc {
    font-family: var(--font-serif, 'Cormorant Garamond', Georgia, serif);
    font-size: 19px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
    max-width: 440px;
    margin: 0 0 30px;
    text-align: left;
  }

  .tcp-shop-hero__actions {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 20px;
    flex-wrap: wrap;
  }

  .tcp-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #A6732E;
    color: #FFFFFF;
    padding: 13px 28px;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(166, 115, 46, 0.2);
  }

  .tcp-btn-primary:hover {
    background: #8C5F22;
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(166, 115, 46, 0.3);
  }

  .tcp-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    padding: 6px 0;
    position: relative;
    transition: color 0.2s ease;
  }

  .tcp-btn-secondary:hover {
    color: #fcce3a;
  }
</style>

<section class="tcp-shop-hero" id="tcp-shop-hero-root">
  {% if section.settings.hero_image != blank %}
    <img
      src="{{ section.settings.hero_image | image_url: width: 2200 }}"
      alt="{{ section.settings.hero_image.alt | default: 'Pushpa Legacy Tableware Collection' | escape }}"
      class="tcp-shop-hero__bg"
      loading="eager"
    >
  {% else %}
    <img
      src="https://images.unsplash.com/photo-1610701596007-11502861dcfa?q=80&w=2200&auto=format&fit=crop"
      alt="Pushpa Legacy Dinner Sets"
      class="tcp-shop-hero__bg"
      loading="eager"
    >
  {% endif %}

  <div class="tcp-shop-hero__overlay"></div>

  <div class="tcp-shop-hero__container">
    <div class="tcp-shop-hero__content">
      <span class="tcp-shop-hero__pill">{{ section.settings.hero_pill | default: 'THE LEGACY COLLECTION' }}</span>
      <h1 class="tcp-shop-hero__title">
        {{ section.settings.hero_title | default: 'Pushpa' }}<span class="dot">.</span>
      </h1>
      <span class="tcp-shop-hero__script">{{ section.settings.hero_script | default: 'The Legacy Collection' }}</span>
      <p class="tcp-shop-hero__desc">
        {{ section.settings.hero_desc | default: 'Crafted in memory. Made for your home.' }}
      </p>
      <div class="tcp-shop-hero__actions">
        {% if section.settings.hero_btn_text != blank %}
          <a href="{{ section.settings.hero_btn_url | default: '/collections/all' }}" class="tcp-btn-primary">
            {{ section.settings.hero_btn_text }} &rarr;
          </a>
        {% endif %}
        {% if section.settings.hero_link_text != blank %}
          <a href="{{ section.settings.hero_link_url | default: '#build-table' }}" class="tcp-btn-secondary">
            {{ section.settings.hero_link_text }} &rarr;
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop — Hero Section",
  "tag": "section",
  "class": "tcp-shop-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    },
    {
      "type": "text",
      "id": "hero_pill",
      "label": "Hero Pill Text",
      "default": "THE LEGACY COLLECTION"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Pushpa"
    },
    {
      "type": "text",
      "id": "hero_script",
      "label": "Hero Script Subtitle",
      "default": "The Legacy Collection"
    },
    {
      "type": "textarea",
      "id": "hero_desc",
      "label": "Hero Description",
      "default": "Crafted in memory. Made for your home."
    },
    {
      "type": "text",
      "id": "hero_btn_text",
      "label": "Hero Primary Button Text",
      "default": "SHOP THE COLLECTION"
    },
    {
      "type": "url",
      "id": "hero_btn_url",
      "label": "Hero Primary Button URL"
    },
    {
      "type": "text",
      "id": "hero_link_text",
      "label": "Hero Secondary Link Text",
      "default": "DESIGN YOUR SET"
    },
    {
      "type": "url",
      "id": "hero_link_url",
      "label": "Hero Secondary Link URL"
    }
  ],
  "presets": [
    {
      "name": "Shop — Hero Section"
    }
  ]
}
{% endschema %}
