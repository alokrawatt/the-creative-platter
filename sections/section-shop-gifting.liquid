{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Shop Gifting Section
  ============================================================
{% endcomment %}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Raleway:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet">

<style>
  .tcp-gifting-section {
    padding: 0;
    background: #FAF8F5;
    border-bottom: 1px solid #EFEAE3;
    overflow: hidden;
  }

  .tcp-gifting-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: stretch;
  }

  @media (max-width: 900px) {
    .tcp-gifting-grid {
      grid-template-columns: 1fr;
    }
  }

  .tcp-gifting-photo__wrap {
    width: 100%;
    height: 100%;
    min-height: 520px;
    overflow: hidden;
    position: relative;
    background: #EDE9E3;
  }

  @media (max-width: 900px) {
    .tcp-gifting-photo__wrap {
      min-height: 360px;
    }
  }

  .tcp-gifting-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tcp-gifting-photo__wrap:hover .tcp-gifting-photo {
    transform: scale(1.03);
  }

  .tcp-gifting-content {
    padding: 80px 80px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (max-width: 1024px) {
    .tcp-gifting-content {
      padding: 50px 40px;
    }
  }

  @media (max-width: 600px) {
    .tcp-gifting-content {
      padding: 40px 20px;
    }
  }

  .tcp-gifting-content__pill {
    display: inline-block;
    font-family: var(--font-brand, 'Raleway', sans-serif);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: #A6732E;
    margin-bottom: 12px;
  }

  .tcp-gifting-content__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(32px, 3.8vw, 44px);
    font-weight: 400;
    line-height: 1.12;
    color: #2D2A27;
    margin: 0 0 14px;
    letter-spacing: -0.3px;
  }

  .tcp-gifting-content__bar {
    width: 32px;
    height: 1.5px;
    background: #A6732E;
    margin-bottom: 18px;
  }

  .tcp-gifting-content__desc {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 14px;
    line-height: 1.7;
    color: #5C5650;
    max-width: 460px;
    margin: 0 0 32px;
  }

  .tcp-gifting-content__btn {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    background: #2D2A27;
    color: #FFFFFF;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 28px;
    border-radius: 2px;
    box-shadow: 0 4px 14px rgba(45, 42, 39, 0.15);
    margin-bottom: 40px;
    align-self: flex-start;
    transition: all 0.3s ease;
  }

  .tcp-gifting-content__btn:hover {
    background: #A6732E;
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(166, 115, 46, 0.35);
  }

  .tcp-gifting-features {
    display: flex;
    gap: 32px;
    padding-top: 28px;
    border-top: 1px solid #E5DFD5;
  }

  @media (max-width: 600px) {
    .tcp-gifting-features {
      flex-direction: column;
      gap: 18px;
    }
  }

  .tcp-gifting-feature {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tcp-gifting-feature__icon-wrap {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(166, 115, 46, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .tcp-gifting-feature__icon {
    width: 18px;
    height: 18px;
    color: #A6732E;
  }

  .tcp-gifting-feature__text {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: #545454;
    line-height: 1.3;
  }
</style>

<section class="tcp-gifting-section" id="tcp-gifting-root">
  <div class="tcp-gifting-grid">
    <div class="tcp-gifting-photo__wrap">
      {% if section.settings.gifting_image != blank %}
        <img src="{{ section.settings.gifting_image | image_url: width: 1400 }}" alt="{{ section.settings.gifting_title | default: 'Gifting' | escape }}" class="tcp-gifting-photo" loading="lazy">
      {% else %}
        <img src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?q=80&w=1400&auto=format&fit=crop" alt="Gifting Pushpa Dinnerware" class="tcp-gifting-photo" loading="lazy">
      {% endif %}
    </div>

    <div class="tcp-gifting-content">
      <span class="tcp-gifting-content__pill">{{ section.settings.gifting_pill | default: 'SIGNATURE GIFT RITUALS' }}</span>
      <h2 class="tcp-gifting-content__title">{{ section.settings.gifting_title | default: 'Gifting' }}</h2>
      <div class="tcp-gifting-content__bar"></div>
      <p class="tcp-gifting-content__desc">{{ section.settings.gifting_desc | default: 'Not just a gift. A gesture that stays. Every set arrives in bespoke zero-waste packaging with hand-penned care notes.' }}</p>
      {% if section.settings.gifting_link_text != blank %}
        <a href="{{ section.settings.gifting_link_url | default: '/collections/gifting' }}" class="tcp-gifting-content__btn">
          {{ section.settings.gifting_link_text }} &rarr;
        </a>
      {% endif %}

      <div class="tcp-gifting-features">
        <div class="tcp-gifting-feature">
          <div class="tcp-gifting-feature__icon-wrap">
            <svg class="tcp-gifting-feature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M12 8v13M3 13h18"/><path d="M7.5 4a2.5 2.5 0 015 0c0 1.5-2.5 4-2.5 4s-2.5-2.5-2.5-4z"/><path d="M16.5 4a2.5 2.5 0 00-5 0c0 1.5 2.5 4 2.5 4s2.5-2.5 2.5-4z"/></svg>
          </div>
          <span class="tcp-gifting-feature__text">Thoughtful<br>Packaging</span>
        </div>
        <div class="tcp-gifting-feature">
          <div class="tcp-gifting-feature__icon-wrap">
            <svg class="tcp-gifting-feature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          </div>
          <span class="tcp-gifting-feature__text">Custom Gift Note<br>Available</span>
        </div>
        <div class="tcp-gifting-feature">
          <div class="tcp-gifting-feature__icon-wrap">
            <svg class="tcp-gifting-feature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <span class="tcp-gifting-feature__text">Pan-India &amp; Global<br>Insured Delivery</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop — Gifting Partition",
  "tag": "section",
  "class": "tcp-shop-gifting-section",
  "settings": [
    {
      "type": "text",
      "id": "gifting_pill",
      "label": "Eyebrow Pill",
      "default": "SIGNATURE GIFT RITUALS"
    },
    {
      "type": "image_picker",
      "id": "gifting_image",
      "label": "Gifting Photo"
    },
    {
      "type": "text",
      "id": "gifting_title",
      "label": "Heading",
      "default": "Gifting"
    },
    {
      "type": "textarea",
      "id": "gifting_desc",
      "label": "Description",
      "default": "Not just a gift. A gesture that stays. Every set arrives in bespoke zero-waste packaging with hand-penned care notes."
    },
    {
      "type": "text",
      "id": "gifting_link_text",
      "label": "Button Text",
      "default": "EXPLORE GIFTING"
    },
    {
      "type": "url",
      "id": "gifting_link_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Shop — Gifting Partition"
    }
  ]
}
{% endschema %}
