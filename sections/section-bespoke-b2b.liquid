{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Bespoke (B2B) Hospitality Portal
  ============================================================
  Kevala Ceramics inspired full-scale B2B hospitality portal:
  - Commercial tableware for chefs, hotels, and architects
  - Interactive Glaze & Clay Library
  - 6-Stage Custom Ceramic Development Process
  - Technical specs (1280°C vitrification, zero porosity)
  - Interactive Hospitality RFQ & Sample Request Form
  Copy into Shopify: sections/section-bespoke-b2b.liquid
{% endcomment %}

<style>
  .tcp-b2b-page {
    background: var(--tcp-sand, #FBF9F5);
    color: var(--tcp-dark, #1F1D1B);
    font-family: var(--font-sans, sans-serif);
  }

  /* ── Hero ── */
  .tcp-b2b-hero {
    position: relative;
    min-height: 600px;
    display: flex;
    align-items: center;
    background: var(--tcp-dark, #1F1D1B);
    color: var(--tcp-sand, #FBF9F5);
    padding: 80px 0;
    overflow: hidden;
  }

  .tcp-b2b-hero__bg {
    position: absolute;
    inset: 0;
    opacity: 0.35;
  }

  .tcp-b2b-hero__inner {
    position: relative;
    z-index: 2;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .tcp-b2b-hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--tcp-gold-light, #DFBA5E);
    margin-bottom: 24px;
  }

  .tcp-b2b-hero__title {
    font-family: var(--font-serif, serif);
    font-size: clamp(40px, 5vw, 68px);
    font-weight: 400;
    color: #FFFFFF;
    line-height: 1.05;
    margin: 0 0 20px;
  }

  .tcp-b2b-hero__desc {
    font-family: var(--font-sans, sans-serif);
    font-size: 15.5px;
    color: rgba(251, 249, 245, 0.8);
    line-height: 1.8;
    margin-bottom: 36px;
    max-width: 520px;
  }

  .tcp-b2b-hero__ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .tcp-b2b-hero__btn-gold {
    font-family: var(--font-sans, sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--tcp-dark, #1F1D1B);
    background: var(--tcp-gold, #C29B38);
    padding: 16px 32px;
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .tcp-b2b-hero__btn-gold:hover {
    background: #FFFFFF;
    transform: translateY(-2px);
  }

  .tcp-b2b-hero__btn-outline {
    font-family: var(--font-sans, sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #FFFFFF;
    background: transparent;
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    padding: 15px 28px;
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .tcp-b2b-hero__btn-outline:hover {
    border-color: #FFFFFF;
    background: rgba(255, 255, 255, 0.1);
  }

  /* ── Sectors Matrix ── */
  .tcp-b2b-sectors {
    padding: 100px 0;
    max-width: 1440px;
    margin: 0 auto;
    padding-left: 40px;
    padding-right: 40px;
  }

  .tcp-b2b-section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 60px;
  }

  .tcp-b2b-section-label {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--tcp-gold, #C29B38);
    display: block;
    margin-bottom: 8px;
  }

  .tcp-b2b-section-title {
    font-family: var(--font-serif, serif);
    font-size: clamp(34px, 4vw, 48px);
    font-weight: 400;
    color: var(--tcp-dark, #1F1D1B);
    line-height: 1.15;
    margin: 0 0 16px;
  }

  .tcp-b2b-sectors__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  .tcp-b2b-sector-card {
    background: var(--tcp-white, #FFFFFF);
    border: 1px solid var(--tcp-border, #E8E2D8);
    border-radius: 4px;
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    transition: all 0.4s var(--ease-fluid);
  }

  .tcp-b2b-sector-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(31, 29, 27, 0.08);
    border-color: var(--tcp-gold, #C29B38);
  }

  .tcp-b2b-sector-card__icon {
    width: 44px;
    height: 44px;
    color: var(--tcp-gold, #C29B38);
    margin-bottom: 20px;
  }

  .tcp-b2b-sector-card__title {
    font-family: var(--font-serif, serif);
    font-size: 22px;
    font-weight: 600;
    color: var(--tcp-dark, #1F1D1B);
    margin: 0 0 10px;
  }

  .tcp-b2b-sector-card__desc {
    font-size: 13.5px;
    color: var(--tcp-muted, #68625B);
    line-height: 1.7;
    margin: 0;
  }

  /* ── Interactive Glaze & Clay Library (Kevala style) ── */
  .tcp-b2b-glazes {
    background: var(--tcp-white, #FFFFFF);
    padding: 100px 0;
    border-top: 1px solid var(--tcp-border, #E8E2D8);
    border-bottom: 1px solid var(--tcp-border, #E8E2D8);
  }

  .tcp-b2b-glazes__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .tcp-b2b-glazes__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 20px;
    margin-top: 48px;
  }

  .tcp-glaze-card {
    text-align: center;
    cursor: pointer;
  }

  .tcp-glaze-swatch {
    aspect-ratio: 1;
    border-radius: 50%;
    margin: 0 auto 12px;
    box-shadow: 0 6px 16px rgba(31, 29, 27, 0.1);
    border: 3px solid #FFF;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .tcp-glaze-card:hover .tcp-glaze-swatch {
    transform: scale(1.08);
    border-color: var(--tcp-gold, #C29B38);
  }

  .tcp-glaze-name {
    font-family: var(--font-serif, serif);
    font-size: 16px;
    font-weight: 600;
    color: var(--tcp-dark, #1F1D1B);
    display: block;
    margin-bottom: 2px;
  }

  .tcp-glaze-type {
    font-size: 11px;
    color: var(--tcp-muted, #68625B);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* ── 6-Stage Process (Kevala style) ── */
  .tcp-b2b-process {
    padding: 100px 0;
    max-width: 1440px;
    margin: 0 auto;
    padding-left: 40px;
    padding-right: 40px;
  }

  .tcp-b2b-process__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 48px;
  }

  .tcp-process-step {
    background: var(--tcp-white, #FFFFFF);
    border: 1px solid var(--tcp-border, #E8E2D8);
    border-radius: 4px;
    padding: 32px;
    position: relative;
  }

  .tcp-process-step__num {
    font-family: var(--font-serif, serif);
    font-size: 32px;
    font-weight: 600;
    color: var(--tcp-gold, #C29B38);
    line-height: 1;
    margin-bottom: 12px;
    display: block;
  }

  .tcp-process-step__title {
    font-family: var(--font-serif, serif);
    font-size: 20px;
    font-weight: 600;
    color: var(--tcp-dark, #1F1D1B);
    margin: 0 0 8px;
  }

  .tcp-process-step__desc {
    font-size: 13px;
    color: var(--tcp-muted, #68625B);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Interactive RFQ & Sample Request ── */
  .tcp-b2b-rfq {
    background: var(--tcp-dark, #1F1D1B);
    color: var(--tcp-sand, #FBF9F5);
    padding: 100px 0;
  }

  .tcp-b2b-rfq__inner {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .tcp-b2b-rfq__form {
    background: #282420;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 48px;
    margin-top: 40px;
  }

  .tcp-rfq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 24px;
  }

  .tcp-rfq-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tcp-rfq-field label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--tcp-gold-light, #DFBA5E);
  }

  .tcp-rfq-field input,
  .tcp-rfq-field select,
  .tcp-rfq-field textarea {
    background: #1F1D1B;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 12px 16px;
    color: #FFFFFF;
    font-family: var(--font-sans, sans-serif);
    font-size: 14px;
    border-radius: 3px;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .tcp-rfq-field input:focus,
  .tcp-rfq-field select:focus,
  .tcp-rfq-field textarea:focus {
    border-color: var(--tcp-gold, #C29B38);
  }

  .tcp-rfq-submit-btn {
    font-family: var(--font-sans, sans-serif);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--tcp-dark, #1F1D1B);
    background: var(--tcp-gold, #C29B38);
    border: none;
    padding: 16px 36px;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
    margin-top: 12px;
  }

  .tcp-rfq-submit-btn:hover {
    background: #FFFFFF;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .tcp-b2b-hero__inner {
      grid-template-columns: 1fr;
    }
    .tcp-b2b-sectors__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .tcp-b2b-glazes__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .tcp-b2b-process__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .tcp-rfq-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .tcp-b2b-hero {
      padding: 60px 20px;
    }
    .tcp-b2b-sectors,
    .tcp-b2b-glazes__inner,
    .tcp-b2b-process,
    .tcp-b2b-rfq__inner {
      padding-left: 20px;
      padding-right: 20px;
    }
    .tcp-b2b-sectors__grid,
    .tcp-b2b-process__grid {
      grid-template-columns: 1fr;
    }
    .tcp-b2b-rfq__form {
      padding: 24px;
    }
  }
</style>

<div class="tcp-b2b-page" id="tcp-b2b-page-root">
  <!-- Hero Section -->
  <section class="tcp-b2b-hero">
    <div class="tcp-b2b-hero__inner">
      <div>
        <div class="tcp-b2b-hero__pill">
          <span>Architectural &bull; Hospitality Studio</span>
        </div>
        <h1 class="tcp-b2b-hero__title">Bespoke Tableware for Exceptional Hospitality</h1>
        <p class="tcp-b2b-hero__desc">
          Crafted to withstand the intense pace of Michelin-star dining, luxury boutique resorts, and curated interior spaces. Vitrified at 1280°C with custom profile compounding and personalized branding.
        </p>
        <div class="tcp-b2b-hero__ctas">
          <a href="#rfq" class="tcp-b2b-hero__btn-gold">Request Trade Consultation &rarr;</a>
          <a href="#glazes" class="tcp-b2b-hero__btn-outline">Explore Glaze Archive</a>
        </div>
      </div>
    </div>
  </section>

  <!-- B2B Sectors -->
  <section class="tcp-b2b-sectors" id="hospitality">
    <div class="tcp-b2b-section-header">
      <span class="tcp-b2b-section-label">PARTNERSHIP DISCIPLINES</span>
      <h2 class="tcp-b2b-section-title">Engineered Across Four Creative Sectors</h2>
    </div>

    <div class="tcp-b2b-sectors__grid">
      <div class="tcp-b2b-sector-card">
        <svg class="tcp-b2b-sector-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <h3 class="tcp-b2b-sector-card__title">Fine Dining &amp; Chefs</h3>
        <p class="tcp-b2b-sector-card__desc">
          Custom plate wells, temperature-retention stoneware, matte glazes that do not mark with cutlery, and chef-bespoke plating rims.
        </p>
      </div>

      <div class="tcp-b2b-sector-card">
        <svg class="tcp-b2b-sector-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18M3 7v14M21 7v14M6 11h12M6 15h12M9 3h6v4H9z"/></svg>
        <h3 class="tcp-b2b-sector-card__title">Resorts &amp; Boutique Stays</h3>
        <p class="tcp-b2b-sector-card__desc">
          Turnkey restaurant services, in-room tea rituals, bath amenities, spa vessels, and poolside stoneware resistant to thermal shock.
        </p>
      </div>

      <div class="tcp-b2b-sector-card">
        <svg class="tcp-b2b-sector-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        <h3 class="tcp-b2b-sector-card__title">Architects &amp; Designers</h3>
        <p class="tcp-b2b-sector-card__desc">
          Site-specific wall installations, organic ceramic lighting pendants, sculptural stoneware urns, and custom architectural tiles.
        </p>
      </div>

      <div class="tcp-b2b-sector-card">
        <svg class="tcp-b2b-sector-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M16 8V6a4 4 0 00-8 0v2"/></svg>
        <h3 class="tcp-b2b-sector-card__title">Corporate &amp; VIP Gifting</h3>
        <p class="tcp-b2b-sector-card__desc">
          Bespoke commemorative tableware with custom debossed seal logos, unbleached linen gift boxes, and social impact documentation.
        </p>
      </div>
    </div>
  </section>

  <!-- Glaze & Clay Library (Kevala style) -->
  <section class="tcp-b2b-glazes" id="glazes">
    <div class="tcp-b2b-glazes__inner">
      <div class="tcp-b2b-section-header">
        <span class="tcp-b2b-section-label">MATERIAL ARCHIVE</span>
        <h2 class="tcp-b2b-section-title">Signature Glaze &amp; Finish Compounding</h2>
      </div>

      <div class="tcp-b2b-glazes__grid">
        <div class="tcp-glaze-card">
          <div class="tcp-glaze-swatch" style="background: #FAF8F4; border: 3px solid #C29B38;"></div>
          <span class="tcp-glaze-name">Smriti Gold Rim</span>
          <span class="tcp-glaze-type">Crackle &bull; 24k Leaf</span>
        </div>

        <div class="tcp-glaze-card">
          <div class="tcp-glaze-swatch" style="background: #E8DEC8;"></div>
          <span class="tcp-glaze-name">Earthen Sand</span>
          <span class="tcp-glaze-type">Matte Stoneware</span>
        </div>

        <div class="tcp-glaze-card">
          <div class="tcp-glaze-swatch" style="background: #2B2724;"></div>
          <span class="tcp-glaze-name">Lava Charcoal</span>
          <span class="tcp-glaze-type">Textured Basalt</span>
        </div>

        <div class="tcp-glaze-card">
          <div class="tcp-glaze-swatch" style="background: #C4CDBE;"></div>
          <span class="tcp-glaze-name">Muted Sage</span>
          <span class="tcp-glaze-type">Satin Celadon</span>
        </div>

        <div class="tcp-glaze-card">
          <div class="tcp-glaze-swatch" style="background: #9E6747;"></div>
          <span class="tcp-glaze-name">Terracotta Clay</span>
          <span class="tcp-glaze-type">High-Fire Raw</span>
        </div>

        <div class="tcp-glaze-card">
          <div class="tcp-glaze-swatch" style="background: #DFBA5E;"></div>
          <span class="tcp-glaze-name">Kintsugi Gold</span>
          <span class="tcp-glaze-type">Artisan Brushed</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 6-Stage Process -->
  <section class="tcp-b2b-process" id="process">
    <div class="tcp-b2b-section-header">
      <span class="tcp-b2b-section-label">HOW WE WORK TOGETHER</span>
      <h2 class="tcp-b2b-section-title">The 6-Stage Bespoke Development Cycle</h2>
    </div>

    <div class="tcp-b2b-process__grid">
      <div class="tcp-process-step">
        <span class="tcp-process-step__num">01</span>
        <h3 class="tcp-process-step__title">Consultation &amp; Brief</h3>
        <p class="tcp-process-step__desc">We review your menu courses, interior finishes, dishwasher capacity, and operational stacking requirements.</p>
      </div>

      <div class="tcp-process-step">
        <span class="tcp-process-step__num">02</span>
        <h3 class="tcp-process-step__title">Glaze &amp; Form Formulation</h3>
        <p class="tcp-process-step__desc">Our studio develops customized glaze swatches and profile drawings aligned with your dining identity.</p>
      </div>

      <div class="tcp-process-step">
        <span class="tcp-process-step__num">03</span>
        <h3 class="tcp-process-step__title">Hand-Made Prototyping</h3>
        <p class="tcp-process-step__desc">Physical clay prototypes are hand-thrown and delivered to your kitchen for plating ergonomics testing.</p>
      </div>

      <div class="tcp-process-step">
        <span class="tcp-process-step__num">04</span>
        <h3 class="tcp-process-step__title">Chef Plating Trial</h3>
        <p class="tcp-process-step__desc">Your culinary team tests sauce behavior, cutlery acoustic feedback, and thermal hold under pass heat lamps.</p>
      </div>

      <div class="tcp-process-step">
        <span class="tcp-process-step__num">05</span>
        <h3 class="tcp-process-step__title">1280°C Artisan Production</h3>
        <p class="tcp-process-step__desc">Batch production in our Gurugram studio by trained women artisans, vitrified at 1280°C for lifetime durability.</p>
      </div>

      <div class="tcp-process-step">
        <span class="tcp-process-step__num">06</span>
        <h3 class="tcp-process-step__title">White-Glove Delivery &amp; Reorders</h3>
        <p class="tcp-process-step__desc">Export-grade reinforced wooden crating, guaranteed delivery, and perpetual small-batch re-order archives.</p>
      </div>
    </div>
  </section>

  <!-- Interactive RFQ Form -->
  <section class="tcp-b2b-rfq" id="rfq">
    <div class="tcp-b2b-rfq__inner">
      <div class="tcp-b2b-section-header" style="color:#FFF;">
        <span class="tcp-b2b-section-label">DIRECT TRADE PORTAL</span>
        <h2 class="tcp-b2b-section-title" style="color:#FFF;">Request Bespoke Quotation &amp; Samples</h2>
        <p style="font-size:14px; color:rgba(255,255,255,0.75);">
          Direct inquiry to studio founder Amankshii Rawatt. Response within 24 hours. Phone / WhatsApp: +91-8586946814 &bull; info@thecreativeplatter.com
        </p>
      </div>

      <form class="tcp-b2b-rfq__form" action="/contact#contact_form" method="post">
        <input type="hidden" name="form_type" value="contact">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="b2b_hospitality_inquiry">

        <div class="tcp-rfq-grid">
          <div class="tcp-rfq-field">
            <label>Your Name *</label>
            <input type="text" name="contact[name]" placeholder="Chef / Designer / Owner" required>
          </div>
          <div class="tcp-rfq-field">
            <label>Business / Establishment Name *</label>
            <input type="text" name="contact[company]" placeholder="e.g. The Oberoi / Atelier Studio" required>
          </div>
        </div>

        <div class="tcp-rfq-grid">
          <div class="tcp-rfq-field">
            <label>Email Address *</label>
            <input type="email" name="contact[email]" placeholder="email@establishment.com" required>
          </div>
          <div class="tcp-rfq-field">
            <label>Phone / WhatsApp Number *</label>
            <input type="tel" name="contact[phone]" placeholder="+91 ..." required>
          </div>
        </div>

        <div class="tcp-rfq-grid">
          <div class="tcp-rfq-field">
            <label>Industry Sector</label>
            <select name="contact[sector]">
              <option>Fine Dining &bull; Michelin / Standalone</option>
              <option>Luxury Hotel / Boutique Resort</option>
              <option>Architectural &bull; Interior Commission</option>
              <option>Corporate &bull; VIP Gifting</option>
            </select>
          </div>
          <div class="tcp-rfq-field">
            <label>Estimated Quantity</label>
            <select name="contact[quantity]">
              <option>50 – 200 Pieces (Boutique / Tasting Menu)</option>
              <option>200 – 500 Pieces (Full Restaurant Opening)</option>
              <option>500 – 2,000+ Pieces (Hotel / Banquet Scale)</option>
              <option>Sample Box Only (5 Pieces)</option>
            </select>
          </div>
        </div>

        <div class="tcp-rfq-field" style="margin-bottom: 24px;">
          <label>Project Vision &amp; Requirements</label>
          <textarea name="contact[body]" rows="4" placeholder="Describe your plate requirements, glaze preferences, launch timeline, or request a studio visit in Gurugram..."></textarea>
        </div>

        <button type="submit" class="tcp-rfq-submit-btn">Submit Trade Inquiry &rarr;</button>
      </form>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "TCP Bespoke B2B Portal",
  "tag": "section",
  "class": "tcp-bespoke-b2b-section",
  "settings": [],
  "presets": [
    {
      "name": "TCP Bespoke B2B Portal"
    }
  ]
}
{% endschema %}
