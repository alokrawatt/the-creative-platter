{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Global Footer Section
  ============================================================
  Multi-column editorial footer with Pushpa Legacy tribute,
  dual D2C / B2B portals, Gurugram studio contact, and newsletter.
  Copy into Shopify: sections/section-footer.liquid
{% endcomment %}

<style>
  .tcp-footer {
    background-color: var(--tcp-brown, #352922);
    color: var(--tcp-sand, #FBF9F5);
    padding: 80px 0 0;
    font-family: var(--font-sans, sans-serif);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .tcp-footer__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .tcp-footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr 1.4fr;
    gap: 48px;
    padding-bottom: 64px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* ── Brand Col ── */
  .tcp-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .tcp-footer__logo {
    text-decoration: none;
    color: #FFFFFF;
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 16px;
  }

  .tcp-footer__logo-the {
    font-family: var(--font-script, cursive);
    font-size: 22px;
    color: var(--tcp-gold-light, #DFBA5E);
    line-height: 1;
  }

  .tcp-footer__logo-name {
    font-family: var(--font-serif, serif);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 3.5px;
    text-transform: uppercase;
    line-height: 1;
  }

  .tcp-footer__tagline {
    font-size: 11px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: rgba(251, 249, 245, 0.7);
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .tcp-footer__contact-info {
    font-size: 13px;
    color: rgba(251, 249, 245, 0.8);
    line-height: 1.8;
    margin-bottom: 24px;
  }

  .tcp-footer__contact-info a {
    color: var(--tcp-gold-light, #DFBA5E);
    text-decoration: none;
  }

  .tcp-footer__social {
    display: flex;
    gap: 12px;
  }

  .tcp-footer__social-link {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .tcp-footer__social-link:hover {
    background: var(--tcp-gold, #C29B38);
    border-color: var(--tcp-gold, #C29B38);
    color: var(--tcp-dark, #1F1D1B);
    transform: translateY(-2px);
  }

  .tcp-footer__social-link svg {
    width: 15px;
    height: 15px;
  }

  /* ── Nav Cols ── */
  .tcp-footer__nav-col {}

  .tcp-footer__nav-title {
    font-family: var(--font-sans, sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--tcp-gold-light, #DFBA5E);
    margin: 0 0 20px;
  }

  .tcp-footer__nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tcp-footer__nav-list a {
    font-size: 13px;
    color: rgba(251, 249, 245, 0.75);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .tcp-footer__nav-list a:hover {
    color: #FFFFFF;
    transform: translateX(3px);
  }

  /* ── Newsletter Column ── */
  .tcp-footer__news-col {}

  .tcp-footer__news-desc {
    font-size: 13px;
    color: rgba(251, 249, 245, 0.75);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .tcp-footer__form {
    display: flex;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 2px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.2);
    transition: border-color 0.3s ease;
  }

  .tcp-footer__form:focus-within {
    border-color: var(--tcp-gold, #C29B38);
  }

  .tcp-footer__input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 13px 16px;
    color: #FFFFFF;
    font-family: var(--font-sans, sans-serif);
    font-size: 13px;
    outline: none;
  }

  .tcp-footer__input::placeholder {
    color: rgba(251, 249, 245, 0.4);
  }

  .tcp-footer__submit {
    background: var(--tcp-gold, #C29B38);
    border: none;
    color: var(--tcp-dark, #1F1D1B);
    padding: 0 18px;
    cursor: pointer;
    font-weight: 700;
    transition: background 0.2s ease;
  }

  .tcp-footer__submit:hover {
    background: #FFFFFF;
  }

  /* ── Bottom Bar ── */
  .tcp-footer__bottom {
    padding: 24px 0;
  }

  .tcp-footer__bottom-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11.5px;
    color: rgba(251, 249, 245, 0.5);
    flex-wrap: wrap;
    gap: 16px;
  }

  .tcp-footer__legal-links {
    display: flex;
    gap: 20px;
  }

  .tcp-footer__legal-links a {
    color: rgba(251, 249, 245, 0.5);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .tcp-footer__legal-links a:hover {
    color: #FFFFFF;
  }

  .tcp-footer__back-to-top {
    background: none;
    border: none;
    color: var(--tcp-gold-light, #DFBA5E);
    cursor: pointer;
    font-family: var(--font-sans, sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .tcp-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    .tcp-footer__brand,
    .tcp-footer__news-col {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .tcp-footer {
      padding: 50px 0 0;
    }
    .tcp-footer__inner,
    .tcp-footer__bottom-inner {
      padding: 0 20px;
    }
    .tcp-footer__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

<footer class="tcp-footer" id="tcp-footer">
  <div class="tcp-footer__inner">
    <div class="tcp-footer__grid">

      <!-- Col 1: Brand & Contact -->
      <div class="tcp-footer__brand">
        <a href="/" class="tcp-footer__logo">
          <span class="tcp-footer__logo-the">the</span>
          <span class="tcp-footer__logo-name">CREATIVE PLATTER</span>
        </a>
        <span class="tcp-footer__tagline">
          Pushpa Legacy Dinnerware &bull; Bespoke Hospitality &bull; Experiences
        </span>
        <div class="tcp-footer__contact-info">
          Gurugram Studio, Haryana / New Delhi<br>
          Direct: <a href="tel:+918586946814">+91-8586946814</a><br>
          Email: <a href="mailto:info@thecreativeplatter.com">info@thecreativeplatter.com</a>
        </div>
        <div class="tcp-footer__social">
          <a href="https://instagram.com/thecreativeplatter_studio" target="_blank" rel="noopener" class="tcp-footer__social-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="18" cy="6" r="1" fill="currentColor"/></svg>
          </a>
          <a href="mailto:info@thecreativeplatter.com" class="tcp-footer__social-link" aria-label="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Pushpa & Retail (D2C) -->
      <div class="tcp-footer__nav-col">
        <h4 class="tcp-footer__nav-title">Retail &amp; D2C</h4>
        <ul class="tcp-footer__nav-list">
          <li><a href="/collections/pushpa">Pushpa Collection 2025–26</a></li>
          <li><a href="/products/smriti-dinner-set">Smriti (स्मृति) Set</a></li>
          <li><a href="/collections/plates">Plates &amp; Bowls</a></li>
          <li><a href="/collections/platters">Serving Platters</a></li>
          <li><a href="/collections/linen">Table Linens</a></li>
          <li><a href="/pages/build-your-table">Build Your Table</a></li>
        </ul>
      </div>

      <!-- Col 3: Hospitality & B2B -->
      <div class="tcp-footer__nav-col">
        <h4 class="tcp-footer__nav-title">Hospitality &amp; B2B</h4>
        <ul class="tcp-footer__nav-list">
          <li><a href="/pages/bespoke-b2b">Commercial Tableware</a></li>
          <li><a href="/pages/bespoke-b2b#hospitality">Fine Dining &amp; Chefs</a></li>
          <li><a href="/pages/bespoke-b2b#hotels">Resorts &amp; Boutique Stays</a></li>
          <li><a href="/pages/bespoke-b2b#glazes">Glaze &amp; Clay Library</a></li>
          <li><a href="/pages/bespoke-b2b#process">6-Stage Process</a></li>
          <li><a href="/pages/bespoke-b2b#rfq">Request Trade Samples</a></li>
        </ul>
      </div>

      <!-- Col 4: The Studio & Craft -->
      <div class="tcp-footer__nav-col">
        <h4 class="tcp-footer__nav-title">The Studio</h4>
        <ul class="tcp-footer__nav-list">
          <li><a href="/pages/story">Tribute to Pushpa</a></li>
          <li><a href="/pages/story#impact">Women Artisan Studio</a></li>
          <li><a href="/pages/craft-material">Zero Waste Philosophy</a></li>
          <li><a href="/pages/experiences">Studio Experiences</a></li>
          <li><a href="/pages/contact">Visit The Studio</a></li>
        </ul>
      </div>

      <!-- Col 5: Newsletter -->
      <div class="tcp-footer__news-col">
        <h4 class="tcp-footer__nav-title">Join The Ritual</h4>
        <p class="tcp-footer__news-desc">
          Receive exclusive invitations to new Pushpa collection releases, studio feasting dinners, and pottery masterclasses.
        </p>
        <form class="tcp-footer__form" action="/contact#contact_form" method="post">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" class="tcp-footer__input" placeholder="Your email address..." required>
          <button type="submit" class="tcp-footer__submit">&rarr;</button>
        </form>
      </div>

    </div>
  </div>

  <!-- Bottom Legal Bar -->
  <div class="tcp-footer__bottom">
    <div class="tcp-footer__bottom-inner">
      <span>&copy; {{ 'now' | date: "%Y" }} The Creative Platter. All rights reserved.</span>
      <div class="tcp-footer__legal-links">
        <a href="/policies/privacy-policy">Privacy Policy</a>
        <a href="/policies/terms-of-service">Terms of Service</a>
        <a href="/pages/bespoke-b2b#rfq">Trade Inquiries</a>
      </div>
      <button type="button" class="tcp-footer__back-to-top" onclick="window.scrollTo({top:0, behavior:'smooth'})">
        Back to top &uarr;
      </button>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "TCP Global Footer",
  "tag": "section",
  "class": "tcp-footer-section",
  "settings": []
}
{% endschema %}
