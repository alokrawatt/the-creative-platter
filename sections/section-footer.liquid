{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Global Footer Section (Solid Pure White)
  ============================================================
  - Solid Pure White (#FFFFFF) luxury background with soft borderlines
  - Image Logo Support via Shopify Theme Editor (with graceful text fallback)
  - Editorial columns: Brand info, Retail & D2C, Hospitality & B2B, Studio, Newsletter
  - Social handles, studio contact, and copyright
  Copy into Shopify: sections/section-footer.liquid
{% endcomment %}

<style>
  .tcp-footer {
    background-color: #FFFFFF !important;
    color: #3E3A36;
    padding: 72px 0 0;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    border-top: 1px solid #ECE7DF;
  }

  .tcp-footer__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 48px;
  }

  .tcp-footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr 1.4fr;
    gap: 48px;
    padding-bottom: 56px;
    border-bottom: 1px solid #ECE7DF;
  }

  /* ── Brand Column ── */
  .tcp-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .tcp-footer__logo-wrap {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    margin-bottom: 18px;
  }

  .tcp-footer__logo-img {
    display: block;
    height: auto;
    object-fit: contain;
    object-position: left center;
  }

  .tcp-footer__logo-the {
    font-family: 'Sacramento', cursive;
    font-size: 24px;
    line-height: 0.8;
    color: #3E3A36;
    letter-spacing: 0.5px;
  }

  .tcp-footer__logo-name {
    font-family: 'Raleway', sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    line-height: 1.1;
    color: #3E3A36;
  }

  .tcp-footer__tagline {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: #7A746B;
    line-height: 1.5;
    margin-bottom: 20px;
  }

  .tcp-footer__contact-info {
    font-size: 13px;
    color: #5C5750;
    line-height: 1.8;
    margin-bottom: 24px;
  }

  .tcp-footer__contact-info a {
    color: #A6732E;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .tcp-footer__contact-info a:hover {
    color: #8C5F22;
    text-decoration: underline;
  }

  .tcp-footer__social {
    display: flex;
    gap: 10px;
  }

  .tcp-footer__social-link {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #FAF8F4;
    border: 1px solid #E8E2D8;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #3E3A36;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .tcp-footer__social-link:hover {
    background: #A6732E;
    border-color: #A6732E;
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  .tcp-footer__social-link svg {
    width: 15px;
    height: 15px;
  }

  /* ── Navigation Columns ── */
  .tcp-footer__nav-col {}

  .tcp-footer__nav-title {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #3E3A36;
    margin: 0 0 18px;
  }

  .tcp-footer__nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .tcp-footer__nav-list a {
    font-size: 13px;
    color: #6B665F;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .tcp-footer__nav-list a:hover {
    color: #A6732E;
    transform: translateX(3px);
  }

  /* ── Newsletter Column ── */
  .tcp-footer__news-col {}

  .tcp-footer__news-desc {
    font-size: 13px;
    color: #6B665F;
    line-height: 1.65;
    margin-bottom: 16px;
  }

  .tcp-footer__form {
    display: flex;
    border: 1px solid #D8D2C7;
    border-radius: 2px;
    overflow: hidden;
    background: #FAF8F5;
    transition: border-color 0.25s ease;
  }

  .tcp-footer__form:focus-within {
    border-color: #A6732E;
  }

  .tcp-footer__input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 12px 14px;
    color: #3E3A36;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 12.5px;
    outline: none;
  }

  .tcp-footer__input::placeholder {
    color: #9C968D;
  }

  .tcp-footer__submit {
    background: #A6732E;
    border: none;
    color: #FFFFFF;
    padding: 0 16px;
    cursor: pointer;
    font-size: 15px;
    font-weight: 700;
    transition: background 0.2s ease;
  }

  .tcp-footer__submit:hover {
    background: #8C5F22;
  }

  /* ── Bottom Legal Bar ── */
  .tcp-footer__bottom {
    padding: 24px 0 28px;
    background-color: #FFFFFF;
  }

  .tcp-footer__bottom-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11.5px;
    color: #8E8981;
    flex-wrap: wrap;
    gap: 16px;
  }

  .tcp-footer__legal-links {
    display: flex;
    gap: 20px;
  }

  .tcp-footer__legal-links a {
    color: #8E8981;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .tcp-footer__legal-links a:hover {
    color: #3E3A36;
  }

  .tcp-footer__back-to-top {
    background: none;
    border: none;
    color: #A6732E;
    cursor: pointer;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s ease;
  }

  .tcp-footer__back-to-top:hover {
    color: #8C5F22;
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .tcp-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
    .tcp-footer__brand,
    .tcp-footer__news-col {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .tcp-footer {
      padding: 48px 0 0;
    }
    .tcp-footer__inner,
    .tcp-footer__bottom-inner {
      padding: 0 20px;
    }
    .tcp-footer__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>

<footer class="tcp-footer" id="tcp-footer">
  <div class="tcp-footer__inner">
    <div class="tcp-footer__grid">

      {% assign footer_logo = section.settings.logo | default: settings.logo %}

      <!-- Col 1: Brand Logo, Contact & Social -->
      <div class="tcp-footer__brand">
        <a href="/" class="tcp-footer__logo-wrap" aria-label="The Creative Platter Studio">
          {% if footer_logo != blank %}
            <img
              src="{{ footer_logo | image_url: width: 600 }}"
              alt="{{ footer_logo.alt | default: shop.name | escape }}"
              class="tcp-footer__logo-img"
              width="{{ footer_logo.width }}"
              height="{{ footer_logo.height }}"
              loading="lazy"
              style="max-height: {{ section.settings.logo_max_height | default: 56 }}px; max-width: {{ section.settings.logo_width | default: 180 }}px; width: auto; height: auto;"
            >
          {% else %}
            <span class="tcp-footer__logo-the">the</span>
            <span class="tcp-footer__logo-name">CREATIVE PLATTER</span>
          {% endif %}
        </a>

        <span class="tcp-footer__tagline">
          {{ section.settings.tagline | default: 'Pushpa Legacy Dinnerware • Bespoke Hospitality • Experiences' }}
        </span>

        <div class="tcp-footer__contact-info">
          {{ section.settings.address | default: 'Gurugram Studio, Haryana / New Delhi' }}<br>
          Direct: <a href="tel:{{ section.settings.phone | default: '+918586946814' }}">{{ section.settings.phone | default: '+91-8586946814' }}</a><br>
          Email: <a href="mailto:{{ section.settings.email | default: 'info@thecreativeplatter.com' }}">{{ section.settings.email | default: 'info@thecreativeplatter.com' }}</a>
        </div>

        <div class="tcp-footer__social">
          {% if section.settings.instagram_url != blank or true %}
            <a href="{{ section.settings.instagram_url | default: 'https://instagram.com/thecreativeplatter_studio' }}" target="_blank" rel="noopener" class="tcp-footer__social-link" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="18" cy="6" r="1" fill="currentColor"/></svg>
            </a>
          {% endif %}
          <a href="mailto:{{ section.settings.email | default: 'info@thecreativeplatter.com' }}" class="tcp-footer__social-link" aria-label="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Pushpa & Retail (D2C) -->
      <div class="tcp-footer__nav-col">
        <h4 class="tcp-footer__nav-title">Retail &amp; D2C</h4>
        <ul class="tcp-footer__nav-list">
          <li><a href="/collections/pushpa">Pushpa Collection</a></li>
          <li><a href="/products/smriti-dinner-set">Smriti (स्मृति) Set</a></li>
          <li><a href="/collections/dinnerware">Dinnerware Sets</a></li>
          <li><a href="/collections/serveware">Serving Platters</a></li>
          <li><a href="/collections/linen">Table Linens</a></li>
          <li><a href="/collections/objects">Objects &amp; Vases</a></li>
        </ul>
      </div>

      <!-- Col 3: Hospitality & B2B -->
      <div class="tcp-footer__nav-col">
        <h4 class="tcp-footer__nav-title">Hospitality &amp; B2B</h4>
        <ul class="tcp-footer__nav-list">
          <li><a href="/pages/bespoke-b2b">Commercial Tableware</a></li>
          <li><a href="/pages/bespoke-b2b#hospitality">Fine Dining &amp; Chefs</a></li>
          <li><a href="/pages/bespoke-b2b#hotels">Resorts &amp; Boutique Stays</a></li>
          <li><a href="/pages/bespoke-b2b#glazes">Glaze &amp; Clay Library</a></li>
          <li><a href="/pages/bespoke-b2b#process">6-Stage Process</a></li>
          <li><a href="/pages/bespoke-b2b#rfq">Request Trade Samples</a></li>
        </ul>
      </div>

      <!-- Col 4: The Studio & Craft -->
      <div class="tcp-footer__nav-col">
        <h4 class="tcp-footer__nav-title">The Studio</h4>
        <ul class="tcp-footer__nav-list">
          <li><a href="/pages/story">Tribute to Pushpa</a></li>
          <li><a href="/pages/story#impact">Women Artisan Studio</a></li>
          <li><a href="/pages/craft-material">Zero Waste Philosophy</a></li>
          <li><a href="/pages/experiences">Studio Experiences</a></li>
          <li><a href="/pages/contact">Visit The Studio</a></li>
        </ul>
      </div>

      <!-- Col 5: Newsletter -->
      <div class="tcp-footer__news-col">
        <h4 class="tcp-footer__nav-title">Join The Ritual</h4>
        <p class="tcp-footer__news-desc">
          Receive exclusive invitations to new collection releases, feasting dinners, and pottery masterclasses.
        </p>
        <form class="tcp-footer__form" action="/contact#contact_form" method="post">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" class="tcp-footer__input" placeholder="Your email address..." required>
          <button type="submit" class="tcp-footer__submit">&rarr;</button>
        </form>
      </div>

    </div>
  </div>

  <!-- Bottom Legal Bar -->
  <div class="tcp-footer__bottom">
    <div class="tcp-footer__bottom-inner">
      <span>&copy; {{ 'now' | date: "%Y" }} The Creative Platter. All rights reserved.</span>
      <div class="tcp-footer__legal-links">
        <a href="/policies/privacy-policy">Privacy Policy</a>
        <a href="/policies/terms-of-service">Terms of Service</a>
        <a href="/pages/bespoke-b2b#rfq">Trade Inquiries</a>
      </div>
      <button type="button" class="tcp-footer__back-to-top" onclick="window.scrollTo({top:0, behavior:'smooth'})">
        Back to top &uarr;
      </button>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "TCP Global Footer",
  "tag": "section",
  "class": "tcp-footer-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo Image (Optional)"
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Logo Max Height",
      "default": 55
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 280,
      "step": 10,
      "unit": "px",
      "label": "Logo Max Width",
      "default": 180
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Brand Tagline",
      "default": "Pushpa Legacy Dinnerware • Bespoke Hospitality • Experiences"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Studio Address",
      "default": "Gurugram Studio, Haryana / New Delhi"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "+91-8586946814"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "info@thecreativeplatter.com"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    }
  ]
}
{% endschema %}
