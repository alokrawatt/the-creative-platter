{% comment %}
  ============================================================
  THE CREATIVE PLATTER — Product Detail Page (PDP)
  ============================================================
  Nicobar-inspired fluid product page:
  - Sticky purchase panel with set configuration selector
  - 24k Gold leaf highlight & artisan craft badge
  - 1280°C durability & care specifications
  - Fast B2B Hospitality Bulk inquiry toggle
  - "Complete the Setting" upsell recommendation
  Copy into Shopify: sections/section-product-detail.liquid
{% endcomment %}

<style>
  .tcp-pdp {
    background-color: var(--tcp-sand, #FBF9F5);
    color: var(--tcp-dark, #1F1D1B);
    padding: 60px 0 100px;
    font-family: var(--font-sans, sans-serif);
  }

  .tcp-pdp__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ── Breadcrumb ── */
  .tcp-pdp__breadcrumb {
    font-size: 11.5px;
    color: var(--tcp-muted, #68625B);
    margin-bottom: 32px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tcp-pdp__breadcrumb a {
    color: var(--tcp-muted, #68625B);
    text-decoration: none;
  }

  .tcp-pdp__breadcrumb a:hover {
    color: var(--tcp-gold, #C29B38);
  }

  /* ── Main Layout ── */
  .tcp-pdp__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 64px;
    align-items: start;
  }

  /* ── Left: Image Gallery ── */
  .tcp-pdp__gallery {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .tcp-pdp__main-img-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 6px;
    overflow: hidden;
    background: var(--tcp-stone, #F3EFEA);
    border: 1px solid var(--tcp-border, #E8E2D8);
  }

  .tcp-pdp__main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-fluid);
  }

  .tcp-pdp__main-img-wrap:hover .tcp-pdp__main-img {
    transform: scale(1.05);
  }

  .tcp-pdp__gold-tag {
    position: absolute;
    top: 20px;
    left: 20px;
    background: rgba(31, 29, 27, 0.9);
    backdrop-filter: blur(8px);
    color: var(--tcp-gold-light, #DFBA5E);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .tcp-pdp__thumbnails {
    display: flex;
    gap: 16px;
  }

  .tcp-pdp__thumb {
    width: 90px;
    height: 90px;
    border-radius: 4px;
    overflow: hidden;
    border: 1.5px solid var(--tcp-border, #E8E2D8);
    cursor: pointer;
    background: var(--tcp-stone, #F3EFEA);
    transition: border-color 0.2s ease;
  }

  .tcp-pdp__thumb.is-active,
  .tcp-pdp__thumb:hover {
    border-color: var(--tcp-gold, #C29B38);
  }

  .tcp-pdp__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Right: Sticky Purchase Column ── */
  .tcp-pdp__info {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
  }

  .tcp-pdp__collection-pill {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--tcp-gold, #C29B38);
    margin-bottom: 8px;
  }

  .tcp-pdp__title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 4px;
  }

  .tcp-pdp__title {
    font-family: var(--font-serif, serif);
    font-size: clamp(34px, 4vw, 44px);
    font-weight: 600;
    color: var(--tcp-dark, #1F1D1B);
    line-height: 1.1;
    margin: 0;
  }

  .tcp-pdp__hindi {
    font-family: var(--font-devanagari, serif);
    font-size: 22px;
    color: var(--tcp-gold, #C29B38);
  }

  .tcp-pdp__tagline {
    font-family: var(--font-serif, serif);
    font-size: 16px;
    font-style: italic;
    color: var(--tcp-muted, #68625B);
    margin-bottom: 20px;
  }

  .tcp-pdp__price-wrap {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--tcp-border, #E8E2D8);
  }

  .tcp-pdp__price {
    font-family: var(--font-serif, serif);
    font-size: 28px;
    font-weight: 600;
    color: var(--tcp-dark, #1F1D1B);
  }

  .tcp-pdp__tax-note {
    font-size: 11.5px;
    color: var(--tcp-muted, #68625B);
  }

  /* ── Set Configurations ── */
  .tcp-pdp__options-group {
    margin-bottom: 28px;
  }

  .tcp-pdp__options-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--tcp-brown, #352922);
    margin-bottom: 12px;
    display: block;
  }

  .tcp-pdp__pill-options {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .tcp-pdp__config-pill {
    padding: 10px 18px;
    border: 1.5px solid var(--tcp-border-dark, #C9BFB0);
    border-radius: 4px;
    background: #FFF;
    cursor: pointer;
    font-size: 12px;
    font-weight: 600;
    color: var(--tcp-dark, #1F1D1B);
    transition: all 0.2s ease;
  }

  .tcp-pdp__config-pill.is-active,
  .tcp-pdp__config-pill:hover {
    border-color: var(--tcp-gold, #C29B38);
    background: var(--tcp-warm-card, #FAF7F2);
    color: var(--tcp-dark, #1F1D1B);
  }

  /* ── Action Buttons ── */
  .tcp-pdp__actions {
    display: flex;
    gap: 16px;
    margin-bottom: 32px;
  }

  .tcp-pdp__add-to-cart {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: var(--font-sans, sans-serif);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #FFFFFF;
    background: var(--tcp-dark, #1F1D1B);
    padding: 16px;
    border: none;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.3s var(--ease-fluid);
  }

  .tcp-pdp__add-to-cart:hover {
    background: var(--tcp-gold, #C29B38);
  }

  .tcp-pdp__trade-inquire {
    padding: 16px 24px;
    border: 1.5px solid var(--tcp-dark, #1F1D1B);
    background: transparent;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--tcp-dark, #1F1D1B);
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .tcp-pdp__trade-inquire:hover {
    background: var(--tcp-stone, #F3EFEA);
  }

  /* ── Accordion Tabs (Specs & Care) ── */
  .tcp-pdp__accordion {
    border-top: 1px solid var(--tcp-border, #E8E2D8);
  }

  .tcp-pdp__acc-item {
    border-bottom: 1px solid var(--tcp-border, #E8E2D8);
    padding: 18px 0;
  }

  .tcp-pdp__acc-header {
    font-family: var(--font-serif, serif);
    font-size: 18px;
    font-weight: 600;
    color: var(--tcp-dark, #1F1D1B);
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
  }

  .tcp-pdp__acc-body {
    font-size: 13.5px;
    color: var(--tcp-muted, #68625B);
    line-height: 1.7;
    margin-top: 12px;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .tcp-pdp__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .tcp-pdp__info {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .tcp-pdp {
      padding: 30px 0 60px;
    }
    .tcp-pdp__inner {
      padding: 0 20px;
    }
    .tcp-pdp__actions {
      flex-direction: column;
    }
  }
</style>

<div class="tcp-pdp" id="tcp-pdp-root">
  <div class="tcp-pdp__inner">
    <!-- Breadcrumb -->
    <div class="tcp-pdp__breadcrumb">
      <a href="/">Home</a> / 
      <a href="/collections/pushpa">Pushpa Legacy</a> / 
      <span>Smriti Dinner Set</span>
    </div>

    <div class="tcp-pdp__grid">
      <!-- Left: Media Gallery -->
      <div class="tcp-pdp__gallery">
        <div class="tcp-pdp__main-img-wrap">
          <span class="tcp-pdp__gold-tag">&bull; 24k Gold Leaf Contour</span>
          {% if product.featured_image != blank %}
            <img class="tcp-pdp__main-img" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title }}">
          {% else %}
            <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background: radial-gradient(circle, #FAF8F4 0%, #EDE5D8 100%);">
              <svg width="180" height="180" viewBox="0 0 180 180" fill="none"><circle cx="90" cy="90" r="70" stroke="#C29B38" stroke-width="3" stroke-dasharray="24 6 12 4"/><circle cx="90" cy="90" r="48" stroke="#1F1D1B" stroke-width="1.2"/><circle cx="90" cy="90" r="26" fill="#EDE4D6" stroke="#DFBA5E" stroke-width="2"/></svg>
            </div>
          {% endif %}
        </div>

        <div class="tcp-pdp__thumbnails">
          <div class="tcp-pdp__thumb is-active">
            <div style="width:100%; height:100%; background:#FAF8F4; display:flex; align-items:center; justify-content:center; font-size:10px; font-weight:700;">Angle 1</div>
          </div>
          <div class="tcp-pdp__thumb">
            <div style="width:100%; height:100%; background:#EDE5D8; display:flex; align-items:center; justify-content:center; font-size:10px; font-weight:700;">Rim Macro</div>
          </div>
          <div class="tcp-pdp__thumb">
            <div style="width:100%; height:100%; background:#FAF8F4; display:flex; align-items:center; justify-content:center; font-size:10px; font-weight:700;">Tablescape</div>
          </div>
        </div>
      </div>

      <!-- Right: Sticky Purchase Column -->
      <div class="tcp-pdp__info">
        <span class="tcp-pdp__collection-pill">THE LEGACY DINNER COLLECTION 2025–26</span>
        <div class="tcp-pdp__title-row">
          <h1 class="tcp-pdp__title">Smriti Dinner Set</h1>
          <span class="tcp-pdp__hindi">(स्मृति)</span>
        </div>
        <p class="tcp-pdp__tagline">&ldquo;Memory &amp; Remembrance&rdquo;</p>

        <div class="tcp-pdp__price-wrap">
          <span class="tcp-pdp__price">Rs. 18,500</span>
          <span class="tcp-pdp__tax-note">Includes taxes &bull; Free domestic shipping</span>
        </div>

        <!-- Set Configuration Pills -->
        <div class="tcp-pdp__options-group">
          <span class="tcp-pdp__options-label">Select Dinner Set Size:</span>
          <div class="tcp-pdp__pill-options">
            <button type="button" class="tcp-pdp__config-pill is-active">4-Piece Intimate Ritual</button>
            <button type="button" class="tcp-pdp__config-pill">12-Piece Family Dining Set</button>
            <button type="button" class="tcp-pdp__config-pill">18-Piece Feasting &amp; Banquet Set</button>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="tcp-pdp__actions">
          <button type="button" class="tcp-pdp__add-to-cart">Add To Shopping Bag &rarr;</button>
          <a href="/pages/bespoke-b2b#rfq" class="tcp-pdp__trade-inquire">Hospitality Bulk RFQ</a>
        </div>

        <!-- Details & Care Accordion -->
        <div class="tcp-pdp__accordion">
          <div class="tcp-pdp__acc-item">
            <div class="tcp-pdp__acc-header">
              <span>Craft &amp; Material Story</span>
              <span>+</span>
            </div>
            <div class="tcp-pdp__acc-body">
              Hand-moulded from recycled clay with zero material off-cuts. Finished with subtle 24k gold leaf brushwork on the raw rim. Handcrafted by local women artisans near Gurugram.
            </div>
          </div>

          <div class="tcp-pdp__acc-item">
            <div class="tcp-pdp__acc-header">
              <span>Set Inclusions &amp; Dimensions</span>
              <span>+</span>
            </div>
            <div class="tcp-pdp__acc-body">
              &bull; Charger Plate: 11.5" Diameter<br>
              &bull; Dinner Plate: 10" Diameter<br>
              &bull; Side / Quarter Plate: 7.5" Diameter<br>
              &bull; Katori / Tasting Bowl: 4.5" Diameter (220ml)
            </div>
          </div>

          <div class="tcp-pdp__acc-item">
            <div class="tcp-pdp__acc-header">
              <span>Durability &amp; Daily Care</span>
              <span>+</span>
            </div>
            <div class="tcp-pdp__acc-body">
              High-fired at 1280°C. 100% non-toxic and food-safe. Dishwasher and microwave safe. Hand wash recommended to preserve the 24k gold luster over decades of everyday ritual.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

